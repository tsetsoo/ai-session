def parse_session_args(args, usage, allowed, with_values=()):
    flags, values, rest = set(), {}, []
    while args:
        a = args.pop(0)
        if a in with_values and args:
            values[a] = args.pop(0)
        elif a in allowed:
            flags.add(a)
        elif a.startswith("--"):
            die(usage, 64)
        else:
            rest.append(a)
    if len(rest) != 2 or rest[0] not in ("claude", "codex") or not ID_RE.match(rest[1]):
        die(usage, 64)
    return rest[0], rest[1], flags, values


def cmd_run(args):
    usage = "usage: ai-todo-memory run <claude|codex> <session_id> [--dry-run] [--no-post] [--no-digest] [--force]"
    tool, sid, flags, _ = parse_session_args(args, usage, ("--dry-run", "--no-post", "--no-digest", "--force"))
    conf = Config()
    ctx = Context(conf, flags, conf.number("AI_TODO_MEMORY_MAX_CHUNKS_NIGHT"))
    lock = None if ctx.dry else take_lock(blocking=True)
    try:
        outcome = process_session(ctx, tool, sid, "run")
        if outcome == "missing":
            die("no %s conversation %s on this computer" % (tool, sid), 66)
        if ctx.dry or ctx.no_post:
            print(json.dumps({"tool": tool, "session_id": sid, "memories": ctx.printed}, indent=1, ensure_ascii=False))
        else:
            print("%s %s: %s" % (tool, sid, outcome))
        if ctx.touched_projects and not ctx.no_digest and not ctx.dry:
            refresh_digests(ctx, ctx.touched_projects)
    finally:
        if lock is not None:
            os.close(lock)
    sys.exit(1 if ctx.errors else 0)


def cmd_trigger(args):
    usage = "usage: ai-todo-memory trigger <claude|codex> <session_id> [--transcript PATH]"
    tool, sid, _, values = parse_session_args(args, usage, (), with_values=("--transcript",))
    conf = Config()
    if not conf.on("AI_TODO_MEMORY") and not conf.on("AI_TODO_STATS"):
        return
    state = load_json(session_state_path(tool, sid), {}) or {}
    debounce = conf.number("AI_TODO_MEMORY_DEBOUNCE_MIN", float) * 60
    if now() - float(state.get("last_run") or 0) < debounce:
        return
    lock = take_lock(blocking=False)
    if lock is None:
        Log.write("trigger_skipped_locked", tool=tool, session=sid)
        return
    try:
        state = load_json(session_state_path(tool, sid), {}) or {}
        if now() - float(state.get("last_run") or 0) < debounce:
            return
        ctx = Context(conf, set(), TRIGGER_CHUNKS)
        process_session(ctx, tool, sid, "trigger", hint=values.get("--transcript"))
        if ctx.touched_projects and not ctx.no_digest:
            refresh_digests(ctx, ctx.touched_projects)
    finally:
        os.close(lock)
    sys.exit(1 if ctx.errors else 0)


def nightly_candidates(ctx):
    """Project conversations with unread data, oldest activity first: [(mtime, tool, id, path)]."""
    newest = {}
    for path in glob.glob(os.path.join(CLAUDE_PROJECTS, "*", "*.jsonl")):
        key = ("claude", os.path.basename(path)[: -len(".jsonl")])
        if key not in newest or os.path.getmtime(path) > os.path.getmtime(newest[key]):
            newest[key] = path
    for path in glob.glob(os.path.join(CODEX_SESSIONS, "**", "rollout-*.jsonl"), recursive=True):
        meta = codex_meta(path)
        if meta and meta.get("id"):
            newest[("codex", meta["id"])] = path
    found = []
    for (tool, sid), path in newest.items():
        if not ID_RE.match(sid):
            continue
        try:
            st = os.stat(path)
        except OSError:
            continue
        state = load_json(session_state_path(tool, sid), {}) or {}
        if "offset" in state and state.get("inode") == st.st_ino and st.st_size <= int(state["offset"] or 0):
            continue
        cwd = transcript_cwd(tool, path)
        if not cwd or ctx.projects.match(os.path.normpath(cwd)) is None:
            continue
        found.append((st.st_mtime, tool, sid, path))
    found.sort()
    return found


def cmd_nightly(args):
    if args:
        die("usage: ai-todo-memory nightly", 64)
    conf = Config()
    ctx = Context(conf, set(), conf.number("AI_TODO_MEMORY_MAX_CHUNKS_NIGHT"))
    ctx.per_session_stats = False  # pushed for every changed conversation in step 1
    lock = take_lock(blocking=True)
    try:
        path = os.path.join(STATE_DIR, "nightly.json")
        nightly = load_json(path, {}) or {}
        started = now()
        if conf.on("AI_TODO_STATS"):
            last = nightly.get("last_stats_push")
            if last:
                since = max(1.0, (started - float(last)) / 86400 + 0.1)
            else:
                since = max(1.0, conf.number("AI_TODO_MEMORY_BACKFILL_DAYS", float))
            if push_stats(ctx, since=since):
                nightly["last_stats_push"] = started
        if conf.on("AI_TODO_MEMORY"):
            ctx.load_projects(force_refresh=True)
            for _, tool, sid, transcript in nightly_candidates(ctx):
                if ctx.chunks_left <= 0:
                    Log.write("nightly_chunk_cap", cap=conf.number("AI_TODO_MEMORY_MAX_CHUNKS_NIGHT"))
                    break
                process_session(ctx, tool, sid, "nightly", hint=transcript)
        if not ctx.no_digest:
            ctx.load_projects(force_refresh=not conf.on("AI_TODO_MEMORY"))
            refresh_digests(ctx, None)
        nightly["last_run"] = started
        nightly["last_errors"] = ctx.errors
        save_json(path, nightly)
        Log.write("nightly", errors=ctx.errors, chunks_left=ctx.chunks_left)
    finally:
        os.close(lock)
    sys.exit(1 if ctx.errors else 0)


def cmd_status(args):
    as_json = "--json" in args
    conf = Config()
    digests = load_json(os.path.join(STATE_DIR, "digests.json"), {}) or {}
    nightly = load_json(os.path.join(STATE_DIR, "nightly.json"), {}) or {}
    tracked = glob.glob(os.path.join(STATE_DIR, "sessions", "*.json"))
    written, skipped = [], []
    for pid, entry in sorted((digests.get("projects") or {}).items()):
        for target in entry.get("targets", []):
            written.append(dict(target, project_id=pid))
        for target in entry.get("skipped", []):
            skipped.append(dict(target, project_id=pid))
    status = {
        "config": conf.path,
        "state_dir": STATE_DIR,
        "computer_id": conf.get("TODO_COMPUTER_ID") or None,
        "memory": conf.on("AI_TODO_MEMORY"),
        "stats": conf.on("AI_TODO_STATS"),
        "digest": conf.on("AI_TODO_MEMORY_DIGEST"),
        "model": conf.get("AI_TODO_MEMORY_MODEL"),
        "sessions_tracked": len(tracked),
        "last_nightly": nightly.get("last_run"),
        "last_stats_push": nightly.get("last_stats_push"),
        "digests": written,
        "skipped": skipped,
    }
    if as_json:
        print(json.dumps(status, indent=1))
        return
    for key in ("config", "state_dir", "computer_id", "memory", "stats", "digest", "model", "sessions_tracked"):
        print("%-17s %s" % (key + ":", status[key]))
    for key in ("last_nightly", "last_stats_push"):
        print("%-17s %s" % (key + ":", iso(status[key]) if status[key] else "never"))
    for d in written:
        print("digest:           %s (%s%s)" % (d["path"], d.get("kind"), ", created by us" if d.get("created_by_us") else ""))
    for d in skipped:
        print("skipped:          %s (%s)" % (d["path"], d.get("reason")))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        die("usage: ai-todo-memory run|trigger|nightly|digest|status ... (see the header of this script)", 64)
    command, rest = argv[0], list(argv[1:])
    commands = {"run": cmd_run, "trigger": cmd_trigger, "nightly": cmd_nightly, "digest": cmd_digest,
                "status": cmd_status}
    if command not in commands:
        die("unknown command: %s" % command, 64)
    try:
        commands[command](rest)
    except Refused as e:
        Log.write("refused", command=command, reason=e)
        die("ai-todo-memory: %s" % e, 65)


main(sys.argv[1:])
