#!/bin/sh
# Claude Code hook: report a todo conversation's status to todo-server.
# Installed into ~/.claude/settings.json by install.sh:
#   UserPromptSubmit -> busy, Notification -> waiting, Stop -> idle,
#   PostToolUse -> tool (busy again after an answered permission prompt)
#
# Usage (Claude passes the hook JSON on stdin):
#   ai-todo-hook <busy|waiting|idle|tool>
#
# - The idle notification ("Claude is waiting for your input", notification_type
#   idle_prompt) is reported as idle, not waiting.
# - `tool` posts busy only when the last status this hook sent for the session
#   was not busy, so a long turn doesn't post once per tool call. The last sent
#   status is kept in ~/.ai-remote/hook-state/<session_id>.
#
# - Every post carries "attended": a tmux client attached to the session had keyboard
#   activity in the last 60s, so the todo server sends no push (you're there).
# - waiting is re-checked ~12s later: a keystroke since the prompt (you answered it) re-posts
#   waiting with "attended": true, which cancels the server's held push. busy only arrives
#   after the approved tool finishes, which can take minutes.
#
# Never blocks or fails Claude: always exits 0, and the HTTP call runs in the
# background with a 3s limit. Only sessions running in a tmux session named
# ai/claude/todo-* are reported; todo-server answers 404 for unknown ids anyway.
#
# Config: ~/.ai-remote/todo-hub.conf (shell syntax)
#   TODO_HUB_URL='http://100.118.255.23:8080'
#   TODO_API_TOKEN='...'
#
# Test hooks (not for normal use):
#   AI_TODO_HUB_CONF      config file path
#   AI_TODO_TMUX_SESSION  tmux session name instead of asking tmux
#   AI_TODO_HOOK_SYNC     =1: wait for the HTTP call (and the re-check)
#   AI_TODO_TMUX_SOCKET   tmux -L socket to ask about clients
#   AI_TODO_CLIENT_ACTIVITY_FILE  file with client activity epochs instead of asking tmux
#   AI_TODO_RECHECK_DELAY seconds before the waiting re-check (default 12)
status=${1:-}
case "$status" in
  busy | waiting | idle | tool) ;;
  *) exit 0 ;;
esac

input=$(cat 2>/dev/null) || exit 0

export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

session=${AI_TODO_TMUX_SESSION:-}
if [ -z "$session" ] && [ -n "${TMUX:-}" ]; then
  session=$(tmux display-message -p '#S' 2>/dev/null) || exit 0
fi
case "$session" in
  ai/claude/todo-*) ;;
  *) exit 0 ;;
esac

conf=${AI_TODO_HUB_CONF:-$HOME/.ai-remote/todo-hub.conf}
[ -r "$conf" ] || exit 0
TODO_HUB_URL=
TODO_API_TOKEN=
# shellcheck source=/dev/null
. "$conf" 2>/dev/null || exit 0
[ -n "$TODO_HUB_URL" ] || exit 0

prompt_time=$(date +%s)

# Newest keyboard activity (epoch seconds) of any tmux client attached to the session.
latest_activity() {
  if [ -n "${AI_TODO_CLIENT_ACTIVITY_FILE:-}" ]; then
    cat "$AI_TODO_CLIENT_ACTIVITY_FILE" 2>/dev/null
  else
    tmux ${AI_TODO_TMUX_SOCKET:+-L "$AI_TODO_TMUX_SOCKET"} list-clients -t "=$session" -F '#{client_activity}' 2>/dev/null
  fi | sort -n | tail -n 1
}

attended=false
latest=$(latest_activity)
case "$latest" in
  '' | *[!0-9]*) ;;
  *) [ "$latest" -ge $((prompt_time - 60)) ] && attended=true ;;
esac

only_if_changed=
if [ "$status" = tool ]; then
  status=busy
  only_if_changed=1
fi

if command -v python3 >/dev/null 2>&1; then
  # Prints the session id, the effective status, then the JSON body.
  parsed=$(printf '%s' "$input" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sid = data.get("session_id") if isinstance(data, dict) else None
if not isinstance(sid, str) or not sid or not all(c.isalnum() or c == "-" for c in sid):
    sys.exit(1)
status = sys.argv[1]
msg = data.get("message")
msg = msg if isinstance(msg, str) else ""
if status == "waiting" and (
    data.get("notification_type") == "idle_prompt" or "waiting for your input" in msg.lower()
):
    status = "idle"
out = {"claude_session_id": sid, "status": status, "attended": sys.argv[2] == "true"}
if status == "waiting" and msg:
    out["message"] = msg[:500]
print(sid)
print(status)
print(json.dumps(out))
' "$status" "$attended" 2>/dev/null) || exit 0
  sid=$(printf '%s\n' "$parsed" | sed -n 1p)
  status=$(printf '%s\n' "$parsed" | sed -n 2p)
  body=$(printf '%s\n' "$parsed" | sed -n 3p)
else
  # No python3: pull session_id out with sed and skip the message.
  sid=$(printf '%s' "$input" | tr -d '\n' | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9-]*\)".*/\1/p')
  [ -n "$sid" ] || exit 0
  if [ "$status" = waiting ] && printf '%s' "$input" | grep -qi 'idle_prompt\|waiting for your input'; then
    status=idle
  fi
  body=$(printf '{"claude_session_id":"%s","status":"%s","attended":%s}' "$sid" "$status" "$attended")
fi

state_dir="$HOME/.ai-remote/hook-state"
state_file="$state_dir/$sid"
if [ -n "$only_if_changed" ] && [ "$(cat "$state_file" 2>/dev/null)" = "$status" ]; then
  exit 0
fi
# A waiting entry names its prompt (time + pid), so a late re-check can tell whether the
# conversation is still waiting on the same prompt.
state=$status
[ "$status" = waiting ] && state="waiting $prompt_time.$$"
mkdir -p "$state_dir" 2>/dev/null && printf '%s\n' "$state" >"$state_file" 2>/dev/null
# Drop state files for sessions not touched in a week.
find "$state_dir" -type f -mtime +7 -exec rm -f {} + 2>/dev/null

post() {
  # The token goes through curl's config on stdin so it never shows up in `ps`.
  {
    if [ -n "$TODO_API_TOKEN" ]; then
      printf 'header = "Authorization: Bearer %s"\n' "$TODO_API_TOKEN"
    fi
  } | curl -s -o /dev/null --connect-timeout 2 --max-time 3 -K - \
    -H 'Content-Type: application/json' --data-binary "$body" \
    "${TODO_HUB_URL%/}/api/conversations/status"
}

# waiting only: if a client typed after the prompt appeared, the prompt was answered at the
# terminal; tell the server so it drops the push it is holding.
recheck() {
  [ "$status" = waiting ] && [ "$attended" = false ] || return 0
  sleep "${AI_TODO_RECHECK_DELAY:-12}"
  # Moved on (a later hook posted busy/idle, or another prompt is waiting now): re-posting
  # waiting would undo that, or answer the other prompt.
  [ "$(cat "$state_file" 2>/dev/null)" = "$state" ] || return 0
  latest=$(latest_activity)
  case "$latest" in
    '' | *[!0-9]*) return 0 ;;
  esac
  [ "$latest" -gt "$prompt_time" ] || return 0
  body=$(printf '%s' "$body" | sed 's/"attended": *false/"attended": true/')
  post
}

if [ "${AI_TODO_HOOK_SYNC:-}" = 1 ]; then
  { post; recheck; } >/dev/null 2>&1
else
  { post; recheck; } </dev/null >/dev/null 2>&1 &
fi
exit 0
