#!/usr/bin/env python3
"""Maintain Claude/Codex status: watch | publish [--time NS] | retry | codex-path | claude-path | ensure-runtime | doctor | report | launch save|resume-args|show … | restart NAME ID TOOL [--force] [--chrome on|off|default] [--search on|off] [--reopen CWD [--mcp NAMES] [--worktree FOLDER BRANCH]] | close-unused [--dry-run] | writer NAME ID | reap | loaded NAME | resume TOOL ID.

resume TOOL ID  the app's one-tap Resume for a conversation paused by a usage limit: check it
                (no question card, nothing typed, the limit has reset), take the hub's lease
                and type the resume message into its tmux session. Prints JSON; exit 0 when
                typed, 75 when not now ({"resumed": false, "reason": ...})."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from ai_todo_status import find_codex, find_claude, ClaudeRuntime, publish, read_json, retry_pending, root, RuntimeSocket, RuntimePool, socket_path, terminal, watch, writer_conflict, reap_backends, terminal_threads


def main(args):
    if args == ["watch"]:
        watch()
    elif args[:1] == ["terminal"] and len(args) >= 4:
        terminal(args[1], args[2], args[3:])
    elif args[:1] == ["writer"] and len(args) == 3:
        # 95: another Codex holds the conversation (ai-todo-open's exit code for it).
        conflict = writer_conflict(args[1], args[2])
        if conflict:
            print(conflict, file=sys.stderr)
            return 95
    elif args[:1] == ["loaded"] and len(args) == 2:
        for sid in terminal_threads(args[1]):
            print(sid)
    elif args[:1] == ["resume"] and len(args) == 3 and args[1] in ("claude", "codex"):
        import ai_todo_resume
        code, result = ai_todo_resume.resume_now(args[1], args[2])
        print(json.dumps(result))
        return code
    elif args == ["reap"]:
        # The status service does this every minute; by hand it prints the pids it stopped.
        print(json.dumps(reap_backends()))
    elif args == ["codex-path"]:
        print(find_codex())
    elif args == ["claude-path"]:
        print(find_claude())
    elif args == ["ensure-runtime"]:
        try:
            client = RuntimeSocket(socket_path())
            client.close()
        except (OSError, ValueError, EOFError, TimeoutError):
            codex = find_codex()
            environment = os.environ.copy()
            environment["PATH"] = str(Path(codex).parent) + os.pathsep + environment.get("PATH", "")
            result = subprocess.run([codex, "app-server", "daemon", "start"], capture_output=True, text=True, env=environment, timeout=30)
            if result.returncode:
                raise OSError("Could not start the managed Codex runtime")
            client = RuntimeSocket(socket_path())
            client.close()
        print("unix://" + str(socket_path()))
    elif args == ["retry"]:
        print(json.dumps(retry_pending()))
    elif args[:1] == ["publish"]:
        observed = int(args[2]) if len(args) == 3 and args[1] == "--time" else time.time_ns()
        return 0 if publish(json.load(sys.stdin), observed) else 1
    elif args == ["doctor"]:
        from ai_todo_doctor import doctor
        print(json.dumps(doctor(), indent=2))
    elif args[:1] == ["launch"]:
        # A conversation's launch settings, saved at its start and put back on a resume.
        from ai_todo_launch import main as launch
        return launch(args[1:])
    elif args[:1] == ["restart"]:
        # One conversation, on the user's request: end its CLI cleanly, optionally start it again.
        from ai_todo_restart import main as restart
        code, result = restart(args[1:])
        if result is None:
            print(__doc__, file=sys.stderr)
            return code
        print(json.dumps(result))
        return code
    elif args[:1] == ["close-unused"]:
        # The runner, every 10 minutes: end the sessions whose todo is archived or deleted.
        from ai_todo_restart import close_unused_main
        code, result = close_unused_main(args[1:])
        if result is None:
            print(__doc__, file=sys.stderr)
            return code
        print(json.dumps(result))
        return code
    elif args == ["report"]:
        # The doctor report to the hub, for the app's Health page (the runner starts this).
        from ai_todo_doctor import report
        return report()
    else:
        print(__doc__, file=sys.stderr)
        return 64
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as error:
        print("ai-todo-status: " + type(error).__name__, file=sys.stderr)
        sys.exit(1)
