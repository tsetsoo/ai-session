#!/usr/bin/env python3
"""Maintain Claude/Codex status: watch | publish [--time NS] | retry | codex-path | claude-path | ensure-runtime | doctor | writer NAME ID | reap | loaded NAME."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from ai_todo_status import find_codex, find_claude, ClaudeRuntime, publish, read_json, retry_pending, root, RuntimeSocket, RuntimePool, socket_path, terminal, watch, writer_conflict, reap_backends, terminal_threads


def main(args):
    if args == ["watch"]:
        watch()
    elif args[:1] == ["terminal"] and len(args) >= 4:
        terminal(args[1], args[2], args[3:])
    elif args[:1] == ["writer"] and len(args) == 3:
        # 95: another Codex holds the conversation (ai-todo-open's exit code for it).
        conflict = writer_conflict(args[1], args[2])
        if conflict:
            print(conflict, file=sys.stderr)
            return 95
    elif args[:1] == ["loaded"] and len(args) == 2:
        for sid in terminal_threads(args[1]):
            print(sid)
    elif args == ["reap"]:
        # The status service does this every minute; by hand it prints the pids it stopped.
        print(json.dumps(reap_backends()))
    elif args == ["codex-path"]:
        print(find_codex())
    elif args == ["claude-path"]:
        print(find_claude())
    elif args == ["ensure-runtime"]:
        try:
            client = RuntimeSocket(socket_path())
            client.close()
        except (OSError, ValueError, EOFError, TimeoutError):
            codex = find_codex()
            environment = os.environ.copy()
            environment["PATH"] = str(Path(codex).parent) + os.pathsep + environment.get("PATH", "")
            result = subprocess.run([codex, "app-server", "daemon", "start"], capture_output=True, text=True, env=environment, timeout=30)
            if result.returncode:
                raise OSError("Could not start the managed Codex runtime")
            client = RuntimeSocket(socket_path())
            client.close()
        print("unix://" + str(socket_path()))
    elif args == ["retry"]:
        print(json.dumps(retry_pending()))
    elif args[:1] == ["publish"]:
        observed = int(args[2]) if len(args) == 3 and args[1] == "--time" else time.time_ns()
        return 0 if publish(json.load(sys.stdin), observed) else 1
    elif args == ["doctor"]:
        service = read_json(root() / "health.json", {})
        result = {"protocol_version": 2, "codex": None, "runtime_connected": False,
                  "status_service": service, "service_running": 0 <= time.time_ns() - service.get("checked_ns", 0) < 8_000_000_000, "pending": 0}
        try:
            result["codex"] = find_codex()
        except FileNotFoundError as error:
            result["codex_error"] = str(error)
        try:
            pool = RuntimePool()
            try:
                result["runtime_threads"] = len(pool.states())
                result["runtime_connected"] = True
                result["runtime_count"] = len(pool.clients)
                hooks = next(iter(pool.clients.values())).call("hooks/list", {"cwds": [str(Path.home())]})
                result["hooks"] = [{k: hook.get(k) for k in ["eventName", "enabled", "trustStatus"]}
                                   for entry in hooks.get("data", []) for hook in entry.get("hooks", [])
                                   if "ai-todo-hook" in hook.get("command", "")]
            finally:
                pool.close()
        except (OSError, ValueError, EOFError, TimeoutError) as error:
            result["runtime_error"] = type(error).__name__
        claude_health = read_json(root() / "claude-health.json", {})
        result["claude_service"] = dict(claude_health, fresh=0 <= time.time_ns() - claude_health.get("checked_ns", 0) < 12_000_000_000)
        try:
            claude = ClaudeRuntime()
            result["claude"] = {"binary": claude.cli, "threads": len(claude.states()), "connected": True}
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            result["claude"] = {"connected": False, "error": type(error).__name__}
        result["pending"] = sum(bool(read_json(path, {}).get("pending")) for path in root().glob("*.json"))
        print(json.dumps(result, indent=2))
    else:
        print(__doc__, file=sys.stderr)
        return 64
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as error:
        print("ai-todo-status: " + type(error).__name__, file=sys.stderr)
        sys.exit(1)
