#!/bin/sh
# The scheduler's runner on this computer: start the scheduled conversations todo-server says
# are due here. launchd runs `ai-todo-runner tick` every 60 s (install.sh).
#
# Usage:
#   ai-todo-runner tick              # one pass: at most 3 conversations started
#   ai-todo-runner status [--json]   # last tick, last error, runs started in the last 24 h
#
# A tick: GET /api/runner/due?computer_id=<this computer>, then per due run, in order:
#   1. Usage limit. A job set to "wait for headroom" reads usage on this computer
#      (ai-todo-limits --tool <tool>, 20 s at most). Over its thresholds (the job's own, else
#      the hub's settings: 5-hour 60%, weekly 80%) -> POST /api/runs/<id>/wait with the
#      reason. No reading -> it starts only while fewer than 3 such runs of that tool started
#      in the last 24 hours. "Always run" jobs skip this.
#   2. POST /api/runs/<id>/claim (409: another runner has it; skip).
#   3. A git worktree of the project folder at ~/.ai-remote/worktrees/<project>/<run>, on
#      branch scheduled/<job>-<YYYYMMDD>-<run id first 8>, from origin/HEAD (else HEAD). The
#      live checkout is never switched or changed. A folder that is not a git repository is
#      used as it is.
#   4. POST /api/runs/<id>/start {cwd, is_git}: the hub creates the scheduled todo and its
#      conversation and answers the tmux name, session id and first prompt.
#   5. ai-todo-open --detached --auto-approve --prompt-file <file> <tmux> <cwd> <id|-> <tool>
#   6. POST /api/runs/<id>/finish {state: done|failed, result}. A failed start removes the
#      worktree and branch it made.
#
# Never prints or logs prompt text. Log: ~/.ai-remote/runner-state/runner.log (ids, counts,
# errors). Exit 0 except 64 bad arguments, 65 no hub / computer id.
#
# Config: ~/.ai-remote/todo-hub.conf (TODO_HUB_URL, TODO_API_TOKEN, TODO_COMPUTER_ID).
# Test hooks: AI_TODO_HUB_CONF, AI_TODO_OPEN_BIN, AI_TODO_LIMITS_BIN, AI_TODO_LIMITS_TIMEOUT,
#   AI_TODO_RUNNER_STATE_DIR, AI_TODO_RUNNER_WORKTREES
AI_TODO_LIB_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) && export AI_TODO_LIB_DIR
ai_path=
ai_ifs=$IFS
IFS=:
set -f
for ai_dir in /opt/homebrew/bin /home/linuxbrew/.linuxbrew/bin /usr/local/bin "$HOME/.local/bin" /usr/sbin /sbin $PATH; do
  [ -n "$ai_dir" ] || continue
  case "$ai_dir" in /home/*) if [ -d /System ]; then continue; fi ;; esac
  case ":$ai_path:" in *":$ai_dir:"*) continue ;; esac
  ai_path=${ai_path:+$ai_path:}$ai_dir
done
set +f
IFS=$ai_ifs
export PATH="$ai_path"
unset ai_path ai_ifs ai_dir
command -v python3 >/dev/null 2>&1 || { echo "python3 not found" >&2; exit 90; }
exec python3 - "$@" <<'PY'
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
LIB_DIR = os.environ.get("AI_TODO_LIB_DIR") or os.path.join(HOME, ".ai-remote", "bin")
AI_DIR = os.path.join(HOME, ".ai-remote")
STATE_DIR = os.environ.get("AI_TODO_RUNNER_STATE_DIR") or os.path.join(AI_DIR, "runner-state")
TREES = os.environ.get("AI_TODO_RUNNER_WORKTREES") or os.path.join(AI_DIR, "worktrees")
OPEN_BIN = os.environ.get("AI_TODO_OPEN_BIN") or os.path.join(LIB_DIR, "ai-todo-open")
LIMITS_BIN = os.environ.get("AI_TODO_LIMITS_BIN") or os.path.join(LIB_DIR, "ai-todo-limits")
LIMITS_TIMEOUT = float(os.environ.get("AI_TODO_LIMITS_TIMEOUT") or 20)
MAX_STARTS = 3
OPEN_TIMEOUT = float(os.environ.get("AI_TODO_OPEN_TIMEOUT") or 180)
# A worktree older than this with no changes and no commits of its own is removed.
CLEANUP_AFTER = 3 * 86400
NO_READING_CAP = 3
PROJECTS_TTL = 600
LOG_MAX = 1 << 20


def now():
    return time.time()


def iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def ensure_state():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)


def log(event, **fields):
    try:
        ensure_state()
        path = os.path.join(STATE_DIR, "runner.log")
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
            os.replace(path, path + ".1")
        parts = [iso(now()), event] + ["%s=%s" % (k, " ".join(str(v).split())) for k, v in fields.items()]
        with open(path, "a") as f:
            f.write(" ".join(parts) + "\n")
    except OSError:
        pass


def load_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    ensure_state()
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".runner.")
    with os.fdopen(fd, "w") as f:
        json.dump(value, f)
    os.replace(tmp, path)


class Config:
    def __init__(self):
        self.path = os.environ.get("AI_TODO_HUB_CONF") or os.path.join(AI_DIR, "todo-hub.conf")
        self.values = {}
        try:
            with open(self.path) as f:
                for line in f:
                    m = re.match(r"\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
                    if m:
                        raw = m.group(2).strip()
                        if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"":
                            raw = raw[1:-1]
                        self.values[m.group(1)] = raw
        except OSError:
            pass
        if os.environ.get("TODO_COMPUTER_ID"):
            self.values["TODO_COMPUTER_ID"] = os.environ["TODO_COMPUTER_ID"]

    def get(self, key):
        return self.values.get(key, "") or ""


class HubError(Exception):
    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


class Hub:
    def __init__(self, conf):
        self.url = conf.get("TODO_HUB_URL").rstrip("/")
        self.token = conf.get("TODO_API_TOKEN")

    def request(self, method, path, query=None, body=None, timeout=20):
        url = self.url + path + ("?" + urllib.parse.urlencode(query) if query else "")
        data = None if body is None else json.dumps(body).encode("utf-8")
        req = urllib.request.Request(url, data=data, method=method)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        if self.token:
            req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as response:
                raw = response.read()
        except urllib.error.HTTPError as e:
            raise HubError("%s %s: HTTP %s" % (method, path, e.code), e.code)
        except (urllib.error.URLError, OSError) as e:
            raise HubError("%s %s: %s" % (method, path, type(e).__name__))
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise HubError("%s %s: not JSON" % (method, path))


def expand(folder):
    folder = folder or ""
    if folder == "~" or folder.startswith("~/"):
        folder = HOME + folder[1:]
    return os.path.normpath(folder) if folder else ""


def tilde(path):
    if path == HOME or path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


def project_folders(hub):
    """{project id: folder} from GET /api/projects, cached for 10 minutes."""
    path = os.path.join(STATE_DIR, "projects.json")
    cache = load_json(path)
    if isinstance(cache, dict) and now() - float(cache.get("fetched_at") or 0) < PROJECTS_TTL:
        return cache.get("folders") or {}
    projects = hub.request("GET", "/api/projects") or []
    folders = {p["id"]: p.get("folder") for p in projects if isinstance(p, dict) and p.get("id")}
    save_json(path, {"fetched_at": now(), "folders": folders})
    return folders


# --- Usage limits -------------------------------------------------------------------

def read_usage(tool):
    """{"5h": pct, "weekly": pct} on this computer, or None (no reading)."""
    try:
        p = subprocess.run([LIMITS_BIN, "--tool", tool], capture_output=True, text=True,
                           timeout=LIMITS_TIMEOUT, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    try:
        windows = json.loads(p.stdout).get("windows") or []
    except (ValueError, AttributeError):
        return None
    reading = {}
    for w in windows:
        if isinstance(w, dict) and isinstance(w.get("used_percent"), (int, float)):
            # A model-scoped window (weekly opus/sonnet) never hides a fuller account window.
            reading[w.get("kind")] = max(reading.get(w.get("kind"), 0.0), float(w["used_percent"]))
    return reading or None


def pct(value):
    return ("%g" % value) + "%"


def wait_reason(due, settings, started_now):
    """(reason or None, no_reading). started_now: no-reading starts per tool in this tick."""
    action = due["job"]["action"]
    limit = action.get("limit") or {}
    if limit.get("mode") != "wait":
        return None, False
    five = limit.get("five_hour") or settings.get("five_hour") or 60
    weekly = limit.get("weekly") or settings.get("weekly") or 80
    tool = action.get("tool") or "claude"
    reading = read_usage(tool)
    if reading is None:
        count = int(due.get("wait_runs_24h") or 0) + started_now.get(tool, 0)
        if count >= NO_READING_CAP:
            return "no usage reading; %d runs in 24h" % count, True
        return None, True
    if reading.get("5h") is not None and reading["5h"] > five:
        return "5h %s > %s" % (pct(reading["5h"]), pct(five)), False
    if reading.get("weekly") is not None and reading["weekly"] > weekly:
        return "weekly %s > %s" % (pct(reading["weekly"]), pct(weekly)), False
    return None, False


# --- Worktrees ----------------------------------------------------------------------

def git(folder, *args, timeout=60):
    try:
        p = subprocess.run(["git", "-C", folder] + list(args), capture_output=True, text=True,
                           timeout=timeout, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", type(e).__name__


def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "job"


def make_worktree(folder, project_id, run_id, job_name):
    """(cwd, is_git, branch or None). Raises RuntimeError when a git worktree can't be made."""
    if git(folder, "rev-parse", "--show-toplevel")[0] != 0:
        return folder, False, None
    if git(folder, "remote", "get-url", "origin")[0] == 0:
        git(folder, "fetch", "--quiet", "origin", timeout=30)
    base = "origin/HEAD" if git(folder, "rev-parse", "--verify", "--quiet", "origin/HEAD")[0] == 0 else "HEAD"
    branch = "scheduled/%s-%s-%s" % (slug(job_name), time.strftime("%Y%m%d"), run_id[:8])
    path = os.path.join(TREES, project_id, run_id)
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    base_sha = git(folder, "rev-parse", base)[1]
    code, _, err = git(folder, "worktree", "add", "-b", branch, path, base)
    if code != 0:
        raise RuntimeError("git worktree add failed: %s" % err[:200])
    registry = load_json(registry_path(), {}) or {}
    registry[run_id] = {"path": path, "folder": folder, "branch": branch, "base": base_sha, "created": now()}
    save_json(registry_path(), registry)
    return path, True, branch


def registry_path():
    return os.path.join(STATE_DIR, "worktrees.json")


def remove_worktree(folder, path, branch):
    git(folder, "worktree", "remove", "--force", path)
    if branch:
        git(folder, "branch", "-D", branch)


def cleanup_worktrees():
    """Remove scheduled worktrees older than 3 days that hold nothing: no uncommitted changes
    and no commits beyond the base they started from. Any with work in them are kept."""
    registry = load_json(registry_path(), {}) or {}
    changed = False
    for run_id, entry in list(registry.items()):
        if now() - float(entry.get("created") or now()) < CLEANUP_AFTER:
            continue
        path, folder = entry.get("path") or "", entry.get("folder") or ""
        if not os.path.isdir(path):
            registry.pop(run_id)
            changed = True
            continue
        dirty = git(path, "status", "--porcelain")
        ahead = git(path, "rev-list", "--count", "%s..HEAD" % entry.get("base")) if entry.get("base") else (1, "", "")
        if dirty[0] == 0 and not dirty[1] and ahead[0] == 0 and ahead[1] == "0":
            remove_worktree(folder, path, entry.get("branch"))
            registry.pop(run_id)
            changed = True
            log("cleaned", run=run_id)
    if changed:
        save_json(registry_path(), registry)


# --- Tick ---------------------------------------------------------------------------

def start_run(hub, computer_id, due, folders):
    run, job = due["run"], due["job"]
    action = job["action"]
    project_folder = expand(folders.get(action.get("project_id")))
    folder = expand(action.get("folder")) if action.get("folder") else project_folder
    if not project_folder or not folder or not os.path.isdir(folder):
        raise RuntimeError("project folder not found on this computer")
    # The hub only names folders inside a project this computer knows: a job can't point a
    # conversation at an arbitrary place.
    if folder != project_folder and not folder.startswith(project_folder.rstrip("/") + "/"):
        raise RuntimeError("folder is outside the project")
    path, is_git, branch = make_worktree(folder, action["project_id"], run["id"], job.get("name") or "job")
    try:
        started = hub.request("POST", "/api/runs/%s/start" % run["id"], body={"cwd": tilde(path), "is_git": is_git})
        ensure_state()
        fd, prompt_file = tempfile.mkstemp(dir=STATE_DIR, prefix="prompt.")
        with os.fdopen(fd, "w") as f:
            f.write(started.get("prompt") or "")
        if not isinstance(started, dict) or not started.get("tmux_name"):
            raise RuntimeError("the hub's start answer is empty")
        sid = started.get("session_id") or "-"
        # Auto-approve only inside a scheduled git worktree, never in a folder used in place.
        argv = [OPEN_BIN, "--detached"] + (["--auto-approve"] if is_git else []) + [
            "--prompt-file", prompt_file, started["tmux_name"], tilde(path), sid,
            started.get("tool") or action.get("tool") or "claude"]
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=OPEN_TIMEOUT, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            # The conversation may be running in the worktree already: keep it.
            raise RuntimeError("ai-todo-open timed out; the worktree is kept")
        finally:
            if os.path.exists(prompt_file):
                os.remove(prompt_file)
        if p.returncode != 0:
            raise RuntimeError("ai-todo-open exit %d: %s" % (p.returncode, (p.stderr or "").strip()[:200]))
        # A new Codex (or Cursor) conversation gets its id only once it starts; ai-todo-open
        # prints "created <id>". The hub needs it to match the conversation's status.
        words = (p.stdout or "").strip().split()
        if sid == "-" and len(words) == 2 and words[0] == "created" and started.get("todo_id"):
            try:
                hub.request("PUT", "/api/todos/%s/conversation/session" % started["todo_id"],
                            body={"session_id": words[1]})
            except HubError as e:
                log("session_report_failed", run=run["id"], error=e)
    except Exception as e:
        if is_git and "timed out" not in str(e):
            remove_worktree(folder, path, branch)
        raise
    return "started %s in %s" % (started.get("tool") or action.get("tool"), tilde(path))


def cmd_tick(args):
    if args:
        print("usage: ai-todo-runner tick", file=sys.stderr)
        sys.exit(64)
    conf = Config()
    computer_id = conf.get("TODO_COMPUTER_ID")
    if not conf.get("TODO_HUB_URL") or not computer_id:
        print("ai-todo-runner: TODO_HUB_URL and TODO_COMPUTER_ID are needed in %s" % conf.path, file=sys.stderr)
        sys.exit(65)
    hub = Hub(conf)
    status_path = os.path.join(STATE_DIR, "status.json")
    status = load_json(status_path, {}) or {}
    status["last_tick"] = now()
    started = 0
    no_reading_started = {}
    try:
        due = hub.request("GET", "/api/runner/due", query={"computer_id": computer_id}) or {}
        settings = due.get("settings") or {}
        runs = due.get("runs") or []
        folders = project_folders(hub) if runs else {}
        for item in runs:
            if started >= MAX_STARTS:
                break
            rid = item["run"]["id"]
            tool = item["job"]["action"].get("tool") or "claude"
            reason, no_reading = wait_reason(item, settings, no_reading_started)
            if reason:
                hub.request("POST", "/api/runs/%s/wait" % rid, body={"reason": reason})
                log("wait", run=rid)
                continue
            try:
                claim = {"computer_id": computer_id}
                if no_reading:
                    claim["no_reading"] = True
                hub.request("POST", "/api/runs/%s/claim" % rid, body=claim)
            except HubError as e:
                if e.status == 409:
                    log("claim_lost", run=rid)
                    continue
                raise
            try:
                result = start_run(hub, computer_id, item, folders)
                hub.request("POST", "/api/runs/%s/finish" % rid, body={"state": "done", "result": result})
                started += 1
                if no_reading:
                    no_reading_started[tool] = no_reading_started.get(tool, 0) + 1
                status.setdefault("started", []).append(now())
                log("started", run=rid, tool=item["job"]["action"].get("tool"))
            except Exception as e:  # every claimed run gets a finish, whatever went wrong
                message = str(e) or type(e).__name__
                status["last_error"] = message
                log("failed", run=rid, error=message)
                try:
                    hub.request("POST", "/api/runs/%s/finish" % rid, body={"state": "failed", "result": message})
                except HubError:
                    pass
    except HubError as e:
        status["last_error"] = str(e)
        log("error", error=e)
    cleanup_worktrees()
    status["started"] = [t for t in status.get("started", []) if t > now() - 86400]
    save_json(status_path, status)


def cmd_status(args):
    status = load_json(os.path.join(STATE_DIR, "status.json"), {}) or {}
    out = {"last_tick": iso(status["last_tick"]) if status.get("last_tick") else None,
           "last_error": status.get("last_error"),
           "started_24h": len([t for t in status.get("started", []) if t > now() - 86400])}
    if "--json" in args:
        print(json.dumps(out))
    else:
        for key, value in out.items():
            print("%-12s %s" % (key + ":", value if value is not None else "-"))


def main(argv):
    commands = {"tick": cmd_tick, "status": cmd_status}
    if not argv or argv[0] not in commands:
        print("usage: ai-todo-runner tick | status [--json]", file=sys.stderr)
        sys.exit(64)
    commands[argv[0]](argv[1:])


main(sys.argv[1:])
PY
