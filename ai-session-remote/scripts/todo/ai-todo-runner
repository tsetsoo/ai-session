#!/bin/sh
# The scheduler's runner on this computer: start the scheduled conversations todo-server says
# are due here. launchd runs `ai-todo-runner tick` every 60 s (install.sh).
#
# Usage:
#   ai-todo-runner tick              # one pass: at most 3 conversations started
#   ai-todo-runner status [--json]   # last tick, last error and when, runs started in the last 24 h
#
# A tick: GET /api/runner/due?computer_id=<this computer>, then per due run, in order:
#   1. Usage limit. A job set to "wait for headroom" reads usage on this computer
#      (ai-todo-limits --tool <tool>, 20 s at most). Over its thresholds (the job's own, else
#      the hub's settings: 5-hour 60%, weekly 80%) -> POST /api/runs/<id>/wait with the
#      reason. No reading -> it starts only while fewer than 3 such runs of that tool started
#      in the last 24 hours. "Always run" jobs skip this.
#   2. POST /api/runs/<id>/claim (409: another runner has it; skip).
#   3. A git worktree of the project folder at ~/.ai-remote/worktrees/<project>/<run>, on
#      branch scheduled/<job>-<YYYYMMDD>-<run id first 8>, from origin/HEAD (else HEAD). The
#      live checkout is never switched or changed. A folder that is a subfolder of its repo
#      (a monorepo component) opens at that subfolder inside the worktree. A folder that is
#      not a git repository is used as it is. The repo's gitignored local files named in
#      .worktreeinclude (copied) and .worktreelink (symlinked) are brought in
#      (ai_todo_workspace.py). Each tick removes worktrees older than 3 days that are clean and
#      have no commits, or whose work is already merged into origin/HEAD.
#   4. POST /api/runs/<id>/start {cwd, is_git}: the hub creates the scheduled todo and its
#      conversation and answers the tmux name, session id and first prompt.
#   5. ai-todo-open --detached --auto-approve --prompt-file <file> <tmux> <cwd> <id|-> <tool>
#   6. POST /api/runs/<id>/finish {state: done|failed, result}. A failed start removes the
#      worktree and branch it made.
#
# Watch runs (job action kind "watch"): claim, run ~/.ai-remote/watchers/<watcher> check with
# the variables of ~/.ai-remote/watchers/env added (60 s at most), then POST
# /api/runs/<id>/report with its JSON, or finish failed. No usage guard, no worktree. The due
# answer's "resolves" run `<watcher> resolve <key>` and POST /api/watch/issues/<id>/resolve-result.
# Watcher output is never logged; error messages have the env file's values redacted.
#
# Daily updates: after a tick that reached the hub, `ai-todo-updates run` is started in the
# background (at most every 5 minutes; it takes its own lock).
#
# Never prints or logs prompt text. Log: ~/.ai-remote/runner-state/runner.log (ids, counts,
# errors). Exit 0 except 64 bad arguments, 65 no hub / computer id.
#
# Config: ~/.ai-remote/todo-hub.conf (TODO_HUB_URL, TODO_API_TOKEN, TODO_COMPUTER_ID).
# Test hooks: AI_TODO_HUB_CONF, AI_TODO_OPEN_BIN, AI_TODO_LIMITS_BIN, AI_TODO_LIMITS_TIMEOUT,
#   AI_TODO_RUNNER_STATE_DIR, AI_TODO_RUNNER_WORKTREES, AI_TODO_WATCHERS_DIR, AI_TODO_UPDATES_BIN
AI_TODO_LIB_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) && export AI_TODO_LIB_DIR
ai_path=
ai_ifs=$IFS
IFS=:
set -f
for ai_dir in /opt/homebrew/bin /home/linuxbrew/.linuxbrew/bin /usr/local/bin "$HOME/.local/bin" /usr/sbin /sbin $PATH; do
  [ -n "$ai_dir" ] || continue
  case "$ai_dir" in /home/*) if [ -d /System ]; then continue; fi ;; esac
  case ":$ai_path:" in *":$ai_dir:"*) continue ;; esac
  ai_path=${ai_path:+$ai_path:}$ai_dir
done
set +f
IFS=$ai_ifs
export PATH="$ai_path"
unset ai_path ai_ifs ai_dir
command -v python3 >/dev/null 2>&1 || { echo "python3 not found" >&2; exit 90; }
exec python3 - "$@" <<'PY'
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser("~")
LIB_DIR = os.environ.get("AI_TODO_LIB_DIR") or os.path.join(HOME, ".ai-remote", "bin")
AI_DIR = os.path.join(HOME, ".ai-remote")
STATE_DIR = os.environ.get("AI_TODO_RUNNER_STATE_DIR") or os.path.join(AI_DIR, "runner-state")
TREES = os.environ.get("AI_TODO_RUNNER_WORKTREES") or os.path.join(AI_DIR, "worktrees")
OPEN_BIN = os.environ.get("AI_TODO_OPEN_BIN") or os.path.join(LIB_DIR, "ai-todo-open")
LIMITS_BIN = os.environ.get("AI_TODO_LIMITS_BIN") or os.path.join(LIB_DIR, "ai-todo-limits")
WATCHERS = os.environ.get("AI_TODO_WATCHERS_DIR") or os.path.join(AI_DIR, "watchers")
JOBS = os.environ.get("AI_TODO_JOBS_DIR") or os.path.join(AI_DIR, "jobs")
UPDATES_BIN = os.environ.get("AI_TODO_UPDATES_BIN") or os.path.join(LIB_DIR, "ai-todo-updates")
sys.path.insert(0, LIB_DIR)
import ai_todo_workspace as workspace  # noqa: E402

UPDATES_EVERY = 300
WATCH_TIMEOUT = 60
LIMITS_TIMEOUT = float(os.environ.get("AI_TODO_LIMITS_TIMEOUT") or 20)
MAX_STARTS = 3
OPEN_TIMEOUT = float(os.environ.get("AI_TODO_OPEN_TIMEOUT") or 180)
# A worktree older than this that is clean and has no unmerged commits is removed.
CLEANUP_AFTER = 3 * 86400
NO_READING_CAP = 3
PROJECTS_TTL = 600
LOG_MAX = 1 << 20


def now():
    return time.time()


def iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def ensure_state():
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)


def log(event, **fields):
    try:
        ensure_state()
        path = os.path.join(STATE_DIR, "runner.log")
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
            os.replace(path, path + ".1")
        parts = [iso(now()), event] + ["%s=%s" % (k, " ".join(str(v).split())) for k, v in fields.items()]
        with open(path, "a") as f:
            f.write(" ".join(parts) + "\n")
    except OSError:
        pass


def load_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, value):
    ensure_state()
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".runner.")
    with os.fdopen(fd, "w") as f:
        json.dump(value, f)
    os.replace(tmp, path)


class Config:
    def __init__(self):
        self.path = os.environ.get("AI_TODO_HUB_CONF") or os.path.join(AI_DIR, "todo-hub.conf")
        self.values = {}
        try:
            with open(self.path) as f:
                for line in f:
                    m = re.match(r"\s*(?:export\s+)?([A-Z_][A-Z0-9_]*)=(.*)$", line.rstrip("\n"))
                    if m:
                        raw = m.group(2).strip()
                        if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"":
                            raw = raw[1:-1]
                        self.values[m.group(1)] = raw
        except OSError:
            pass
        if os.environ.get("TODO_COMPUTER_ID"):
            self.values["TODO_COMPUTER_ID"] = os.environ["TODO_COMPUTER_ID"]

    def get(self, key):
        return self.values.get(key, "") or ""


class HubError(Exception):
    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


class Hub:
    def __init__(self, conf):
        self.url = conf.get("TODO_HUB_URL").rstrip("/")
        self.token = conf.get("TODO_API_TOKEN")

    def request(self, method, path, query=None, body=None, timeout=20):
        url = self.url + path + ("?" + urllib.parse.urlencode(query) if query else "")
        data = None if body is None else json.dumps(body).encode("utf-8")
        req = urllib.request.Request(url, data=data, method=method)
        if data is not None:
            req.add_header("Content-Type", "application/json")
        if self.token:
            req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as response:
                raw = response.read()
        except urllib.error.HTTPError as e:
            raise HubError("%s %s: HTTP %s" % (method, path, e.code), e.code)
        except (urllib.error.URLError, OSError) as e:
            raise HubError("%s %s: %s" % (method, path, type(e).__name__))
        try:
            return json.loads(raw) if raw else None
        except ValueError:
            raise HubError("%s %s: not JSON" % (method, path))


def expand(folder):
    folder = folder or ""
    if folder == "~" or folder.startswith("~/"):
        folder = HOME + folder[1:]
    return os.path.normpath(folder) if folder else ""


def tilde(path):
    if path == HOME or path.startswith(HOME + "/"):
        return "~" + path[len(HOME):]
    return path


def project_folders(hub):
    """{project id: folder} from GET /api/projects, cached for 10 minutes."""
    path = os.path.join(STATE_DIR, "projects.json")
    cache = load_json(path)
    if isinstance(cache, dict) and now() - float(cache.get("fetched_at") or 0) < PROJECTS_TTL:
        return cache.get("folders") or {}
    projects = hub.request("GET", "/api/projects") or []
    folders = {p["id"]: p.get("folder") for p in projects if isinstance(p, dict) and p.get("id")}
    save_json(path, {"fetched_at": now(), "folders": folders})
    return folders


# --- Usage limits -------------------------------------------------------------------

def read_usage(tool):
    """{"5h": pct, "weekly": pct} on this computer, or None (no reading)."""
    try:
        p = subprocess.run([LIMITS_BIN, "--tool", tool], capture_output=True, text=True,
                           timeout=LIMITS_TIMEOUT, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    try:
        windows = json.loads(p.stdout).get("windows") or []
    except (ValueError, AttributeError):
        return None
    reading = {}
    for w in windows:
        if isinstance(w, dict) and isinstance(w.get("used_percent"), (int, float)):
            # A model-scoped window (weekly opus/sonnet) never hides a fuller account window.
            reading[w.get("kind")] = max(reading.get(w.get("kind"), 0.0), float(w["used_percent"]))
    return reading or None


def pct(value):
    return ("%g" % value) + "%"


AUTO_WEEKLY_CAP = 80


def choose_tool():
    """For a job whose tool is `auto` (the assistant): the tool with more weekly headroom.
    No reading for either: claude. One reading: that tool unless it's above 80% weekly."""
    weekly = {}
    for tool in ("claude", "codex"):
        reading = read_usage(tool)
        if reading is not None and reading.get("weekly") is not None:
            weekly[tool] = reading["weekly"]
    if len(weekly) == 2:
        return "codex" if weekly["codex"] < weekly["claude"] else "claude"
    if len(weekly) == 1:
        (tool, used), = weekly.items()
        if used <= AUTO_WEEKLY_CAP:
            return tool
        return "codex" if tool == "claude" else "claude"
    return "claude"


def wait_reason(due, settings, started_now):
    """(reason or None, no_reading). started_now: no-reading starts per tool in this tick."""
    action = due["job"]["action"]
    limit = action.get("limit") or {}
    if limit.get("mode") != "wait":
        return None, False
    five = limit.get("five_hour") or settings.get("five_hour") or 60
    weekly = limit.get("weekly") or settings.get("weekly") or 80
    tool = action.get("tool") or "claude"
    reading = read_usage(tool)
    if reading is None:
        count = int(due.get("wait_runs_24h") or 0) + started_now.get(tool, 0)
        if count >= NO_READING_CAP:
            return "no usage reading; %d runs in 24h" % count, True
        return None, True
    if reading.get("5h") is not None and reading["5h"] > five:
        return "5h %s > %s" % (pct(reading["5h"]), pct(five)), False
    if reading.get("weekly") is not None and reading["weekly"] > weekly:
        return "weekly %s > %s" % (pct(reading["weekly"]), pct(weekly)), False
    return None, False


# --- Worktrees (ai_todo_workspace.py) ----------------------------------------------

def slug(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:40] or "job"


def make_worktree(folder, project_id, run_id, job_name):
    """(worktree root, cwd, is_git, branch or None). The cwd is the folder's place inside the
    worktree: a folder that is a subfolder of its repo (a monorepo component) opens there, not at
    the repo root. Raises RuntimeError when a git worktree can't be made."""
    branch = "scheduled/%s-%s-%s" % (slug(job_name), time.strftime("%Y%m%d"), run_id[:8])
    path = os.path.join(TREES, project_id, run_id)
    try:
        cwd, entry = workspace.create(folder, path, branch)
        entry.pop("reused_branch", None)
    except workspace.NotARepo:
        return folder, folder, False, None
    try:
        with workspace.locked_registry(registry_path()) as registry:
            registry[run_id] = entry
    except Exception:
        workspace.remove(entry)
        raise
    if entry.get("copied") or entry.get("linked") or entry.get("skipped"):
        log("local_files", run=run_id, copied=len(entry.get("copied") or {}), linked=len(entry.get("linked") or []),
            skipped=len(entry.get("skipped") or []))
    return path, cwd, True, branch


def registry_path():
    return os.path.join(STATE_DIR, "worktrees.json")


def cleanup_worktrees():
    """Remove scheduled worktrees older than 3 days that hold nothing, or whose work is already
    merged into origin/HEAD. Any with uncommitted changes or unmerged commits are kept."""
    try:
        workspace.sweep(registry_path(), CLEANUP_AFTER, log)
    except Exception as e:  # never cost the tick its status
        log("cleanup_failed", error=type(e).__name__)


# --- Watchers -----------------------------------------------------------------------

def watcher_env():
    """The variables of <watchers>/env (KEY=value lines, optional export, quotes stripped)."""
    values = {}
    try:
        with open(os.path.join(WATCHERS, "env")) as f:
            for line in f:
                m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line.rstrip("\n"))
                if m:
                    raw = m.group(2).strip()
                    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "'\"":
                        raw = raw[1:-1]
                    values[m.group(1)] = raw
    except OSError:
        pass
    return values


def scrub(text, env):
    """An error message without any of the env file's values."""
    text = " ".join((text or "").split())
    for value in env.values():
        if len(value) >= 4:
            text = text.replace(value, "[redacted]")
    return text[:200]


def run_watcher(name, args, env):
    """(exit code, stdout, stderr) of <watchers>/<name> <args>. Raises RuntimeError when the
    watcher can't be run."""
    if not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9._-]*", name or ""):
        raise RuntimeError("bad watcher name")
    path = os.path.join(WATCHERS, name)
    if not os.path.isfile(path) or not os.access(path, os.X_OK):
        raise RuntimeError("watcher %s not found in %s" % (name, tilde(WATCHERS)))
    try:
        p = subprocess.run([path] + args, capture_output=True, text=True, timeout=WATCH_TIMEOUT,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, **env), cwd=WATCHERS)
    except subprocess.TimeoutExpired:
        raise RuntimeError("watcher timed out after %d s" % WATCH_TIMEOUT)
    except OSError as e:
        raise RuntimeError("watcher could not run: %s" % type(e).__name__)
    return p.returncode, p.stdout, p.stderr


def check_watch(hub, run, job):
    """Runs the check and reports it; raises RuntimeError for a failed check."""
    env = watcher_env()
    code, out, err = run_watcher(job["action"].get("watcher"), ["check"], env)
    if code != 0:
        raise RuntimeError(scrub("watcher exit %d: %s" % (code, err.strip()), env))
    try:
        report = json.loads(out)
    except ValueError:
        report = None
    if not isinstance(report, dict) or not isinstance(report.get("problems"), list):
        raise RuntimeError("watcher output is not JSON")
    hub.request("POST", "/api/runs/%s/report" % run["id"], body=report, timeout=60)
    return len(report["problems"])


WATCHERS_REPORT_EVERY = 86400
# A hub without the watchers route (404) is asked again after this: it may be updated soon.
WATCHERS_RETRY_UNSUPPORTED = 3600


def watchers_report():
    """The installed watchers: every <name>.json with an executable <name> beside it, and per
    setting whether the env file sets it. Never a value."""
    env = watcher_env()
    out = []
    try:
        names = sorted(os.listdir(WATCHERS))
    except OSError:
        return out
    for file in names:
        if not file.endswith(".json"):
            continue
        name = file[:-5]
        path = os.path.join(WATCHERS, name)
        if not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9._-]*", name) or not os.access(path, os.X_OK):
            continue
        manifest = load_json(os.path.join(WATCHERS, file))
        if not isinstance(manifest, dict):
            continue
        settings = []
        for s in manifest.get("settings") or []:
            if isinstance(s, dict) and s.get("key"):
                settings.append({"key": str(s["key"]), "label": str(s.get("label") or ""),
                                 "secret": bool(s.get("secret")), "set": bool(env.get(str(s["key"]))),
                                 "optional": bool(s.get("optional"))})
        out.append({"name": name, "title": str(manifest.get("title") or name),
                    "description": str(manifest.get("description") or ""), "settings": settings,
                    "resolve": bool(manifest.get("resolve")),
                    "resolve_label": manifest.get("resolve_label") if isinstance(manifest.get("resolve_label"), str) else None})
    return out


def report_watchers(hub, computer_id):
    """PUT the watchers report when it changed or a day passed. An old hub (404) is retried a
    day later, quietly."""
    path = os.path.join(STATE_DIR, "watchers.json")
    report = watchers_report()
    digest = json.dumps(report, sort_keys=True)
    state = load_json(path, {}) or {}
    if now() - float(state.get("unsupported_at") or 0) < WATCHERS_RETRY_UNSUPPORTED:
        return
    if state.get("digest") == digest and now() - float(state.get("at") or 0) < WATCHERS_REPORT_EVERY:
        return
    try:
        hub.request("PUT", "/api/computers/%s/watchers" % urllib.parse.quote(computer_id, safe=""), body=report)
        state = {"digest": digest, "at": now()}
    except HubError as e:
        if e.status != 404:
            log("watchers_report_failed", error=e)
            return
        log("watchers_report_unsupported")
        state = {"unsupported_at": now()}
    try:
        save_json(path, state)
    except OSError as e:
        log("watchers_state_failed", error=type(e).__name__)


def job_templates_report():
    """The installed job plugins: <jobs>/<name>/job.json with a prompt.md beside it."""
    out = []
    try:
        names = sorted(os.listdir(JOBS))
    except OSError:
        return out
    for name in names:
        manifest = load_json(os.path.join(JOBS, name, "job.json"))
        try:
            with open(os.path.join(JOBS, name, "prompt.md")) as f:
                prompt = f.read()
        except OSError:
            continue
        if not isinstance(manifest, dict) or not manifest.get("cron"):
            continue
        out.append({"name": str(manifest.get("name") or name), "title": str(manifest.get("title") or name),
                    "description": str(manifest.get("description") or ""), "cron": str(manifest["cron"]),
                    "tool": str(manifest.get("tool") or "claude"),
                    "model": manifest.get("model") if isinstance(manifest.get("model"), str) else None,
                    "priority": str(manifest.get("priority") or "background"), "limit": str(manifest.get("limit") or "wait"),
                    "project": str(manifest.get("project") or "choose"), "prompt": prompt[:20000]})
    return out


def report_job_templates(hub, computer_id):
    """PUT the job plugins when they changed or a day passed; an old hub (404) hourly."""
    path = os.path.join(STATE_DIR, "job-templates.json")
    report = job_templates_report()
    digest = json.dumps(report, sort_keys=True)
    state = load_json(path, {}) or {}
    if now() - float(state.get("unsupported_at") or 0) < WATCHERS_RETRY_UNSUPPORTED:
        return
    if state.get("digest") == digest and now() - float(state.get("at") or 0) < WATCHERS_REPORT_EVERY:
        return
    try:
        hub.request("PUT", "/api/computers/%s/job-templates" % urllib.parse.quote(computer_id, safe=""), body=report)
        state = {"digest": digest, "at": now()}
    except HubError as e:
        if e.status != 404:
            log("job_templates_report_failed", error=e)
            return
        state = {"unsupported_at": now()}
    try:
        save_json(path, state)
    except OSError as e:
        log("job_templates_state_failed", error=type(e).__name__)


def maybe_start_updates():
    """Daily updates: start `ai-todo-updates run` in the background at most every 5 minutes.
    It takes its own lock and may call a model for minutes; the tick never waits for it."""
    if not os.access(UPDATES_BIN, os.X_OK):
        return
    path = os.path.join(STATE_DIR, "updates-start.json")
    state = load_json(path, {}) or {}
    if now() - float(state.get("at") or 0) < UPDATES_EVERY:
        return
    try:
        subprocess.Popen([UPDATES_BIN, "run"], start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
        save_json(path, {"at": now()})
    except OSError as e:
        log("updates_start_failed", error=type(e).__name__)


def do_resolves(hub, resolves):
    env = None
    for item in resolves or []:
        if not isinstance(item, dict) or not item.get("issue_id"):
            continue
        env = env if env is not None else watcher_env()
        try:
            code, out, err = run_watcher(item.get("watcher"), ["resolve", item.get("key") or ""], env)
            ok, message = code == 0, (out if code == 0 else err or out or "exit %d" % code)
        except RuntimeError as e:
            ok, message = False, str(e)
        try:
            hub.request("POST", "/api/watch/issues/%s/resolve-result" % item["issue_id"],
                        body={"ok": ok, "message": scrub(message, env)})
            log("resolved" if ok else "resolve_failed", issue=item["issue_id"])
        except HubError as e:
            log("resolve_report_failed", issue=item["issue_id"], error=e)


# --- Tick ---------------------------------------------------------------------------

def start_run(hub, computer_id, due, folders):
    run, job = due["run"], due["job"]
    action = job["action"]
    project_folder = expand(folders.get(action.get("project_id")))
    folder = expand(action.get("folder")) if action.get("folder") else project_folder
    if not project_folder or not folder or not os.path.isdir(folder):
        raise RuntimeError("project folder not found on this computer")
    # The hub only names folders inside a project this computer knows: a job can't point a
    # conversation at an arbitrary place.
    if folder != project_folder and not folder.startswith(project_folder.rstrip("/") + "/"):
        raise RuntimeError("folder is outside the project")
    root, path, is_git, branch = make_worktree(folder, action["project_id"], run["id"], job.get("name") or "job")
    # A debugging run reports its issues with ai-todo-watch, which only works in a worktree.
    if (run.get("note") or "").startswith("watch:") and not is_git:
        raise RuntimeError("a debugging run needs a git repo; %s is not one (map the issue to a repo folder)" % tilde(folder))
    try:
        body = {"cwd": tilde(path), "is_git": is_git}
        if branch:
            body["branch"] = branch
        if action.get("tool") == "auto":
            body["tool"] = choose_tool()
        started = hub.request("POST", "/api/runs/%s/start" % run["id"], body=body)
        ensure_state()
        fd, prompt_file = tempfile.mkstemp(dir=STATE_DIR, prefix="prompt.")
        with os.fdopen(fd, "w") as f:
            f.write(started.get("prompt") or "")
        if not isinstance(started, dict) or not started.get("tmux_name"):
            raise RuntimeError("the hub's start answer is empty")
        sid = started.get("session_id") or "-"
        # Auto-approve only inside a scheduled git worktree, never in a folder used in place.
        model = started.get("model") if isinstance(started.get("model"), str) else None
        argv = [OPEN_BIN, "--detached"] + (["--auto-approve"] if is_git else []) + (
            ["--model", model] if model and re.fullmatch(r"[A-Za-z0-9._-]+", model) else []) + [
            "--prompt-file", prompt_file, started["tmux_name"], tilde(path), sid,
            started.get("tool") or body.get("tool") or action.get("tool") or "claude"]
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=OPEN_TIMEOUT, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            # The conversation may be running in the worktree already: keep it.
            raise RuntimeError("ai-todo-open timed out; the worktree is kept")
        finally:
            if os.path.exists(prompt_file):
                os.remove(prompt_file)
        if p.returncode != 0:
            raise RuntimeError("ai-todo-open exit %d: %s" % (p.returncode, (p.stderr or "").strip()[:200]))
        # A new Codex (or Cursor) conversation gets its id only once it starts; ai-todo-open
        # prints "created <id>". The hub needs it to match the conversation's status.
        words = (p.stdout or "").strip().split()
        if sid == "-" and len(words) == 2 and words[0] == "created" and started.get("todo_id"):
            try:
                hub.request("PUT", "/api/todos/%s/conversation/session" % started["todo_id"],
                            body={"session_id": words[1]})
            except HubError as e:
                log("session_report_failed", run=run["id"], error=e)
    except Exception as e:
        if is_git and "timed out" not in str(e):
            workspace.remove({"folder": folder, "path": root, "branch": branch})
        raise
    return "started %s in %s" % (started.get("tool") or action.get("tool"), tilde(path))


def cmd_tick(args):
    if args:
        print("usage: ai-todo-runner tick", file=sys.stderr)
        sys.exit(64)
    conf = Config()
    computer_id = conf.get("TODO_COMPUTER_ID")
    if not conf.get("TODO_HUB_URL") or not computer_id:
        print("ai-todo-runner: TODO_HUB_URL and TODO_COMPUTER_ID are needed in %s" % conf.path, file=sys.stderr)
        sys.exit(65)
    hub = Hub(conf)
    status_path = os.path.join(STATE_DIR, "status.json")
    status = load_json(status_path, {}) or {}
    status["last_tick"] = now()
    started = 0
    no_reading_started = {}
    due = None
    try:
        due = hub.request("GET", "/api/runner/due", query={"computer_id": computer_id}) or {}
        settings = due.get("settings") or {}
        runs = due.get("runs") or []
        folders = project_folders(hub) if any(r["job"]["action"].get("kind") != "watch" for r in runs) else {}
        for item in runs:
            if started >= MAX_STARTS:
                break
            rid = item["run"]["id"]
            if item["job"]["action"].get("kind") == "watch":
                try:
                    hub.request("POST", "/api/runs/%s/claim" % rid, body={"computer_id": computer_id})
                except HubError as e:
                    if e.status == 409:
                        log("claim_lost", run=rid)
                        continue
                    raise
                try:
                    count = check_watch(hub, item["run"], item["job"])
                    log("checked", run=rid, problems=count)
                except Exception as e:  # every claimed check gets a report or a finish
                    message = str(e) or type(e).__name__
                    status["last_error"], status["last_error_at"] = message, now()
                    log("check_failed", run=rid, error=message)
                    try:
                        hub.request("POST", "/api/runs/%s/finish" % rid, body={"state": "failed", "result": message})
                    except HubError:
                        pass
                continue
            tool = item["job"]["action"].get("tool") or "claude"
            reason, no_reading = wait_reason(item, settings, no_reading_started)
            if reason:
                hub.request("POST", "/api/runs/%s/wait" % rid, body={"reason": reason})
                log("wait", run=rid)
                continue
            try:
                claim = {"computer_id": computer_id}
                if no_reading:
                    claim["no_reading"] = True
                hub.request("POST", "/api/runs/%s/claim" % rid, body=claim)
            except HubError as e:
                if e.status == 409:
                    log("claim_lost", run=rid)
                    continue
                raise
            try:
                result = start_run(hub, computer_id, item, folders)
                hub.request("POST", "/api/runs/%s/finish" % rid, body={"state": "done", "result": result})
                started += 1
                if no_reading:
                    no_reading_started[tool] = no_reading_started.get(tool, 0) + 1
                status.setdefault("started", []).append(now())
                log("started", run=rid, tool=item["job"]["action"].get("tool"))
            except Exception as e:  # every claimed run gets a finish, whatever went wrong
                message = str(e) or type(e).__name__
                status["last_error"], status["last_error_at"] = message, now()
                log("failed", run=rid, error=message)
                try:
                    hub.request("POST", "/api/runs/%s/finish" % rid, body={"state": "failed", "result": message})
                except HubError:
                    pass
    except HubError as e:
        status["last_error"], status["last_error_at"] = str(e), now()
        log("error", error=e)
    # Each catches its own hub errors: one failed run above doesn't skip them.
    if due is not None:
        do_resolves(hub, due.get("resolves"))
        report_watchers(hub, computer_id)
        report_job_templates(hub, computer_id)
        maybe_start_updates()
    cleanup_worktrees()
    status["started"] = [t for t in status.get("started", []) if t > now() - 86400]
    save_json(status_path, status)


def cmd_status(args):
    status = load_json(os.path.join(STATE_DIR, "status.json"), {}) or {}
    out = {"last_tick": iso(status["last_tick"]) if status.get("last_tick") else None,
           "last_error": status.get("last_error"),
           "last_error_at": iso(status["last_error_at"]) if status.get("last_error") and status.get("last_error_at") else None,
           "started_24h": len([t for t in status.get("started", []) if t > now() - 86400])}
    if "--json" in args:
        print(json.dumps(out))
    else:
        for key, value in out.items():
            print("%-15s %s" % (key + ":", value if value is not None else "-"))


def main(argv):
    commands = {"tick": cmd_tick, "status": cmd_status}
    if not argv or argv[0] not in commands:
        print("usage: ai-todo-runner tick | status [--json]", file=sys.stderr)
        sys.exit(64)
    commands[argv[0]](argv[1:])


main(sys.argv[1:])
