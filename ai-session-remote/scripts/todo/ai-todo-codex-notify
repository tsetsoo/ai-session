#!/bin/sh
# Codex `notify` program: report a todo conversation's status to todo-server.
#
# Codex runs the configured notify command with its own arguments followed by one JSON
# argument, for example (confirmed with codex-cli 0.163.0, TUI and exec):
#   {"type":"agent-turn-complete","thread-id":"<id>","turn-id":"<id>","cwd":"/path",
#    "client":"codex-tui","input-messages":["..."],"last-assistant-message":"..."}
# thread-id is the conversation id: the <id> in sessions/**/rollout-*-<id>.jsonl, the same
# id ai-todo-sessions lists and `codex resume <id>` takes.
#
# Installed into ~/.codex/config.toml by install.sh:
#   notify = ["~/.ai-remote/bin/ai-todo-codex-notify"]
# or, when another notify program was already configured (install.sh --chain-codex-notify):
#   notify = ["~/.ai-remote/bin/ai-todo-codex-notify", "--chain", "<program>", "<args>"...]
# With --chain the original program still runs (in the background) with its own arguments
# plus the JSON, exactly as Codex would have called it.
#
# agent-turn-complete -> idle; approval-requested -> waiting (if Codex sends it).
# Like ai-todo-hook, every post carries "attended" (recent keyboard activity in the tmux
# session), and waiting is re-checked ~12s later to report an answer typed at the terminal.
#
# Never blocks or fails Codex: always exits 0, and the HTTP call runs in the background with
# a 3s limit. Every thread is reported, matched by id; todo-server answers 404 for ids that
# aren't a todo's. Codex 0.163+ runs turns in an app-server, not in the TUI: the TUI's own
# daemon (whose tmux environment is that of whichever TUI started it) or the desktop app's
# (no tmux at all). So the tmux session, used only for "attended", is the ai/codex/todo-*
# session whose pane runs `codex resume <thread-id>`, else the one this runs in.
#
# Config: ~/.ai-remote/todo-hub.conf (shell syntax), as for ai-todo-hook.
# Test hooks (not for normal use):
#   AI_TODO_HUB_CONF      config file path
#   AI_TODO_TMUX_SESSION  tmux session name instead of asking tmux
#   AI_TODO_HOOK_SYNC     =1: wait for the HTTP call (and the chained program, and the re-check)
#   AI_TODO_TMUX_SOCKET   tmux -L socket to ask about clients
#   AI_TODO_CLIENT_ACTIVITY_FILE  file with client activity epochs instead of asking tmux
#   AI_TODO_RECHECK_DELAY seconds before the waiting re-check (default 12)

json=""
for arg in "$@"; do json=$arg; done

if [ "${1:-}" = "--chain" ]; then
  shift
  # What's left is "<program> <args>... <json>": the original notify invocation.
  if [ $# -ge 2 ]; then
    if [ "${AI_TODO_HOOK_SYNC:-}" = 1 ]; then
      "$@" </dev/null >/dev/null 2>&1
    else
      ("$@" </dev/null >/dev/null 2>&1 &)
    fi
  fi
fi

[ -n "$json" ] || exit 0

export PATH="/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"

conf=${AI_TODO_HUB_CONF:-$HOME/.ai-remote/todo-hub.conf}
[ -r "$conf" ] || exit 0
TODO_HUB_URL=
TODO_API_TOKEN=
# shellcheck source=/dev/null
. "$conf" 2>/dev/null || exit 0
[ -n "$TODO_HUB_URL" ] || exit 0

prompt_time=$(date +%s)

# Newest keyboard activity (epoch seconds) of any tmux client attached to the session.
latest_activity() {
  if [ -n "${AI_TODO_CLIENT_ACTIVITY_FILE:-}" ]; then
    cat "$AI_TODO_CLIENT_ACTIVITY_FILE" 2>/dev/null
  else
    tmux ${AI_TODO_TMUX_SOCKET:+-L "$AI_TODO_TMUX_SOCKET"} list-clients -t "=$session" -F '#{client_activity}' 2>/dev/null
  fi | sort -n | tail -n 1
}

# The ai/codex/todo-* tmux session showing this thread, or nothing.
todo_session() {
  case "${AI_TODO_TMUX_SESSION:-}" in
    '') ;;
    ai/codex/todo-*) printf '%s\n' "$AI_TODO_TMUX_SESSION"; return ;;
    *) return ;;
  esac
  # A pane's process is codex itself: ai-todo-open starts it through `env`, which execs.
  panes=$(tmux ${AI_TODO_TMUX_SOCKET:+-L "$AI_TODO_TMUX_SOCKET"} list-panes -a -F '#{pane_pid} #{session_name}' 2>/dev/null \
    | awk '$2 ~ /^ai\/codex\/todo-/')
  if [ -n "$panes" ]; then
    pids=$(printf '%s\n' "$panes" | awk '{print $1}' | paste -sd, -)
    found=$(ps -o pid= -o args= -p "$pids" 2>/dev/null | while read -r pid args; do
      case " $args " in
        (*" $sid "*)
          printf '%s\n' "$panes" | awk -v p="$pid" '$1 == p {print $2; exit}'
          break
          ;;
      esac
    done)
    if [ -n "$found" ]; then
      printf '%s\n' "$found"
      return
    fi
  fi
  # A new thread started as plain `codex` has no id on its command line.
  if [ -n "${TMUX:-}" ]; then
    current=$(tmux display-message -p '#S' 2>/dev/null)
    case "$current" in
      ai/codex/todo-*) printf '%s\n' "$current" ;;
    esac
  fi
}

command -v python3 >/dev/null 2>&1 || exit 0
body=$(python3 -c '
import json, sys
try:
    data = json.loads(sys.argv[1])
except Exception:
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
status = {"agent-turn-complete": "idle", "approval-requested": "waiting"}.get(data.get("type"))
sid = data.get("thread-id")
if status is None or not isinstance(sid, str) or not sid or not all(c.isalnum() or c == "-" for c in sid):
    sys.exit(1)
print(sid)
print(status)
print(json.dumps({"session_id": sid, "tool": "codex", "status": status, "attended": False}))
' "$json" 2>/dev/null) || exit 0
sid=$(printf '%s\n' "$body" | sed -n 1p)
status=$(printf '%s\n' "$body" | sed -n 2p)
body=$(printf '%s\n' "$body" | sed -n 3p)

attended=false
session=$(todo_session)
if [ -n "$session" ]; then
  latest=$(latest_activity)
  case "$latest" in
    '' | *[!0-9]*) ;;
    *) [ "$latest" -ge $((prompt_time - 60)) ] && attended=true ;;
  esac
fi
[ "$attended" = true ] && body=$(printf '%s' "$body" | sed 's/"attended": *false/"attended": true/')

# The last status sent per thread, so a delayed re-check can tell the turn moved on.
state_dir="$HOME/.ai-remote/hook-state"
state_file="$state_dir/codex-$sid"
state=$status
[ "$status" = waiting ] && state="waiting $prompt_time.$$"
mkdir -p "$state_dir" 2>/dev/null && printf '%s\n' "$state" >"$state_file" 2>/dev/null

post() {
  # The token goes through curl's config on stdin so it never shows up in `ps`.
  {
    if [ -n "$TODO_API_TOKEN" ]; then
      printf 'header = "Authorization: Bearer %s"\n' "$TODO_API_TOKEN"
    fi
  } | curl -s -o /dev/null --connect-timeout 2 --max-time 3 -K - \
    -H 'Content-Type: application/json' --data-binary "$body" \
    "${TODO_HUB_URL%/}/api/conversations/status"
}

# waiting only: a keystroke after the prompt means it was answered at the terminal.
recheck() {
  [ "$status" = waiting ] && [ "$attended" = false ] && [ -n "$session" ] || return 0
  sleep "${AI_TODO_RECHECK_DELAY:-12}"
  # Moved on (the turn completed, or another prompt is waiting now).
  [ "$(cat "$state_file" 2>/dev/null)" = "$state" ] || return 0
  latest=$(latest_activity)
  case "$latest" in
    '' | *[!0-9]*) return 0 ;;
  esac
  [ "$latest" -gt "$prompt_time" ] || return 0
  body=$(printf '%s' "$body" | sed 's/"attended": *false/"attended": true/')
  post
}

if [ "${AI_TODO_HOOK_SYNC:-}" = 1 ]; then
  { post; recheck; } >/dev/null 2>&1
else
  { post; recheck; } </dev/null >/dev/null 2>&1 &
fi
exit 0
