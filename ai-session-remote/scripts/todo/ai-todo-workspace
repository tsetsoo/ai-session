#!/usr/bin/env python3
"""Conversation worktrees on this computer (see ai_todo_workspace.py).

Usage:
  ai-todo-workspace list [--json]   each registered worktree: path, branch, state
                                    (clean | dirty | in use | ahead N | missing), local files,
                                    its pull/merge request when the runner found one
  ai-todo-workspace sync <path>     re-copy .worktreeinclude files whose source changed while
                                    the worktree's copy was untouched; names ones that differ
  ai-todo-workspace ensure <path> <project folder> <branch>
                                    a conversation's own worktree: made at <path> from the
                                    folder's repo (origin/HEAD, else HEAD) on <branch> when
                                    missing, else its local files synced. Progress on stderr.

Exit codes: 0 ok, 64 bad arguments, 65 <path> is not a registered worktree, 66 the project
folder is not in a git repository, 1 git could not make the worktree, 3 sync left files that
differ from the project folder (ensure: only reported, exit 0).
Test hook: AI_TODO_RUNNER_STATE_DIR (where worktrees.json lives)."""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ai_todo_workspace as workspace  # noqa: E402

HOME = os.path.expanduser("~")
STATE_DIR = os.environ.get("AI_TODO_RUNNER_STATE_DIR") or os.path.join(HOME, ".ai-remote", "runner-state")
REGISTRY = os.path.join(STATE_DIR, "worktrees.json")


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def cmd_list(args):
    rows, panes = [], workspace.tmux_paths()
    for key, entry in sorted(workspace.load_registry(REGISTRY).items(), key=lambda kv: kv[1].get("created") or 0):
        kind, ahead = workspace.state(entry, panes)
        rows.append({"id": key, "path": tilde(entry.get("path") or ""), "branch": entry.get("branch"),
                     "state": kind, "ahead": ahead, "copied": sorted(entry.get("copied") or {}),
                     "linked": entry.get("linked") or [], "pr": entry.get("pr")})
    if "--json" in args:
        print(json.dumps(rows))
        return 0
    for r in rows:
        label = "ahead %d" % r["ahead"] if r["state"] == "ahead" and r["ahead"] else r["state"]
        pr = r["pr"] or {}
        print("%-9s %s  %s%s" % (label, r["path"], r["branch"] or "-",
                                 "  %s (%s)" % (pr["url"], pr.get("state")) if pr.get("url") else ""))
    return 0


def cmd_sync(args):
    if len(args) != 1:
        return usage()
    target = os.path.realpath(os.path.expanduser(args[0]))
    updated = differs = None
    with workspace.locked_registry(REGISTRY) as registry:
        for entry in registry.values():
            root = os.path.realpath(entry.get("path") or "")
            if target == root or target.startswith(root + "/"):
                updated, differs = workspace.sync(entry)
                break
    if updated is None:
        print("ai-todo-workspace: %s is not a registered worktree" % tilde(target), file=sys.stderr)
        return 65
    for rel in updated:
        print("updated %s" % rel)
    for rel in differs:
        print("differs %s (edited here and in the project folder; kept this copy)" % rel)
    return 3 if differs else 0


def expand(path):
    return os.path.abspath(os.path.expanduser(path))


def cmd_ensure(args):
    if len(args) != 3 or not all(a.strip() for a in args):
        return usage()
    path, folder, branch = expand(args[0]), expand(args[1]), args[2]
    if git_check_branch(branch) != 0:
        print("ai-todo-workspace: invalid branch name: %s" % branch, file=sys.stderr)
        return 64
    say = lambda msg: print(msg, file=sys.stderr, flush=True)  # noqa: E731
    try:
        made, updated, differs = workspace.ensure(REGISTRY, path, folder, branch, say)
    except workspace.NotARepo:
        say("ai-todo-workspace: %s is not in a git repository" % tilde(folder))
        return 66
    except RuntimeError as e:
        say("ai-todo-workspace: %s" % e)
        return 1
    if made:
        say("Worktree ready: %s" % tilde(path))
    for rel in updated:
        say("updated %s from the project folder" % rel)
    for rel in differs:
        say("%s differs from the project folder (edited in both; kept this copy)" % rel)
    return 0


def git_check_branch(branch):
    return subprocess.run(["git", "check-ref-format", "--branch", branch], capture_output=True).returncode


def usage():
    print("usage: ai-todo-workspace list [--json] | sync <path> | ensure <path> <folder> <branch>", file=sys.stderr)
    return 64


def main(argv):
    commands = {"list": cmd_list, "sync": cmd_sync, "ensure": cmd_ensure}
    if not argv or argv[0] not in commands:
        return usage()
    return commands[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
