#!/usr/bin/env python3
"""Conversation worktrees on this computer (see ai_todo_workspace.py).

Usage:
  ai-todo-workspace list [--json]   each registered worktree: path, branch, state
                                    (clean | dirty | ahead N | missing), local files
  ai-todo-workspace sync <path>     re-copy .worktreeinclude files whose source changed while
                                    the worktree's copy was untouched; names ones that differ

Exit codes: 0 ok, 64 bad arguments, 65 <path> is not a registered worktree, 3 sync left
files that differ from the project folder.
Test hook: AI_TODO_RUNNER_STATE_DIR (where worktrees.json lives)."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ai_todo_workspace as workspace  # noqa: E402

HOME = os.path.expanduser("~")
STATE_DIR = os.environ.get("AI_TODO_RUNNER_STATE_DIR") or os.path.join(HOME, ".ai-remote", "runner-state")
REGISTRY = os.path.join(STATE_DIR, "worktrees.json")


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def cmd_list(args):
    rows = []
    for key, entry in sorted(workspace.load_registry(REGISTRY).items(), key=lambda kv: kv[1].get("created") or 0):
        kind, ahead = workspace.state(entry)
        rows.append({"id": key, "path": tilde(entry.get("path") or ""), "branch": entry.get("branch"),
                     "state": kind, "ahead": ahead, "copied": sorted(entry.get("copied") or {}),
                     "linked": entry.get("linked") or []})
    if "--json" in args:
        print(json.dumps(rows))
        return 0
    for r in rows:
        label = "ahead %d" % r["ahead"] if r["state"] == "ahead" and r["ahead"] else r["state"]
        print("%-9s %s  %s" % (label, r["path"], r["branch"] or "-"))
    return 0


def cmd_sync(args):
    if len(args) != 1:
        return usage()
    target = os.path.realpath(os.path.expanduser(args[0]))
    registry = workspace.load_registry(REGISTRY)
    for key, entry in registry.items():
        root = os.path.realpath(entry.get("path") or "")
        if target == root or target.startswith(root + "/"):
            updated, differs = workspace.sync(entry)
            if updated:
                workspace.save_registry(REGISTRY, registry)
            for rel in updated:
                print("updated %s" % rel)
            for rel in differs:
                print("differs %s (edited here and in the project folder; kept this copy)" % rel)
            return 3 if differs else 0
    print("ai-todo-workspace: %s is not a registered worktree" % tilde(target), file=sys.stderr)
    return 65


def usage():
    print("usage: ai-todo-workspace list [--json] | sync <path>", file=sys.stderr)
    return 64


def main(argv):
    commands = {"list": cmd_list, "sync": cmd_sync}
    if not argv or argv[0] not in commands:
        return usage()
    return commands[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
