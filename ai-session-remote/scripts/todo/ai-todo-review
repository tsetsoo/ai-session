#!/usr/bin/env python3
"""A conversation's changes for the review view, and review feedback typed into its tmux pane.

Usage:
  ai-todo-review status <cwd> [--ref <branch>]
  ai-todo-review diff <cwd> [--scope uncommitted|branch|since] [--from <sha>] [--to <sha>]
                            [--unified N] [--max-bytes N] [--ref <branch>]
  ai-todo-review keep <cwd> <sha>
  ai-todo-review log <cwd> [--limit N] [--before <ISO time>] [--ref <branch>]
  ai-todo-review send [--base64] <tmux_name>   (the message on stdin)
  ai-todo-review run <cwd> --from <sha> --to <sha> --tool claude|codex --id <id> [--ref <branch>]
                         [--model M] [--context <path>]... [--brief-base64]   (the brief on stdin)
  ai-todo-review result <id>
  ai-todo-review cancel <id>

Every command but send prints JSON.

A revision is a commit sha. With nothing uncommitted it is HEAD. Otherwise it is a snapshot
commit on top of HEAD, made from a temporary index (`git add -A`), so untracked files are in
it and neither the real index, the working tree nor the stash stack is touched. The snapshot
has a fixed author, committer, date and message, so the same worktree gives the same sha.

status  root, branch, head, upstream with ahead/behind, the branch's base (merge-base with
        origin's default branch) and the current revision. worktree_base: when the repository
        is a worktree the runner or app made (runner-state/worktrees.json), the commit it was
        made from (its merge-base with HEAD, so a branch kept from an earlier worktree counts
        from where it began); else null.
--ref   reviews that branch of the repository instead of its working tree: HEAD is the
        branch's tip, the revision is that commit and nothing is uncommitted. For a
        conversation whose worktree is gone but whose branch is kept in the project folder.
diff    a unified diff of the repository (paths from its root) from --from to --to (default:
        the current revision). --scope picks --from: uncommitted = HEAD (default), branch = the
        base, since = --from as given. --unified 0 is for moving comments between revisions.
keep    refs/ai-review/<sha> -> sha, so a revision feedback was sent against survives gc.
log     HEAD's recent commits (first parent): sha, subject, committer date, and whether the
        upstream has it (null without an upstream). --before: also the last commit made before
        that time ("before"), the start of a conversation that began then; null when none was.
send    pastes stdin into the tmux session `<tmux_name>` as a bracketed paste, then Return.
        --base64: stdin is base64 (the app sends it so; decoding here needs no base64 flags).
        Paste end markers (ESC[201~) in the message are dropped, so it can't end the paste
        early. Refused (exit 75) while the program there hasn't turned bracketed paste on:
        line by line, every newline would submit.

run     starts a reviewer agent on the changes --from..--to, detached, and prints {"id", "state"}
        at once. claude runs as `claude -p` with only Read, Grep and Glob; codex as `codex exec`
        in its read-only sandbox. It reads the files as of --to, exported into the run's folder
        (the working tree may change while it reads). Context goes in
        as paths it may read: the brief (the todo's title and notes, base64 on stdin with
        --brief-base64), AGENTS.md / CLAUDE.md (the root's and those above changed files),
        docs/adr and spec folders, and every --context path. The run's files are in
        ~/.ai-remote/review-runs/<id> (AI_TODO_REVIEW_RUNS_DIR); runs older than 7 days go.
result  {"id", "state": running|done|failed|cancelled, "error", "result"}. A done run's result:
        tool, model, from, to, summary, usage (tokens and cost when the tool reports them, else
        null) and findings: path, side (new|old), line_start, line_end (null for the whole
        file), severity (high|medium|low), category, title, body, quote (the lines, from git,
        not the model) and fingerprint (path + title + nearby code, not line numbers, so the
        same finding on moved lines matches).
cancel  stops a running reviewer (its whole process group). Prints what `result` does: a run
        that finished first stays done, with its findings.

Exit codes: 64 bad arguments, 65 unknown revision or empty message, 66 no such tmux
session, 69 not a git repository (or cwd missing), 70 git failed (its message on stderr),
75 the pane isn't ready for a paste, 90 git, tmux, claude or codex missing.
"""
import base64
import binascii
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

SNAPSHOT_IDENT = {
    "GIT_AUTHOR_NAME": "ai-review", "GIT_AUTHOR_EMAIL": "ai-review@localhost",
    "GIT_COMMITTER_NAME": "ai-review", "GIT_COMMITTER_EMAIL": "ai-review@localhost",
    "GIT_AUTHOR_DATE": "@0 +0000", "GIT_COMMITTER_DATE": "@0 +0000",
}
SNAPSHOT_MESSAGE = "ai-review snapshot\n"
KEEP_PREFIX = "refs/ai-review/"
DEFAULT_MAX_BYTES = 4 * 1024 * 1024
# The user's git config must not change what is parsed: no colour, prefixes, external diffs.
DIFF_CONFIG = ["-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false",
               "-c", "diff.external=", "-c", "color.ui=never", "-c", "core.quotePath=false"]


def die(message, code):
    sys.stderr.write("ai-todo-review: %s\n" % message)
    sys.exit(code)


def die_missing(program):
    """Exit 90 with a bare `<program> not found`, the line the app reads the name from."""
    sys.stderr.write("%s not found\n" % program)
    sys.exit(90)


def git(cwd, *args, env=None, check=True, text=True):
    full_env = dict(os.environ)
    full_env.pop("GIT_DIR", None)
    full_env.pop("GIT_WORK_TREE", None)
    full_env.pop("GIT_INDEX_FILE", None)
    full_env["GIT_OPTIONAL_LOCKS"] = "0"
    if env:
        full_env.update(env)
    try:
        result = subprocess.run(["git", "-C", cwd] + list(args), stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=full_env)
    except FileNotFoundError:
        die_missing("git")
    if check and result.returncode != 0:
        raise GitError(result.stderr.decode("utf-8", "replace").strip())
    out = result.stdout
    return (out.decode("utf-8", "replace") if text else out), result.returncode


class GitError(Exception):
    pass


def line(cwd, *args):
    """First line of output, or None when the command fails."""
    try:
        out, _ = git(cwd, *args)
    except GitError:
        return None
    out = out.strip()
    return out.splitlines()[0] if out else None


def repo_root(cwd):
    path = os.path.expanduser(cwd)
    if not os.path.isdir(path):
        die("no folder %s" % cwd, 69)
    root = line(path, "rev-parse", "--show-toplevel")
    if not root:
        die("%s is not in a git repository" % cwd, 69)
    return root


def head_sha(root):
    return line(root, "rev-parse", "--verify", "-q", "HEAD^{commit}")


def snapshot(root):
    """(revision sha, clean). Built in a temporary index. The snapshot index of the last call
    (this worktree's `ai-review-index`, else the real index) seeds it, so files whose stat data
    didn't change, untracked ones included, aren't hashed again. Calls at the same time each
    work on their own copy; the last one to finish leaves its index for the next."""
    head = head_sha(root)
    index = line(root, "rev-parse", "--path-format=absolute", "--git-path", "index")
    kept = line(root, "rev-parse", "--path-format=absolute", "--git-path", "ai-review-index")
    tmpdir = tempfile.mkdtemp(prefix="ai-review-", dir=os.path.dirname(kept) if kept else None)
    try:
        tmp_index = os.path.join(tmpdir, "index")
        seed = kept if kept and os.path.exists(kept) else index
        if seed and os.path.exists(seed):
            # copy2 keeps the mtime: git re-checks entries as new as the index (racy-git)
            shutil.copy2(seed, tmp_index)
        env = {"GIT_INDEX_FILE": tmp_index}
        git(root, "add", "-A", "--", ".", env=env)
        tree, _ = git(root, "write-tree", env=env)
        tree = tree.strip()
        if kept:
            try:
                os.replace(tmp_index, kept)
            except OSError:
                pass
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    if head and line(root, "rev-parse", head + "^{tree}") == tree:
        return head, True
    args = ["commit-tree", tree, "-m", SNAPSHOT_MESSAGE.strip()]
    if head:
        args[2:2] = ["-p", head]
    env = dict(SNAPSHOT_IDENT)
    sha, _ = git(root, *args, env=env)
    return sha.strip(), False


def default_branch_ref(root):
    ref = line(root, "symbolic-ref", "-q", "refs/remotes/origin/HEAD")
    candidates = ([ref] if ref else []) + ["refs/remotes/origin/main", "refs/remotes/origin/master",
                                           "refs/heads/main", "refs/heads/master"]
    for candidate in candidates:
        if line(root, "rev-parse", "--verify", "-q", candidate):
            return candidate
    return None


def short_ref(ref):
    for prefix in ("refs/remotes/", "refs/heads/"):
        if ref.startswith(prefix):
            return ref[len(prefix):]
    return ref


def base_of(root, head):
    ref = default_branch_ref(root)
    if not ref or not head:
        return None
    sha = line(root, "merge-base", head, ref)
    return {"ref": short_ref(ref), "sha": sha} if sha else None


def registry_file():
    state = os.environ.get("AI_TODO_RUNNER_STATE_DIR") or os.path.join(os.path.expanduser("~"), ".ai-remote", "runner-state")
    return os.path.join(state, "worktrees.json")


def worktree_base(root, head):
    """The commit this worktree was made from, when the runner or app made it; else None."""
    try:
        with open(registry_file()) as handle:
            registry = json.load(handle)
    except (OSError, ValueError):
        return None
    entries = registry.values() if isinstance(registry, dict) else registry if isinstance(registry, list) else []
    real = os.path.realpath(root)
    for entry in entries:
        if not isinstance(entry, dict) or not entry.get("base") or not entry.get("path"):
            continue
        if os.path.realpath(entry["path"]) != real:
            continue
        base = line(root, "rev-parse", "--verify", "-q", entry["base"] + "^{commit}")
        if not base:
            return None
        return (line(root, "merge-base", base, head) if head else None) or base
    return None


def ref_sha(root, ref):
    """The tip of branch `ref`, or exit 65 when the repository has no such branch."""
    sha = line(root, "rev-parse", "--verify", "-q", "refs/heads/%s^{commit}" % ref)
    if not sha:
        die("no branch %s" % ref, 65)
    return sha


def take_ref(args):
    """(args without `--ref X`, X or None)."""
    rest = list(args)
    if "--ref" not in rest:
        return rest, None
    at = rest.index("--ref")
    if at + 1 >= len(rest) or not rest[at + 1] or rest[at + 1].startswith("-"):
        die("--ref needs a branch", 64)
    ref = rest[at + 1]
    del rest[at:at + 2]
    return rest, ref


def cmd_status(args):
    args, ref = take_ref(args)
    if len(args) != 1:
        die("usage: ai-todo-review status <cwd> [--ref <branch>]", 64)
    root = repo_root(args[0])
    if ref:
        head = ref_sha(root, ref)
        branch = ref
        upstream = line(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "refs/heads/%s@{upstream}" % ref)
    else:
        head = head_sha(root)
        branch = line(root, "symbolic-ref", "-q", "--short", "HEAD")
        upstream = line(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    ahead = behind = None
    if upstream and head:
        counts = line(root, "rev-list", "--left-right", "--count", "%s...%s" % (head, upstream))
        if counts and len(counts.split()) == 2:
            ahead, behind = (int(n) for n in counts.split())
    revision, clean = (head, True) if ref else snapshot(root)
    print(json.dumps({
        "root": root,
        "branch": branch,
        "head": head,
        "upstream": upstream,
        "ahead": ahead,
        "behind": behind,
        "base": base_of(root, head),
        "revision": revision,
        "clean": clean,
        "worktree_base": None if ref else worktree_base(root, head),
        "ref": ref,
    }))


def cmd_diff(args):
    args, ref = take_ref(args)
    cwd = None
    scope = "uncommitted"
    from_sha = to_sha = None
    unified = 3
    max_bytes = DEFAULT_MAX_BYTES
    rest = list(args)
    try:
        while rest:
            arg = rest.pop(0)
            if arg == "--scope":
                scope = rest.pop(0)
            elif arg == "--from":
                from_sha = rest.pop(0)
            elif arg == "--to":
                to_sha = rest.pop(0)
            elif arg == "--unified":
                unified = int(rest.pop(0))
            elif arg == "--max-bytes":
                max_bytes = int(rest.pop(0))
            elif arg.startswith("-") or cwd is not None:
                raise ValueError(arg)
            else:
                cwd = arg
    except (IndexError, ValueError):
        die("usage: ai-todo-review diff <cwd> [--scope uncommitted|branch|since] [--from <sha>] "
            "[--to <sha>] [--unified N] [--max-bytes N]", 64)
    if cwd is None or scope not in ("uncommitted", "branch", "since") or unified < 0 or max_bytes < 1:
        die("usage: ai-todo-review diff <cwd> [--scope uncommitted|branch|since] ...", 64)
    root = repo_root(cwd)
    head = ref_sha(root, ref) if ref else head_sha(root)
    if to_sha is None:
        to_sha = head if ref else snapshot(root)[0]
    if scope == "since":
        if not from_sha:
            die("--scope since needs --from <sha>", 64)
    elif scope == "branch":
        base = base_of(root, head)
        from_sha = base["sha"] if base else head
    elif from_sha is None:
        from_sha = head
    for sha in (from_sha, to_sha):
        if sha and not line(root, "rev-parse", "--verify", "-q", sha + "^{commit}"):
            die("unknown revision %s" % sha, 65)
    if from_sha is None:
        # No commits yet: everything is new.
        from_sha = line(root, "hash-object", "-t", "tree", "/dev/null")
    # Explicit prefixes: diff.srcPrefix / diff.dstPrefix (git 2.45+) would change them.
    patch, _ = git(root, *DIFF_CONFIG, "diff", "--no-color", "--no-ext-diff", "--no-textconv",
                   "--src-prefix=a/", "--dst-prefix=b/", "-M", "--unified=%d" % unified, from_sha, to_sha, "--", text=False)
    truncated = len(patch) > max_bytes
    if truncated:
        cut = patch.rfind(b"\ndiff --git ", 0, max_bytes)
        # Whole files only: a file cut mid-hunk would move comments as if its tail were unchanged.
        patch = patch[:cut + 1] if cut > 0 else b""
    print(json.dumps({
        "from": from_sha,
        "to": to_sha,
        "scope": scope,
        "patch": patch.decode("utf-8", "replace"),
        "truncated": truncated,
    }))


def cmd_log(args):
    args, ref = take_ref(args)
    limit = 30
    before = None
    rest = list(args)
    cwd = None
    try:
        while rest:
            arg = rest.pop(0)
            if arg == "--limit":
                limit = int(rest.pop(0))
            elif arg == "--before":
                before = rest.pop(0)
            elif arg.startswith("-") or cwd is not None:
                raise ValueError(arg)
            else:
                cwd = arg
    except (IndexError, ValueError):
        cwd = None
    if cwd is None or not 1 <= limit <= 500 or (before is not None and not before.strip()):
        die("usage: ai-todo-review log <cwd> [--limit N] [--before <ISO time>]", 64)
    root = repo_root(cwd)
    head = ref_sha(root, ref) if ref else head_sha(root)
    commits = []
    found_before = None
    if head:
        out, _ = git(root, "log", "--first-parent", "-n", str(limit), "--format=%H%x1f%s%x1f%cI", head)
        unpushed = None
        upstream = line(root, "rev-parse", "--abbrev-ref", "--symbolic-full-name",
                        ("refs/heads/%s@{upstream}" % ref) if ref else "@{upstream}")
        if upstream:
            listed, _ = git(root, "rev-list", "%s..%s" % (upstream, head))
            unpushed = set(listed.split())
        for row in out.splitlines():
            parts = row.split("\x1f")
            if len(parts) != 3:
                continue
            sha, subject, date = parts
            commits.append({"sha": sha, "subject": subject, "date": date,
                            "pushed": None if unpushed is None else sha not in unpushed})
        if before is not None:
            found_before = line(root, "rev-list", "--first-parent", "-n", "1", "--before=" + before, head)
    print(json.dumps({"commits": commits, "before": found_before}))


def cmd_keep(args):
    if len(args) != 2:
        die("usage: ai-todo-review keep <cwd> <sha>", 64)
    root = repo_root(args[0])
    sha = line(root, "rev-parse", "--verify", "-q", args[1] + "^{commit}")
    if not sha:
        die("unknown revision %s" % args[1], 65)
    git(root, "update-ref", KEEP_PREFIX + sha, sha)
    print(json.dumps({"kept": sha}))


def tmux(*args, stdin=None):
    socket = os.environ.get("AI_TODO_TMUX_SOCKET")
    command = ["tmux"] + (["-L", socket] if socket else []) + list(args)
    try:
        return subprocess.run(command, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except FileNotFoundError:
        die_missing("tmux")


PASTE_END = b"\x1b[201~"
PASTE_SETTLE_SECONDS = float(os.environ.get("AI_TODO_REVIEW_PASTE_SETTLE", "0.3"))


def cmd_send(args):
    encoded = bool(args) and args[0] == "--base64"
    if encoded:
        args = args[1:]
    if len(args) != 1 or not args[0]:
        die("usage: ai-todo-review send [--base64] <tmux_name> < message", 64)
    name = args[0]
    message = sys.stdin.buffer.read()
    if encoded:
        try:
            message = base64.b64decode(message.strip(), validate=True)
        except (binascii.Error, ValueError):
            die("the message isn't base64", 64)
    # Removing one marker can join the pieces around it into another.
    while PASTE_END in message:
        message = message.replace(PASTE_END, b"")
    if not message.strip():
        die("empty message", 65)
    if tmux("has-session", "-t", "=" + name).returncode != 0:
        die("no tmux session %s" % name, 66)
    # The tool runs in the session's first pane (ai-todo-open starts it there). Not the active
    # one: a shell opened beside it would run the feedback as commands.
    panes = tmux("list-panes", "-s", "-t", "=" + name, "-F", "#{window_index} #{pane_index} #{pane_id}")
    rows = []
    for row in panes.stdout.decode().splitlines():
        parts = row.split()
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            rows.append((int(parts[0]), int(parts[1]), parts[2]))
    if panes.returncode != 0 or not rows:
        die("no pane in %s" % name, 66)
    target = min(rows)[2]
    # "1": the program turned bracketed paste on. Empty: a tmux without this format (unknown),
    # where the agent, once running, has it on.
    flag = tmux("display-message", "-p", "-t", target, "#{bracket_paste_flag}")
    if flag.returncode != 0 or flag.stdout.decode().strip() not in ("1", ""):
        die("%s isn't ready for a paste" % name, 75)
    buffer = "ai-review-%d" % os.getpid()
    if tmux("load-buffer", "-b", buffer, "-", stdin=message.rstrip(b"\n")).returncode != 0:
        die("couldn't load the message into tmux", 75)
    pasted = tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", target)
    if pasted.returncode != 0:
        tmux("delete-buffer", "-b", buffer)
        die("couldn't paste into %s" % name, 75)
    # A TUI may still be taking in a long paste; Return inside that would only add a line.
    time.sleep(PASTE_SETTLE_SECONDS)
    tmux("send-keys", "-t", target, "Enter")
    print(json.dumps({"sent": len(message)}))


# --- reviewer runs ---------------------------------------------------------------------------

RUN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,63}$")
RUN_KEEP_SECONDS = 7 * 24 * 3600
RUN_TIMEOUT_SECONDS = float(os.environ.get("AI_TODO_REVIEW_TIMEOUT", "1800"))
SEVERITIES = ("high", "medium", "low")
MAX_FINDINGS = 100
MAX_QUOTE_LINES = 20

FINDINGS_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["summary", "findings"],
    "properties": {
        "summary": {"type": "string"},
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["path", "side", "line_start", "line_end", "severity", "category", "title", "body", "quote"],
                "properties": {
                    "path": {"type": "string"},
                    "side": {"type": "string", "enum": ["new", "old"]},
                    "line_start": {"type": ["integer", "null"]},
                    "line_end": {"type": ["integer", "null"]},
                    "severity": {"type": "string", "enum": list(SEVERITIES)},
                    "category": {"type": "string"},
                    "title": {"type": "string"},
                    "body": {"type": "string"},
                    "quote": {"type": "array", "items": {"type": "string"}},
                },
            },
        },
    },
}

PROMPT = """You are reviewing a change to the git repository in the current folder. You may only read: \
don't edit, create or delete files, and don't run commands that change anything.

The change is the unified diff in {patch} (from {from_sha} to {to_sha}; paths in it are relative to \
the repository root). The current folder holds the files as they are after the change.

Read what helps you judge the change; these are the project's own notes and decisions:
{context}

Report the problems a careful senior reviewer would raise before this is merged: bugs, wrong \
behaviour, missing error handling, security issues, race conditions, data loss, broken or missing \
tests, and places that contradict the project's notes or decisions above. Only report problems in \
the changed code or caused by it. Skip style nits and anything a formatter or linter would catch. \
Say nothing about what is fine. If you find nothing worth raising, return no findings.

For each finding give:
- path: the file, relative to the repository root
- side: "new" for lines of the changed files (added or unchanged lines), "old" only for removed lines
- line_start, line_end: the lines on that side (line_end = line_start for one line), or both null \
for the whole file
- severity: high (wrong results, crashes, data loss, security), medium (likely to bite), low (worth a look)
- category: one word, such as correctness, security, performance, tests, docs, design
- title: one line
- body: what is wrong, why, and what to do about it; plain text, a few sentences
- quote: the lines you mean, copied exactly
And a one-sentence summary of the change and its state."""


def runs_dir():
    return os.environ.get("AI_TODO_REVIEW_RUNS_DIR") or os.path.join(os.path.expanduser("~"), ".ai-remote", "review-runs")


def run_dir_for(run_id):
    if not RUN_ID.match(run_id or ""):
        die("bad run id %r" % run_id, 64)
    return os.path.join(runs_dir(), run_id)


def write_json(path, value):
    tmp = path + ".tmp-%d" % os.getpid()
    with open(tmp, "w") as handle:
        json.dump(value, handle)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def tool_binary(tool):
    override = os.environ.get("AI_TODO_REVIEW_%s_BIN" % tool.upper())
    if override:
        return override if os.access(override, os.X_OK) else None
    return shutil.which(tool)


def prune_runs():
    folder = runs_dir()
    try:
        names = os.listdir(folder)
    except OSError:
        return
    now = time.time()
    for name in names:
        path = os.path.join(folder, name)
        try:
            if now - os.stat(path).st_mtime < RUN_KEEP_SECONDS:
                continue
        except OSError:
            continue
        state = read_json(os.path.join(path, "state.json")) or {}
        if state.get("state") == "running" and pid_alive(run_pid(path), path):
            continue
        shutil.rmtree(path, ignore_errors=True)


def run_pid(folder):
    try:
        with open(os.path.join(folder, "pid")) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def pid_alive(pid, folder=None):
    """The process runs; with `folder`, it is that run's worker (not a process that got its pid later)."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False
    if folder is None:
        return True
    try:
        command = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    except OSError:
        return True
    return "_worker" in command and os.path.basename(folder) in command


def cmd_run(args):
    args, ref = take_ref(args)
    cwd = None
    options = {"from": None, "to": None, "tool": None, "id": None, "model": None}
    context = []
    brief_on_stdin = False
    rest = list(args)
    try:
        while rest:
            arg = rest.pop(0)
            if arg in ("--from", "--to", "--tool", "--id", "--model"):
                options[arg[2:]] = rest.pop(0)
            elif arg == "--context":
                context.append(rest.pop(0))
            elif arg == "--brief-base64":
                brief_on_stdin = True
            elif arg.startswith("-") or cwd is not None:
                raise ValueError(arg)
            else:
                cwd = arg
    except (IndexError, ValueError):
        cwd = None
    if cwd is None or not options["from"] or not options["to"] or not options["id"] \
            or options["tool"] not in ("claude", "codex"):
        die("usage: ai-todo-review run <cwd> --from <sha> --to <sha> --tool claude|codex --id <id> "
            "[--ref <branch>] [--model M] [--context <path>]... [--brief-base64]", 64)
    folder = run_dir_for(options["id"])
    root = repo_root(cwd)
    shas = {}
    for key in ("from", "to"):
        sha = line(root, "rev-parse", "--verify", "-q", options[key] + "^{commit}")
        if not sha:
            die("unknown revision %s" % options[key], 65)
        shas[key] = sha
    if ref:
        ref_sha(root, ref)
    if not tool_binary(options["tool"]):
        die_missing(options["tool"])
    brief = ""
    if brief_on_stdin:
        try:
            brief = base64.b64decode(sys.stdin.buffer.read().strip(), validate=True).decode("utf-8", "replace")
        except (binascii.Error, ValueError):
            die("the brief isn't base64", 64)
    prune_runs()
    try:
        os.makedirs(folder)
    except FileExistsError:
        die("run %s exists" % options["id"], 64)
    request = {"root": root, "ref": ref, "from": shas["from"], "to": shas["to"], "tool": options["tool"],
               "model": options["model"], "context": context, "brief": brief}
    write_json(os.path.join(folder, "request.json"), request)
    write_json(os.path.join(folder, "state.json"), {"state": "running", "started_at": time.time()})
    log = open(os.path.join(folder, "worker.log"), "wb")
    # Its own session: it outlives this SSH command, and cancel stops it and the tool together.
    worker = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_worker", folder],
                              stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                              close_fds=True)
    log.close()
    with open(os.path.join(folder, "pid"), "w") as handle:
        handle.write(str(worker.pid))
    print(json.dumps({"id": options["id"], "state": "running"}))


def cmd_result(args):
    if len(args) != 1:
        die("usage: ai-todo-review result <id>", 64)
    folder = run_dir_for(args[0])
    state = read_json(os.path.join(folder, "state.json"))
    if state is None:
        die("no run %s" % args[0], 65)
    pid = run_pid(folder)
    # No pid yet: `run` is still starting it.
    if state.get("state") == "running" and pid and not pid_alive(pid, folder):
        # Read again: the worker may have finished between the two reads.
        state = read_json(os.path.join(folder, "state.json")) or state
        if state.get("state") == "running":
            state = {"state": "failed", "error": "The reviewer stopped without a result."}
    print(json.dumps({"id": args[0], "state": state.get("state"), "error": state.get("error"),
                      "result": state.get("result")}))


def cmd_cancel(args):
    if len(args) != 1:
        die("usage: ai-todo-review cancel <id>", 64)
    folder = run_dir_for(args[0])
    path = os.path.join(folder, "state.json")
    state = read_json(path)
    if state is None:
        die("no run %s" % args[0], 65)
    if state.get("state") == "running":
        pid = run_pid(folder)
        if pid_alive(pid, folder):
            # Cancelled first, so the worker's own exit doesn't write a result over it.
            state = {"state": "cancelled", "error": None, "result": None}
            write_json(path, state)
            try:
                os.killpg(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
        else:
            # It ended just now: whatever it wrote stands.
            state = read_json(path) or state
            if state.get("state") == "running":
                state = {"state": "cancelled", "error": None, "result": None}
                write_json(path, state)
    # The same shape as `result`: a run that finished first keeps its findings.
    print(json.dumps({"id": args[0], "state": state.get("state"), "error": state.get("error"),
                      "result": state.get("result")}))


# The worker: runs detached, writes state.json when it ends.

def revision_lines(root, sha, path, cache):
    key = (sha, path)
    if key not in cache:
        try:
            out, code = git(root, "show", "%s:%s" % (sha, path), check=False, text=False)
        except GitError:
            out, code = b"", 1
        cache[key] = out.decode("utf-8", "replace").split("\n") if code == 0 else None
        if cache[key] and cache[key][-1] == "":
            cache[key].pop()
    return cache[key]


def normalized(text):
    return " ".join(re.sub(r"[^0-9a-z]+", " ", text.lower()).split())


def fingerprint(path, title, nearby):
    code = "\n".join(" ".join(row.split()) for row in nearby)
    digest = hashlib.sha256("\n".join([path, normalized(title), code]).encode("utf-8")).hexdigest()
    return digest[:20]


def clean_finding(raw, root, request, cache, workdir=None):
    """A finding checked against the repository, or None. Lines and quote come from git."""
    if not isinstance(raw, dict):
        return None
    path = str(raw.get("path") or "").strip()
    for prefix in ("./", "a/", "b/"):
        if path.startswith(prefix) and not revision_lines(root, request["to"], path, cache):
            path = path[len(prefix):]
    for prefix in {root, workdir or root}:
        if path.startswith(prefix + "/"):
            path = path[len(prefix) + 1:]
    title = " ".join(str(raw.get("title") or "").split())[:200]
    body = str(raw.get("body") or "").strip()
    if not path or not (title or body):
        return None
    side = "old" if raw.get("side") == "old" else "new"
    lines = revision_lines(root, request["from" if side == "old" else "to"], path, cache)
    start, end = raw.get("line_start"), raw.get("line_end")
    if lines is None and side == "old":
        # Not in --from under that name (a rename): about the file, as its lines would be the wrong ones.
        side, lines, start, end = "new", revision_lines(root, request["to"], path, cache), None, None
    if lines is None:
        return None
    start = start if isinstance(start, int) and not isinstance(start, bool) and 1 <= start <= len(lines) else None
    if start is None:
        end = None
    else:
        end = end if isinstance(end, int) and not isinstance(end, bool) and start <= end else start
        end = min(end, len(lines))
    if start is not None:
        quote = lines[start - 1:min(end, start - 1 + MAX_QUOTE_LINES)]
        nearby = lines[max(start - 2, 0):start + 1]
    else:
        quote = []
        nearby = []
    severity = str(raw.get("severity") or "").lower()
    category = normalized(str(raw.get("category") or "")) or "other"
    return {
        "path": path, "side": side, "line_start": start, "line_end": end,
        "severity": severity if severity in SEVERITIES else "medium",
        "category": category.split()[0],
        "title": title or body.split("\n")[0][:120], "body": body or title,
        "quote": quote, "fingerprint": fingerprint(path, title or body, nearby),
    }


def parse_findings(text):
    """The JSON object in a reply: the whole text, or the outermost {...} in it."""
    if isinstance(text, dict):
        return text
    text = (text or "").strip()
    try:
        return json.loads(text)
    except ValueError:
        pass
    start, end = text.find("{"), text.rfind("}")
    if start >= 0 and end > start:
        try:
            return json.loads(text[start:end + 1])
        except ValueError:
            pass
    raise ReviewerError("The reviewer's answer wasn't the findings it was asked for.")


class ReviewerError(Exception):
    pass


def context_paths(root, workdir, request, changed):
    """The paths the reviewer is pointed at, as they are in `workdir`."""
    found = []

    def add(path):
        if path not in found and os.path.exists(path):
            found.append(path)

    folders = {""}
    for path in changed:
        parts = path.split("/")[:-1]
        for depth in range(len(parts) + 1):
            folders.add("/".join(parts[:depth]))
    for folder in sorted(folders, key=lambda f: (f.count("/"), f)):
        for name in ("AGENTS.md", "CLAUDE.md"):
            add(os.path.join(workdir, folder, name) if folder else os.path.join(workdir, name))
    for name in ("docs/adr", "docs/adrs", "docs/decisions", "docs/specs", "docs/spec", "specs", "spec"):
        add(os.path.join(workdir, name))
    for extra in request.get("context") or []:
        extra = os.path.expanduser(extra)
        add(extra if os.path.isabs(extra) else os.path.join(workdir, extra))
    return found


def run_claude(binary, workdir, folder, request, prompt):
    # Read is refused outside these folders: the run's own, and every context path elsewhere.
    extra = []
    for path in request.get("context_paths") or []:
        place = path if os.path.isdir(path) else os.path.dirname(path)
        if not (place + "/").startswith(workdir + "/") and not (place + "/").startswith(folder + "/") and place not in extra:
            extra.append(place)
    command = [binary, "-p", "--no-session-persistence", "--strict-mcp-config", "--setting-sources", "",
               "--tools", "Read,Grep,Glob", "--add-dir", folder] + [arg for place in extra for arg in ("--add-dir", place)] + [
               "--output-format", "json",
               "--json-schema", json.dumps(FINDINGS_SCHEMA)]
    if request.get("model"):
        command += ["--model", request["model"]]
    env = dict(os.environ)
    for name in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"):
        env.pop(name, None)
    out = run_tool(command, workdir, prompt, env)
    try:
        reply = json.loads(out)
    except ValueError:
        raise ReviewerError("claude's output wasn't JSON.")
    if not isinstance(reply, dict):
        raise ReviewerError("claude's output wasn't the expected JSON object.")
    if reply.get("is_error") or reply.get("subtype") not in (None, "success"):
        raise ReviewerError("claude failed: %s" % str(reply.get("result") or reply.get("subtype"))[:300])
    findings = parse_findings(reply.get("structured_output") or reply.get("result"))
    usage = reply.get("usage") or {}
    models = reply.get("modelUsage") or {}
    model = max(models, key=lambda name: (models[name] or {}).get("outputTokens") or 0) if models else request.get("model")
    return findings, model, {
        "input_tokens": usage.get("input_tokens"),
        "output_tokens": usage.get("output_tokens"),
        "cache_read_tokens": usage.get("cache_read_input_tokens"),
        "cache_write_tokens": usage.get("cache_creation_input_tokens"),
        "cost_usd": reply.get("total_cost_usd"),
    }


def run_codex(binary, workdir, folder, request, prompt):
    schema = os.path.join(folder, "schema.json")
    last = os.path.join(folder, "last-message.txt")
    write_json(schema, FINDINGS_SCHEMA)
    command = [binary, "exec", "--sandbox", "read-only", "--skip-git-repo-check", "--ephemeral",
               "--cd", workdir, "--add-dir", folder, "--output-schema", schema, "--output-last-message", last, "--json"]
    if request.get("model"):
        command += ["--model", request["model"]]
    out = run_tool(command + ["-"], workdir, prompt, dict(os.environ))
    usage = None
    model = request.get("model")
    for row in out.splitlines():
        try:
            event = json.loads(row)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "turn.completed" and isinstance(event.get("usage"), dict):
            totals = usage or {"input_tokens": 0, "output_tokens": 0, "cache_read_tokens": 0,
                               "cache_write_tokens": None, "cost_usd": None}
            cached = event["usage"].get("cached_input_tokens") or 0
            # codex's input_tokens include the cached ones; claude's (and this result's) don't.
            totals["input_tokens"] += max(0, (event["usage"].get("input_tokens") or 0) - cached)
            totals["output_tokens"] += event["usage"].get("output_tokens") or 0
            totals["cache_read_tokens"] += cached
            usage = totals
        elif event.get("type") == "turn.failed":
            message = (event.get("error") or {}).get("message") if isinstance(event.get("error"), dict) else None
            raise ReviewerError("codex failed: %s" % str(message or "turn failed")[:300])
        if isinstance(event.get("model"), str) and not model:
            model = event["model"]
    try:
        with open(last) as handle:
            text = handle.read()
    except OSError:
        raise ReviewerError("codex finished without an answer.")
    return parse_findings(text), model, usage


def run_tool(command, workdir, prompt, env):
    try:
        result = subprocess.run(command, cwd=workdir, input=prompt.encode("utf-8"), stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env, timeout=RUN_TIMEOUT_SECONDS)
    except FileNotFoundError:
        raise ReviewerError("%s not found" % os.path.basename(command[0]))
    except subprocess.TimeoutExpired:
        raise ReviewerError("The reviewer took longer than %d minutes." % (RUN_TIMEOUT_SECONDS // 60))
    if result.returncode != 0:
        detail = (result.stderr.decode("utf-8", "replace").strip().splitlines() or [""])[-1]
        raise ReviewerError("%s exited %d%s" % (os.path.basename(command[0]), result.returncode,
                                                ": " + detail[:300] if detail else ""))
    return result.stdout.decode("utf-8", "replace")


def worker(folder):
    state_path = os.path.join(folder, "state.json")
    tree = os.path.join(folder, "tree")
    started = (read_json(state_path) or {}).get("started_at") or time.time()

    def finish(state):
        shutil.rmtree(tree, ignore_errors=True)
        current = read_json(state_path) or {}
        if current.get("state") == "cancelled":
            return
        state.setdefault("error", None)
        state.setdefault("result", None)
        state["started_at"] = started
        state["finished_at"] = time.time()
        write_json(state_path, state)

    def on_term(signum, frame):
        finish({"state": "cancelled"})
        os._exit(0)

    signal.signal(signal.SIGTERM, on_term)
    request = read_json(os.path.join(folder, "request.json"))
    try:
        if not request:
            raise ReviewerError("The run's request is missing.")
        root = request["root"]
        patch, _ = git(root, *DIFF_CONFIG, "diff", "--no-color", "--no-ext-diff", "--no-textconv",
                       "--src-prefix=a/", "--dst-prefix=b/", "-M", request["from"], request["to"], "--", text=False)
        if not patch.strip():
            finish({"state": "done", "result": {
                "tool": request["tool"], "model": None, "from": request["from"], "to": request["to"],
                "summary": "No changes to review.", "usage": None, "findings": []}})
            return
        patch_path = os.path.join(folder, "changes.patch")
        with open(patch_path, "wb") as handle:
            handle.write(patch)
        names, _ = git(root, "diff", "--name-only", "--no-renames", request["from"], request["to"], "--")
        changed = [name for name in names.splitlines() if name]
        # The reviewer reads the files as of --to, in an export: the working tree may change
        # under it while it reads (the conversation's agent goes on working).
        workdir = tree
        os.makedirs(tree)
        archive = subprocess.Popen(["git", "-C", root, "archive", "--format=tar", request["to"]], stdout=subprocess.PIPE)
        unpacked = subprocess.run(["tar", "-x", "-C", tree], stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or unpacked.returncode != 0:
            raise ReviewerError("Couldn't export %s to review it." % request["to"][:12])
        context = context_paths(root, workdir, request, changed)
        request["context_paths"] = context
        if request.get("brief", "").strip():
            brief_path = os.path.join(folder, "brief.md")
            with open(brief_path, "w") as handle:
                handle.write(request["brief"])
            context.insert(0, brief_path)
        prompt = PROMPT.format(patch=patch_path, from_sha=request["from"], to_sha=request["to"],
                               context="\n".join("- " + path for path in context) or "- (none)")
        binary = tool_binary(request["tool"])
        if not binary:
            raise ReviewerError("%s not found" % request["tool"])
        runner = run_claude if request["tool"] == "claude" else run_codex
        reply, model, usage = runner(binary, workdir, folder, request, prompt)
        if not isinstance(reply, dict) or not isinstance(reply.get("findings"), list):
            raise ReviewerError("The reviewer's answer had no findings list.")
        cache = {}
        findings, seen = [], set()
        for raw in reply["findings"][:MAX_FINDINGS]:
            finding = clean_finding(raw, root, request, cache, workdir)
            if finding and finding["fingerprint"] not in seen:
                seen.add(finding["fingerprint"])
                findings.append(finding)
        finish({"state": "done", "result": {
            "tool": request["tool"], "model": model, "from": request["from"], "to": request["to"],
            "summary": str(reply.get("summary") or "").strip()[:1000], "usage": usage, "findings": findings}})
    except (ReviewerError, GitError, OSError, KeyError) as error:
        finish({"state": "failed", "error": str(error)[:500] or "The reviewer failed."})
    except Exception as error:  # anything unforeseen still ends the run, with its cause
        finish({"state": "failed", "error": ("%s: %s" % (type(error).__name__, error))[:500]})


def main(argv):
    if len(argv) == 2 and argv[0] == "_worker":
        worker(argv[1])
        return
    commands = {"status": cmd_status, "diff": cmd_diff, "keep": cmd_keep, "log": cmd_log, "send": cmd_send,
                "run": cmd_run, "result": cmd_result, "cancel": cmd_cancel}
    if not argv or argv[0] not in commands:
        die("usage: ai-todo-review status|diff|keep|log|send|run|result|cancel ... (see the header of this script)", 64)
    try:
        commands[argv[0]](argv[1:])
    except GitError as error:
        die(str(error)[:300] or "git failed", 70)


if __name__ == "__main__":
    main(sys.argv[1:])
