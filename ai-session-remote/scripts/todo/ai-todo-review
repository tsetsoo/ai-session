def iso_ts(text):
    """Seconds since the epoch of an ISO 8601 time (Z or an offset), or None."""
    import datetime
    text = (text or "").strip()
    if not text:
        return None
    try:
        parsed = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=datetime.timezone.utc)
    return parsed.timestamp()


# --- What a conversation did with PRs/MRs and branches, from its own transcript ---------
#
# Plain text, no model: the commands the agent ran (gh/glab/git push/git switch -c) and their
# output, its GitHub tool calls (Codex's connector, Claude's MCP servers), and Claude Code's own
# `gitOperation` notes. Kept per transcript in WORK_CACHE with how far it was read, so a long
# conversation is read once and then only its new lines.

WORK_CACHE = os.environ.get("AI_TODO_REVIEW_SCAN_DIR") or os.path.join(HOME, ".ai-remote", "review-scan")
WORK_VERSION = 1
# A line that mentions none of these can't be about a PR or a branch: not parsed.
WORK_WORDS = (b"git push", b"gh pr", b"glab mr", b"pull_request", b"merge_request", b"gitOperation",
              b"switch -c", b"switch -C", b"checkout -b", b"checkout -B", b" -b ", b"get_pr", b"fetch_pr",
              b"pullRequest")
# The answer to a call parked in `pending` (Claude's tool_result, older Codex's output).
WORK_ANSWERS = (b'"tool_result"', b'"function_call_output"')
PR_URL = re.compile(r"https?://[^\s\"'<>)\]\\]+?/(?:pull|-/merge_requests)/(\d+)(?![\d/]|/?new)")
PUSH_LINE = re.compile(r"^\s*[*+!= -]?\s*(?:\[new branch\]|[0-9a-f]{4,}\.\.\.?[0-9a-f]{4,})\s+(\S+)\s+->\s+(\S+)", re.M)
NEW_BRANCH = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(?:switch\s+-[cC]|checkout\s+-[bB]|worktree\s+add\s+(?:\S+\s+)*?-[bB])\s+([^\s;&|]+)")
# gh pr / glab mr flags that take no value: any other flag's next word is its value, not the PR.
PR_BOOL_FLAGS = {"-w", "--web", "-d", "--draft", "--fill", "-f", "--fill-first", "--fill-verbose", "-s", "--squash",
                 "-m", "--merge", "-r", "--rebase", "--delete-branch", "--admin", "--auto", "--disable-auto",
                 "--watch", "-a", "--approve", "--request-changes", "--no-maintainer-edit", "--undo", "--yes", "-y",
                 "--remove-source-branch", "--squash-before-merge", "--when-pipeline-succeeds", "--fail-fast",
                 "--required", "--patch", "--name-only", "--color", "--editor", "-e", "--comments", "-c"}


def pr_commands(cmd):
    """(gh|glab, verb, {target, repo, head}) for each `gh pr <verb>` / `glab mr <verb>` in a
    shell command. target: the first positional word (a number or a URL), quotes and flag
    values skipped; repo: -R/--repo; head: --head/-H/--source-branch."""
    import shlex
    try:
        lexer = shlex.shlex(cmd, posix=True, punctuation_chars=";&|()<>")
        lexer.whitespace_split = True
        words = list(lexer)
    except ValueError:
        return []
    found = []
    i = 0
    while i + 2 < len(words):
        if (words[i], words[i + 1]) not in (("gh", "pr"), ("glab", "mr")):
            i += 1
            continue
        forge, verb = words[i], words[i + 2]
        args = {"target": None, "repo": None, "head": None}
        j = i + 3
        while j < len(words) and not set(words[j]) <= set(";&|()<>"):
            word = words[j]
            if word.startswith("-"):
                name, _, inline = word.partition("=")
                value = inline if inline else (words[j + 1] if name not in PR_BOOL_FLAGS and j + 1 < len(words) else None)
                if not inline and name not in PR_BOOL_FLAGS:
                    j += 1
                if name in ("-R", "--repo"):
                    args["repo"] = value
                elif name in ("-H", "--head", "--source-branch"):
                    args["head"] = value
            elif args["target"] is None and (word.isdigit() or PR_URL.fullmatch(word)):
                args["target"] = word
            j += 1
        if verb not in ("list", "status"):
            found.append((forge, verb, args))
        i = j
    return found
PR_WRITES = ("create", "edit", "ready", "merge", "close", "reopen", "comment", "review", "update", "approve", "note")
PR_READS = ("view", "diff", "checkout", "checks")


def transcript_path(tool, session_id):
    """The conversation's transcript on this computer, or None."""
    if not re.fullmatch(r"[A-Za-z0-9_-]+", session_id or ""):
        return None
    if tool == "claude":
        home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
        found = glob.glob(os.path.join(home, "projects", "*", session_id + ".jsonl"))
    elif tool == "codex":
        home = os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")
        found = glob.glob(os.path.join(home, "sessions", "*", "*", "*", "rollout-*-" + session_id + ".jsonl"))
    else:
        return None
    found = [f for f in found if os.path.isfile(f)]
    return max(found, key=os.path.getmtime) if found else None


class Work:
    """What one transcript says: {url or "#N@cwd": pr} and {branch: info}."""

    RANK = {"read": 0, "changed": 1, "created": 2}

    def __init__(self, state=None):
        state = state or {}
        self.prs = state.get("prs") or {}
        self.branches = state.get("branches") or {}
        self.pending = state.get("pending") or {}

    def state(self):
        return {"prs": self.prs, "branches": self.branches, "pending": self.pending}

    def pr(self, role, at, url=None, number=None, cwd=None, head=None):
        if url:
            m = PR_URL.search(url)
            if not m:
                return
            url, number = m.group(0), int(m.group(1))
            key = url
        elif isinstance(number, int):
            key = "#%d@%s" % (number, cwd or "")
        else:
            return
        pr = self.prs.setdefault(key, {"url": url, "number": number, "cwd": cwd, "role": role, "at": at, "head": None})
        if self.RANK[role] > self.RANK.get(pr["role"], 0):
            pr["role"] = role
        if at and (not pr["at"] or at > pr["at"]):
            pr["at"] = at
        if head and head != "HEAD":
            pr["head"] = head

    def branch(self, name, at, pushed=False, cwd=None):
        name = (name or "").strip("'\"")
        if not name or name in ("HEAD", "main", "master") or name.startswith("-") or not re.fullmatch(r"[\w./@+-]+", name):
            return
        name = name.split(":")[-1]
        name = name[len("refs/heads/"):] if name.startswith("refs/heads/") else name
        b = self.branches.setdefault(name, {"pushed": False, "at": at, "cwd": cwd})
        b["pushed"] = b["pushed"] or pushed
        if at and (not b["at"] or at > b["at"]):
            b["at"] = at
        if cwd:
            b["cwd"] = cwd

    def command(self, cmd, output, cwd, at):
        """A shell command the agent ran, with what it printed."""
        if not isinstance(cmd, str):
            return
        output = output if isinstance(output, str) else ""
        for forge, verb, args in pr_commands(cmd):
            role = "created" if verb == "create" else "changed" if verb in PR_WRITES else "read" if verb in PR_READS else None
            if role is None:
                continue
            urls = [u.group(0) for u in PR_URL.finditer(output)] if role != "read" else []
            if role == "created":
                # Only what it printed: a create that failed made nothing.
                if urls:
                    self.pr(role, at, url=urls[-1], head=args["head"])
                continue
            target = args["target"]
            if target and target.startswith("http"):
                self.pr(role, at, url=target)
            elif target and args["repo"]:
                # -R owner/repo: that repository's, whichever folder it ran in.
                self.pr(role, at, url=(("https://github.com/%s/pull/%s" if forge == "gh"
                                        else "https://gitlab.com/%s/-/merge_requests/%s") % (args["repo"], target)))
            elif target:
                self.pr(role, at, number=int(target), cwd=cwd)
            elif urls:
                self.pr(role, at, url=urls[-1])
        if "git" in cmd and "push" in cmd:
            for m in PUSH_LINE.finditer(output):
                self.branch(m.group(2), at, pushed=True, cwd=cwd)
        for m in NEW_BRANCH.finditer(cmd):
            self.branch(m.group(1), at, cwd=cwd)

    def tool_call(self, name, args, result, read_only, at, cwd=None):
        """A GitHub/GitLab tool call (Codex's connector, an MCP server)."""
        name = (name or "").lower()
        if not isinstance(args, dict) or not ("pull" in name or "merge_request" in name or name.endswith("_pr")
                                              or "pr_info" in name or "fetch_pr" in name):
            return
        nested = args.get("pullRequest") if isinstance(args.get("pullRequest"), dict) else {}
        repo = (args.get("repository_full_name") or args.get("repo_full_name")
                or ("%s/%s" % (args.get("owner") or nested.get("owner"), args.get("repo") or args.get("repo_name")
                               or nested.get("repository"))
                    if (args.get("owner") or nested.get("owner")) else None))
        number = args.get("pr_number") or args.get("pull_number") or args.get("pullNumber") or nested.get("number")
        if "list" in name or "search" in name:
            return
        role = ("created" if "create_pull" in name or "create_merge" in name
                else "read" if read_only or any(w in name for w in ("get_", "fetch", "list_", "read")) else "changed")
        url = None
        text = json.dumps(result) if result is not None else ""
        if role == "created":
            found = PR_URL.search(text)
            url = found.group(0) if found else None
        if not url and repo and isinstance(number, int):
            url = "https://github.com/%s/pull/%d" % (repo, number)
        if url:
            self.pr(role, at, url=url, head=args.get("head"))

    def codex(self, d):
        at = d.get("timestamp")
        p = d.get("payload") or {}
        item = p.get("item") or {}
        kind = item.get("type")
        if p.get("type") == "item_completed" and kind == "CommandExecution":
            cmd = item.get("command")
            cmd = cmd[-1] if isinstance(cmd, list) and cmd else cmd
            cwd = item.get("cwd") or ""
            self.command(cmd, item.get("aggregated_output"), cwd[7:] if cwd.startswith("file://") else cwd, at)
        elif p.get("type") == "item_completed" and kind == "McpToolCall":
            if item.get("status") == "failed":
                return
            self.tool_call(item.get("tool"), item.get("arguments"), item.get("result"), item.get("readOnlyHint"), at)
        elif p.get("type") == "function_call" and p.get("name") in ("shell", "exec_command", "local_shell", "container.exec"):
            # Older Codex: the command now, its output in a function_call_output later.
            try:
                a = json.loads(p.get("arguments") or "{}")
            except ValueError:
                return
            cmd = a.get("cmd") or a.get("command")
            cmd = cmd[-1] if isinstance(cmd, list) and cmd else cmd
            if isinstance(cmd, str) and p.get("call_id"):
                self.pending[p["call_id"]] = {"cmd": cmd, "cwd": a.get("workdir"), "at": at}
        elif p.get("type") == "function_call_output" and p.get("call_id") in self.pending:
            call = self.pending.pop(p["call_id"])
            out = p.get("output")
            self.command(call["cmd"], out if isinstance(out, str) else json.dumps(out), call["cwd"], call["at"])

    def claude(self, d):
        at = d.get("timestamp")
        content = (d.get("message") or {}).get("content")
        if not isinstance(content, list):
            return
        for part in content:
            if not isinstance(part, dict):
                continue
            if part.get("type") == "tool_use" and part.get("id"):
                name = part.get("name") or ""
                if name == "Bash" or name.startswith("mcp__"):
                    self.pending[part["id"]] = {"name": name, "input": part.get("input"), "cwd": d.get("cwd"), "at": at}
            elif part.get("type") == "tool_result" and part.get("tool_use_id") in self.pending:
                call = self.pending.pop(part["tool_use_id"])
                done = d.get("toolUseResult") if isinstance(d.get("toolUseResult"), dict) else {}
                text = part.get("content")
                if isinstance(text, list):
                    text = "\n".join(t.get("text", "") for t in text if isinstance(t, dict))
                if not isinstance(text, str):
                    text = ""
                git_op = done.get("gitOperation") if isinstance(done.get("gitOperation"), dict) else {}
                op = git_op.get("pr") if isinstance(git_op.get("pr"), dict) else None
                if op:
                    role = "created" if op.get("action") == "created" else "changed"
                    if op.get("url"):
                        self.pr(role, call["at"], url=op["url"])
                    elif isinstance(op.get("number"), int):
                        self.pr(role, call["at"], number=op["number"], cwd=call["cwd"])
                push = git_op.get("push") if isinstance(git_op.get("push"), dict) else None
                if push:
                    self.branch(push.get("branch"), call["at"], pushed=True, cwd=call["cwd"])
                inp = call["input"] if isinstance(call["input"], dict) else {}
                if call["name"] == "Bash":
                    printed = ((done.get("stdout") or "") + "\n" + (done.get("stderr") or "")) if done else text
                    self.command(inp.get("command"), printed, call["cwd"], call["at"])
                elif not part.get("is_error"):
                    self.tool_call(call["name"].split("__")[-1], inp, text, None, call["at"], call["cwd"])

    def line(self, tool, raw):
        try:
            d = json.loads(raw)
        except ValueError:
            return
        if isinstance(d, dict):
            (self.claude if tool == "claude" else self.codex)(d)


def conversation_work(tool, session_id):
    """Work from the conversation's transcript, reading only what was added since last time.
    None when the transcript isn't on this computer."""
    path = transcript_path(tool, session_id)
    if not path:
        return None
    cache_file = os.path.join(WORK_CACHE, "%s-%s.json" % (tool, session_id))
    try:
        with open(cache_file) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    st = os.stat(path)
    if (cache.get("version") != WORK_VERSION or cache.get("path") != path or cache.get("inode") != st.st_ino
            or not isinstance(cache.get("offset"), int) or cache["offset"] > st.st_size):
        cache = {"offset": 0, "state": None}
    work = Work(cache.get("state"))
    offset = cache["offset"]
    with open(path, "rb") as f:
        f.seek(offset)
        while True:
            chunk = f.readline()
            if not chunk.endswith(b"\n"):
                break  # Half-written: next time.
            offset += len(chunk)
            if any(word in chunk for word in WORK_WORDS) or (
                    work.pending and any(a in chunk for a in WORK_ANSWERS) and any(k.encode() in chunk for k in work.pending)):
                work.line(tool, chunk)
    # Calls whose answer never came stay a while, not forever.
    if len(work.pending) > 500:
        work.pending = dict(list(work.pending.items())[-200:])
    try:
        os.makedirs(WORK_CACHE, exist_ok=True)
        tmp = cache_file + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"version": WORK_VERSION, "path": path, "inode": st.st_ino, "offset": offset,
                       "state": work.state()}, f)
        os.replace(tmp, cache_file)
    except OSError:
        pass
    return work


def origin_slug(root):
    """owner/repo (GitLab: group/…/repo) of origin, lowercased, or None."""
    url = line(root, "remote", "get-url", "origin") or ""
    m = re.match(r"^(?:[a-z][a-z0-9+.-]*://)?(?:[^@/]+@)?[^/:]+(?::\d+)?[:/](.+?)(?:\.git)?/?$", url, re.I)
    return m.group(1).lower().lstrip("/") if m else None


def url_slug(url):
    m = re.match(r"^https?://[^/]+/(.+?)/(?:pull|-/merge_requests)/\d+", url or "")
    return m.group(1).lower() if m else None


def other_repo(root, folder, cache):
    """`folder` is still there and in a different repository than `root`'s. A folder that's
    gone (a removed worktree) or not in git can't say: not counted as another."""
    if not folder or not os.path.isdir(folder):
        return False
    same_repo(root, folder, cache)
    return cache[folder] is not None and cache[folder] != cache[":root"]


def same_repo(root, folder, cache):
    """`folder` is a worktree of `root`'s repository (its commands were about this repo)."""
    if not folder:
        return False
    if folder not in cache:
        common = line(folder, "rev-parse", "--path-format=absolute", "--git-common-dir") if os.path.isdir(folder) else None
        cache[folder] = os.path.realpath(common) if common else None
    if ":root" not in cache:
        common = line(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
        cache[":root"] = os.path.realpath(common) if common else None
    return bool(cache[folder]) and cache[folder] == cache[":root"]


def fetch_prs(kind, root, slug, numbers):
    """The forge's rows for these PR/MR numbers (ones the account didn't open, or older than
    the list): [{...as in `prs`}]. Missing or unreadable ones are left out."""
    if not numbers:
        return []
    if kind == "github":
        owner, _, name = slug.partition("/")
        fields = "number title url state isDraft headRefName baseRefName headRefOid updatedAt"
        query = "query($o:String!,$n:String!){repository(owner:$o,name:$n){%s}}" % " ".join(
            "p%d: pullRequest(number:%d){%s}" % (n, n, fields) for n in numbers)
        try:
            data = forge_json(kind, root, "api", "graphql", "-f", "query=" + query, "-f", "o=" + owner, "-f", "n=" + name)
            repo = ((data or {}).get("data") or {}).get("repository") or {}
            rows = [r for r in repo.values() if isinstance(r, dict)]
        except NoAccess:
            # One number that isn't a PR fails the whole query: each on its own instead.
            rows = []
            for n in numbers:
                try:
                    r = forge_json(kind, root, "pr", "view", str(n), "--json", fields.replace(" ", ","))
                except NoAccess:
                    continue
                if isinstance(r, dict):
                    rows.append(r)
        return [{"number": r.get("number"), "title": r.get("title") or "", "url": r.get("url"),
                 "state": str(r.get("state") or "").lower(), "draft": bool(r.get("isDraft")),
                 "head_ref": r.get("headRefName"), "base_ref": r.get("baseRefName"),
                 "head_sha": r.get("headRefOid"), "updated_at": r.get("updatedAt")} for r in rows]
    out = []
    states = {"opened": "open", "locked": "open"}
    for n in numbers:
        try:
            r = forge_json(kind, root, "mr", "view", str(n), "-F", "json") or {}
        except NoAccess:
            continue
        out.append({"number": r.get("iid"), "title": r.get("title") or "", "url": r.get("web_url"),
                    "state": states.get(r.get("state"), r.get("state") or ""), "draft": bool(r.get("draft")),
                    "head_ref": r.get("source_branch"), "base_ref": r.get("target_branch"),
                    "head_sha": r.get("sha"), "updated_at": r.get("updated_at")})
    return out


MAX_FETCHED_PRS = 15


def cmd_prs(args):
    """prs <cwd> [--since ISO]: the PRs/MRs in origin that the computer's gh/glab account
    opened, newest update first: {provider, access, error, viewer, prs: [{number, title, url,
    state, draft, head_ref, base_ref, head_sha, updated_at, since}]}. since: updated at or after
    --since (when the conversation began). Read-only."""
    args, since = take_option(args, "--since")
    args, session = take_option(args, "--session")
    if len(args) != 1 or (session and not re.fullmatch(r"(claude|codex):[A-Za-z0-9_-]+", session)):
        die("usage: ai-todo-review prs <cwd> [--since <ISO time>] [--session claude|codex:<id>]", 64)
    since_ts = iso_ts(since) if since else None
    if since and since_ts is None:
        die("--since needs an ISO time", 64)
    root = repo_root(args[0])
    kind = forge_kind(root)
    out = {"provider": kind, "access": False, "error": None, "viewer": None, "prs": []}
    if kind is None:
        out["error"] = "origin is neither GitHub nor GitLab"
        print(json.dumps(out))
        return
    try:
        if kind == "github":
            # The 30 most recently updated, not created: an old PR the agent just pushed to counts.
            rows = forge_json(kind, root, "pr", "list", "--author", "@me", "--state", "all", "--limit", "30",
                              "--search", "sort:updated-desc",
                              "--json", "number,title,url,state,isDraft,headRefName,baseRefName,headRefOid,updatedAt")
            prs = [{"number": r.get("number"), "title": r.get("title") or "", "url": r.get("url"),
                    "state": str(r.get("state") or "").lower(), "draft": bool(r.get("isDraft")),
                    "head_ref": r.get("headRefName"), "base_ref": r.get("baseRefName"),
                    "head_sha": r.get("headRefOid"), "updated_at": r.get("updatedAt")} for r in rows or [] if isinstance(r, dict)]
        else:
            rows = forge_json(kind, root, "mr", "list", "--author=@me", "--all", "-F", "json", "--per-page", "30",
                              "--order", "updated_at", "--sort", "desc")
            states = {"opened": "open", "locked": "open"}
            prs = [{"number": r.get("iid"), "title": r.get("title") or "", "url": r.get("web_url"),
                    "state": states.get(r.get("state"), r.get("state") or ""), "draft": bool(r.get("draft")),
                    "head_ref": r.get("source_branch"), "base_ref": r.get("target_branch"),
                    "head_sha": r.get("sha"), "updated_at": r.get("updated_at")} for r in rows or [] if isinstance(r, dict)]
        out["access"] = True
        out["viewer"] = viewer(kind, root)
    except NoAccess as error:
        out["error"] = str(error)
        print(json.dumps(out))
        return
    def stamp(pr):
        return iso_ts(pr.get("updated_at")) or 0

    prs = [p for p in prs if isinstance(p.get("number"), int)]
    if session:
        tool, _, sid = session.partition(":")
        work = conversation_work(tool, sid)
        out["transcript"] = work is not None
        if work is not None:
            prs = add_work(kind, root, prs, work, out)
    for pr in prs:
        pr["since"] = bool(since_ts is not None and stamp(pr) >= since_ts)
    # The conversation's own first, the latest it touched first; then the rest by update.
    prs.sort(key=stamp, reverse=True)
    prs.sort(key=lambda p: iso_ts(p.get("mine_at")) or 0, reverse=True)
    prs.sort(key=lambda p: Work.RANK.get(p.get("mine"), -1) >= 1, reverse=True)
    out["prs"] = prs
    print(json.dumps(out))


def add_work(kind, root, prs, work, out):
    """Marks the PRs/MRs the conversation made, changed (mine: created|changed) or read, adds
    those the list lacks, and lists its branches that have no PR here. Only this repository's."""
    slug = origin_slug(root)
    repos = {}
    touched = {}
    for pr in work.prs.values():
        if pr.get("url"):
            if url_slug(pr["url"]) != slug:
                continue
        elif not pr.get("cwd") or other_repo(root, pr.get("cwd"), repos):
            continue
        t = touched.setdefault(pr["number"], {"role": pr["role"], "at": pr["at"]})
        if Work.RANK[pr["role"]] > Work.RANK[t["role"]]:
            t["role"] = pr["role"]
        if (pr["at"] or "") > (t["at"] or ""):
            t["at"] = pr["at"]
    listed = {p["number"] for p in prs}
    missing = sorted((n for n in touched if n not in listed), key=lambda n: touched[n]["at"] or "", reverse=True)
    prs = prs + [p for p in fetch_prs(kind, root, slug or "", missing[:MAX_FETCHED_PRS]) if isinstance(p.get("number"), int)]
    try:
        refs = set(git(root, "for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes/origin")[0].split())
    except GitError:
        refs = set()
    branches = {}
    default = default_branch_ref(root)
    for name, b in work.branches.items():
        local, remote = "refs/heads/" + name, "refs/remotes/origin/" + name
        if local not in refs and remote not in refs:
            continue  # Another repository's, or gone.
        if other_repo(root, b.get("cwd"), repos):
            continue  # Made in another repository that has a branch of the same name.
        tip = local if local in refs else remote
        if default and line(root, "rev-list", "--count", tip, "--not", default) == "0":
            continue  # Nothing on it the default branch lacks: made and never committed to, or merged.
        branches[name] = {"name": name, "ref": name if local in refs else "origin/" + name,
                          "pushed": bool(b.get("pushed")), "at": b.get("at")}
    for pr in prs:
        mine = touched.get(pr["number"])
        on_branch = branches.get(pr.get("head_ref") or "")
        if on_branch:
            mine = {"role": "changed" if not mine or mine["role"] == "read" else mine["role"],
                    "at": max((mine or {}).get("at") or "", on_branch["at"] or "") or None}
        pr["mine"] = mine["role"] if mine else None
        pr["mine_at"] = mine["at"] if mine else None
    heads = {p.get("head_ref") for p in prs}
    out["branches"] = sorted((b for b in branches.values() if b["name"] not in heads),
                             key=lambda b: b["at"] or "", reverse=True)
    return prs


def cmd_fetch_pr(args):
    """fetch-pr <cwd> --number N [--base REF] [--head SHA]: the PR/MR's head
    (refs/ai-review/pr/N, from GitHub's pull/N/head or GitLab's merge-requests/N/head) and its
    base branch from origin; {number, head, base, base_ref}. base..head is exactly the PR's
    changes, wherever the agent worked: the merge base with the base branch, or for a merged
    PR (already in it) where it began. --base and --head (from `prs`) skip asking the forge,
    and the fetch when the head is already here. Only refs/ai-review/ and origin's base branch
    change."""
    args, number = take_number(args)
    args, base_ref = take_option(args, "--base")
    args, want = take_option(args, "--head")
    if number is None or len(args) != 1:
        die("usage: ai-todo-review fetch-pr <cwd> --number N [--base <branch>] [--head <sha>]", 64)
    root = repo_root(args[0])
    kind = forge_kind(root)
    if kind is None:
        die("origin is neither GitHub nor GitLab", 64)
    if not base_ref:
        try:
            if kind == "github":
                view = forge_json(kind, root, "pr", "view", str(number), "--json", "baseRefName,headRefOid") or {}
                base_ref, want = view.get("baseRefName"), want or view.get("headRefOid")
            else:
                view = forge_json(kind, root, "mr", "view", str(number), "-F", "json") or {}
                base_ref, want = view.get("target_branch"), want or view.get("sha")
        except NoAccess as error:
            die(str(error), 77)
    if not base_ref:
        die("couldn't tell the base branch of %d" % number, 77)
    local = "refs/ai-review/pr/%d" % number
    remote_ref = ("pull/%d/head" if kind == "github" else "merge-requests/%d/head") % number
    have = line(root, "rev-parse", "--verify", "-q", local + "^{commit}")
    base_tracking = "refs/remotes/origin/%s" % base_ref
    if not (want and have == want and line(root, "rev-parse", "--verify", "-q", base_tracking)):
        try:
            git(root, "fetch", "--quiet", "--no-tags", "origin",
                "+%s:%s" % (remote_ref, local), "+refs/heads/%s:%s" % (base_ref, base_tracking),
                env={"GIT_TERMINAL_PROMPT": "0"})
        except GitError as error:
            die("couldn't fetch it from origin: %s" % str(error)[:200], 70)
    head = line(root, "rev-parse", "--verify", "-q", local + "^{commit}")
    if not head:
        die("no head for %d after fetching" % number, 70)
    base = line(root, "merge-base", base_tracking, head)
    if base == head:
        # Merged (with a merge commit): the base branch has it all. Where it began instead.
        base = merged_base(kind, root, number, head)
    if not base:
        die("%d has no common commit with %s" % (number, base_ref), 70)
    print(json.dumps({"number": number, "head": head, "base": base, "base_ref": base_ref}))


def merged_base(kind, root, number, head):
    """Where a merged PR began: GitLab's diff base, or the parent of its first commit."""
    try:
        if kind == "gitlab":
            view = forge_json(kind, root, "mr", "view", str(number), "-F", "json") or {}
            project = view.get("project_id")
            if project:
                detail = forge_json(kind, root, "api", "projects/%s/merge_requests/%s" % (project, number)) or {}
                base = (detail.get("diff_refs") or {}).get("base_sha")
                if base and line(root, "rev-parse", "--verify", "-q", base + "^{commit}"):
                    return base
            return None
        commits = (forge_json(kind, root, "pr", "view", str(number), "--json", "commits") or {}).get("commits") or []
    except NoAccess:
        return None
    first = next((c.get("oid") for c in commits if isinstance(c, dict) and c.get("oid")), None)
    return line(root, "rev-parse", "--verify", "-q", first + "^") if first else None


# --- worktrees of the repository --------------------------------------------------------

def cmd_worktrees(args):
    """worktrees <cwd> [--since ISO]: every worktree of the repository, most recently active
    first: {root, worktrees: [{path, branch, head, detached, current, active_at, changed_since}]}.
    active_at is the later of its last commit and its HEAD log's last change (commits,
    checkouts, resets). Not the index: any `git status` rewrites that. changed_since: active at or after --since (when the
    conversation began), so the agent's own worktree is easy to find without reading
    transcripts."""
    args, since = take_option(args, "--since")
    if len(args) != 1:
        die("usage: ai-todo-review worktrees <cwd> [--since <ISO time>]", 64)
    root = repo_root(args[0])
    out, _ = git(root, "worktree", "list", "--porcelain")
    since_ts = iso_ts(since) if since else None
    if since and since_ts is None:
        die("--since needs an ISO time", 64)
    entries, entry = [], {}
    for row in out.splitlines() + [""]:
        if not row:
            if entry.get("path"):
                entries.append(entry)
            entry = {}
            continue
        key, _, value = row.partition(" ")
        if key == "worktree":
            entry["path"] = value
        elif key == "HEAD":
            entry["head"] = value
        elif key == "branch":
            entry["branch"] = value[len("refs/heads/"):] if value.startswith("refs/heads/") else value
        elif key == "detached":
            entry["detached"] = True
        elif key == "prunable":
            entry["prunable"] = True
        elif key == "bare":
            entry["bare"] = True
    real_root = os.path.realpath(root)
    worktrees = []
    for entry in entries:
        path = entry["path"]
        if entry.get("prunable") or entry.get("bare") or not os.path.isdir(path):
            continue
        active = 0.0
        committed = line(path, "log", "-1", "--format=%ct", "HEAD")
        if committed and committed.isdigit():
            active = float(committed)
        head_log = line(path, "rev-parse", "--path-format=absolute", "--git-path", "logs/HEAD")
        try:
            active = max(active, os.stat(head_log).st_mtime) if head_log else active
        except OSError:
            pass
        worktrees.append({
            "path": path, "branch": entry.get("branch"), "head": entry.get("head"),
            "detached": bool(entry.get("detached")), "current": os.path.realpath(path) == real_root,
            "active_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(active)) if active else None,
            "changed_since": bool(since_ts is not None and active >= since_ts),
            "_active": active,
        })
    worktrees.sort(key=lambda w: w["_active"], reverse=True)
    for w in worktrees:
        w.pop("_active")
    print(json.dumps({"root": root, "worktrees": worktrees}))


# --- reviewer runs ---------------------------------------------------------------------------

RUN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,63}$")
RUN_KEEP_SECONDS = 7 * 24 * 3600
RUN_TIMEOUT_SECONDS = float(os.environ.get("AI_TODO_REVIEW_TIMEOUT", "1800"))
SEVERITIES = ("high", "medium", "low")
MAX_FINDINGS = 100
MAX_QUOTE_LINES = 20

FINDINGS_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["summary", "findings"],
    "properties": {
        "summary": {"type": "string"},
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["path", "side", "line_start", "line_end", "severity", "category", "title", "body", "quote"],
                "properties": {
                    "path": {"type": "string"},
                    "side": {"type": "string", "enum": ["new", "old"]},
                    "line_start": {"type": ["integer", "null"]},
                    "line_end": {"type": ["integer", "null"]},
                    "severity": {"type": "string", "enum": list(SEVERITIES)},
                    "category": {"type": "string"},
                    "title": {"type": "string"},
                    "body": {"type": "string"},
                    "quote": {"type": "array", "items": {"type": "string"}},
                },
            },
        },
    },
}

PROMPT = """You are reviewing a change to the git repository in the current folder. You may only read: \
don't edit, create or delete files, and don't run commands that change anything.

The change is the unified diff in {patch} (from {from_sha} to {to_sha}; paths in it are relative to \
the repository root). The current folder holds the files as they are after the change.

Read what helps you judge the change; these are the project's own notes and decisions:
{context}

Report the problems a careful senior reviewer would raise before this is merged: bugs, wrong \
behaviour, missing error handling, security issues, race conditions, data loss, broken or missing \
tests, and places that contradict the project's notes or decisions above. Only report problems in \
the changed code or caused by it. Skip style nits and anything a formatter or linter would catch. \
Say nothing about what is fine. If you find nothing worth raising, return no findings.

For each finding give:
- path: the file, relative to the repository root
- side: "new" for lines of the changed files (added or unchanged lines), "old" only for removed lines
- line_start, line_end: the lines on that side (line_end = line_start for one line), or both null \
for the whole file
- severity: high (wrong results, crashes, data loss, security), medium (likely to bite), low (worth a look)
- category: one word, such as correctness, security, performance, tests, docs, design
- title: one line
- body: what is wrong, why, and what to do about it; plain text, a few sentences
- quote: the lines you mean, copied exactly
And a one-sentence summary of the change and its state."""


def runs_dir():
    return os.environ.get("AI_TODO_REVIEW_RUNS_DIR") or os.path.join(os.path.expanduser("~"), ".ai-remote", "review-runs")


def run_dir_for(run_id):
    if not RUN_ID.match(run_id or ""):
        die("bad run id %r" % run_id, 64)
    return os.path.join(runs_dir(), run_id)


def write_json(path, value):
    tmp = path + ".tmp-%d" % os.getpid()
    with open(tmp, "w") as handle:
        json.dump(value, handle)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def tool_binary(tool):
    override = os.environ.get("AI_TODO_REVIEW_%s_BIN" % tool.upper())
    if override:
        return override if os.access(override, os.X_OK) else None
    return shutil.which(tool)


def prune_runs():
    folder = runs_dir()
    try:
        names = os.listdir(folder)
    except OSError:
        return
    now = time.time()
    for name in names:
        path = os.path.join(folder, name)
        try:
            if now - os.stat(path).st_mtime < RUN_KEEP_SECONDS:
                continue
        except OSError:
            continue
        state = read_json(os.path.join(path, "state.json")) or {}
        if state.get("state") == "running" and pid_alive(run_pid(path), path):
            continue
        shutil.rmtree(path, ignore_errors=True)


def run_pid(folder):
    try:
        with open(os.path.join(folder, "pid")) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return None


def pid_alive(pid, folder=None):
    """The process runs; with `folder`, it is that run's worker (not a process that got its pid later)."""
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return False
    if folder is None:
        return True
    try:
        command = subprocess.run(["ps", "-o", "command=", "-p", str(pid)], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL).stdout.decode("utf-8", "replace")
    except OSError:
        return True
    return "_worker" in command and os.path.basename(folder) in command


def cmd_run(args):
    args, ref = take_ref(args)
    cwd = None
    options = {"from": None, "to": None, "tool": None, "id": None, "model": None}
    context = []
    brief_on_stdin = False
    rest = list(args)
    try:
        while rest:
            arg = rest.pop(0)
            if arg in ("--from", "--to", "--tool", "--id", "--model"):
                options[arg[2:]] = rest.pop(0)
            elif arg == "--context":
                context.append(rest.pop(0))
            elif arg == "--brief-base64":
                brief_on_stdin = True
            elif arg.startswith("-") or cwd is not None:
                raise ValueError(arg)
            else:
                cwd = arg
    except (IndexError, ValueError):
        cwd = None
    if cwd is None or not options["from"] or not options["to"] or not options["id"] \
            or options["tool"] not in ("claude", "codex"):
        die("usage: ai-todo-review run <cwd> --from <sha> --to <sha> --tool claude|codex --id <id> "
            "[--ref <branch>] [--model M] [--context <path>]... [--brief-base64]", 64)
    folder = run_dir_for(options["id"])
    root = repo_root(cwd)
    shas = {}
    for key in ("from", "to"):
        sha = line(root, "rev-parse", "--verify", "-q", options[key] + "^{commit}")
        if not sha:
            die("unknown revision %s" % options[key], 65)
        shas[key] = sha
    if ref:
        ref_sha(root, ref)
    if not tool_binary(options["tool"]):
        die_missing(options["tool"])
    brief = ""
    if brief_on_stdin:
        try:
            brief = base64.b64decode(sys.stdin.buffer.read().strip(), validate=True).decode("utf-8", "replace")
        except (binascii.Error, ValueError):
            die("the brief isn't base64", 64)
    prune_runs()
    try:
        os.makedirs(folder)
    except FileExistsError:
        die("run %s exists" % options["id"], 64)
    request = {"root": root, "ref": ref, "from": shas["from"], "to": shas["to"], "tool": options["tool"],
               "model": options["model"], "context": context, "brief": brief}
    write_json(os.path.join(folder, "request.json"), request)
    write_json(os.path.join(folder, "state.json"), {"state": "running", "started_at": time.time()})
    log = open(os.path.join(folder, "worker.log"), "wb")
    # Its own session: it outlives this SSH command, and cancel stops it and the tool together.
    worker = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_worker", folder],
                              stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
                              close_fds=True)
    log.close()
    with open(os.path.join(folder, "pid"), "w") as handle:
        handle.write(str(worker.pid))
    print(json.dumps({"id": options["id"], "state": "running"}))


def cmd_result(args):
    if len(args) != 1:
        die("usage: ai-todo-review result <id>", 64)
    folder = run_dir_for(args[0])
    state = read_json(os.path.join(folder, "state.json"))
    if state is None:
        die("no run %s" % args[0], 65)
    pid = run_pid(folder)
    # No pid yet: `run` is still starting it.
    if state.get("state") == "running" and pid and not pid_alive(pid, folder):
        # Read again: the worker may have finished between the two reads.
        state = read_json(os.path.join(folder, "state.json")) or state
        if state.get("state") == "running":
            state = {"state": "failed", "error": "The reviewer stopped without a result."}
    print(json.dumps({"id": args[0], "state": state.get("state"), "error": state.get("error"),
                      "result": state.get("result")}))


def cmd_cancel(args):
    if len(args) != 1:
        die("usage: ai-todo-review cancel <id>", 64)
    folder = run_dir_for(args[0])
    path = os.path.join(folder, "state.json")
    state = read_json(path)
    if state is None:
        die("no run %s" % args[0], 65)
    if state.get("state") == "running":
        pid = run_pid(folder)
        if pid_alive(pid, folder):
            # Cancelled first, so the worker's own exit doesn't write a result over it.
            state = {"state": "cancelled", "error": None, "result": None}
            write_json(path, state)
            try:
                os.killpg(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
        else:
            # It ended just now: whatever it wrote stands.
            state = read_json(path) or state
            if state.get("state") == "running":
                state = {"state": "cancelled", "error": None, "result": None}
                write_json(path, state)
    # The same shape as `result`: a run that finished first keeps its findings.
    print(json.dumps({"id": args[0], "state": state.get("state"), "error": state.get("error"),
                      "result": state.get("result")}))


# The worker: runs detached, writes state.json when it ends.

def revision_lines(root, sha, path, cache):
    key = (sha, path)
    if key not in cache:
        try:
            out, code = git(root, "show", "%s:%s" % (sha, path), check=False, text=False)
        except GitError:
            out, code = b"", 1
        cache[key] = out.decode("utf-8", "replace").split("\n") if code == 0 else None
        if cache[key] and cache[key][-1] == "":
            cache[key].pop()
    return cache[key]


def normalized(text):
    return " ".join(re.sub(r"[^0-9a-z]+", " ", text.lower()).split())


def fingerprint(path, title, nearby):
    code = "\n".join(" ".join(row.split()) for row in nearby)
    digest = hashlib.sha256("\n".join([path, normalized(title), code]).encode("utf-8")).hexdigest()
    return digest[:20]


def clean_finding(raw, root, request, cache, workdir=None):
    """A finding checked against the repository, or None. Lines and quote come from git."""
    if not isinstance(raw, dict):
        return None
    path = str(raw.get("path") or "").strip()
    for prefix in ("./", "a/", "b/"):
        if path.startswith(prefix) and not revision_lines(root, request["to"], path, cache):
            path = path[len(prefix):]
    for prefix in {root, workdir or root}:
        if path.startswith(prefix + "/"):
            path = path[len(prefix) + 1:]
    title = " ".join(str(raw.get("title") or "").split())[:200]
    body = str(raw.get("body") or "").strip()
    if not path or not (title or body):
        return None
    side = "old" if raw.get("side") == "old" else "new"
    lines = revision_lines(root, request["from" if side == "old" else "to"], path, cache)
    start, end = raw.get("line_start"), raw.get("line_end")
    if lines is None and side == "old":
        # Not in --from under that name (a rename): about the file, as its lines would be the wrong ones.
        side, lines, start, end = "new", revision_lines(root, request["to"], path, cache), None, None
    if lines is None:
        return None
    start = start if isinstance(start, int) and not isinstance(start, bool) and 1 <= start <= len(lines) else None
    if start is None:
        end = None
    else:
        end = end if isinstance(end, int) and not isinstance(end, bool) and start <= end else start
        end = min(end, len(lines))
    if start is not None:
        quote = lines[start - 1:min(end, start - 1 + MAX_QUOTE_LINES)]
        nearby = lines[max(start - 2, 0):start + 1]
    else:
        quote = []
        nearby = []
    severity = str(raw.get("severity") or "").lower()
    category = normalized(str(raw.get("category") or "")) or "other"
    return {
        "path": path, "side": side, "line_start": start, "line_end": end,
        "severity": severity if severity in SEVERITIES else "medium",
        "category": category.split()[0],
        "title": title or body.split("\n")[0][:120], "body": body or title,
        "quote": quote, "fingerprint": fingerprint(path, title or body, nearby),
    }


def parse_findings(text):
    """The JSON object in a reply: the whole text, or the outermost {...} in it."""
    if isinstance(text, dict):
        return text
    text = (text or "").strip()
    try:
        return json.loads(text)
    except ValueError:
        pass
    start, end = text.find("{"), text.rfind("}")
    if start >= 0 and end > start:
        try:
            return json.loads(text[start:end + 1])
        except ValueError:
            pass
    raise ReviewerError("The reviewer's answer wasn't the findings it was asked for.")


class ReviewerError(Exception):
    pass


def context_paths(root, workdir, request, changed):
    """The paths the reviewer is pointed at, as they are in `workdir`."""
    found = []

    def add(path):
        if path not in found and os.path.exists(path):
            found.append(path)

    folders = {""}
    for path in changed:
        parts = path.split("/")[:-1]
        for depth in range(len(parts) + 1):
            folders.add("/".join(parts[:depth]))
    for folder in sorted(folders, key=lambda f: (f.count("/"), f)):
        for name in ("AGENTS.md", "CLAUDE.md"):
            add(os.path.join(workdir, folder, name) if folder else os.path.join(workdir, name))
    for name in ("docs/adr", "docs/adrs", "docs/decisions", "docs/specs", "docs/spec", "specs", "spec"):
        add(os.path.join(workdir, name))
    for extra in request.get("context") or []:
        extra = os.path.expanduser(extra)
        add(extra if os.path.isabs(extra) else os.path.join(workdir, extra))
    return found


def run_claude(binary, workdir, folder, request, prompt):
    # Read is refused outside these folders: the run's own, and every context path elsewhere.
    extra = []
    for path in request.get("context_paths") or []:
        place = path if os.path.isdir(path) else os.path.dirname(path)
        if not (place + "/").startswith(workdir + "/") and not (place + "/").startswith(folder + "/") and place not in extra:
            extra.append(place)
    command = [binary, "-p", "--no-session-persistence", "--strict-mcp-config", "--setting-sources", "",
               "--tools", "Read,Grep,Glob", "--add-dir", folder] + [arg for place in extra for arg in ("--add-dir", place)] + [
               "--output-format", "json",
               "--json-schema", json.dumps(FINDINGS_SCHEMA)]
    if request.get("model"):
        command += ["--model", request["model"]]
    env = dict(os.environ)
    for name in ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT"):
        env.pop(name, None)
    out = run_tool(command, workdir, prompt, env)
    try:
        reply = json.loads(out)
    except ValueError:
        raise ReviewerError("claude's output wasn't JSON.")
    if not isinstance(reply, dict):
        raise ReviewerError("claude's output wasn't the expected JSON object.")
    if reply.get("is_error") or reply.get("subtype") not in (None, "success"):
        raise ReviewerError("claude failed: %s" % str(reply.get("result") or reply.get("subtype"))[:300])
    findings = parse_findings(reply.get("structured_output") or reply.get("result"))
    usage = reply.get("usage") or {}
    models = reply.get("modelUsage") or {}
    model = max(models, key=lambda name: (models[name] or {}).get("outputTokens") or 0) if models else request.get("model")
    return findings, model, {
        "input_tokens": usage.get("input_tokens"),
        "output_tokens": usage.get("output_tokens"),
        "cache_read_tokens": usage.get("cache_read_input_tokens"),
        "cache_write_tokens": usage.get("cache_creation_input_tokens"),
        "cost_usd": reply.get("total_cost_usd"),
    }


def run_codex(binary, workdir, folder, request, prompt):
    schema = os.path.join(folder, "schema.json")
    last = os.path.join(folder, "last-message.txt")
    write_json(schema, FINDINGS_SCHEMA)
    command = [binary, "exec", "--sandbox", "read-only", "--skip-git-repo-check", "--ephemeral",
               "--cd", workdir, "--add-dir", folder, "--output-schema", schema, "--output-last-message", last, "--json"]
    if request.get("model"):
        command += ["--model", request["model"]]
    out = run_tool(command + ["-"], workdir, prompt, dict(os.environ))
    usage = None
    model = request.get("model")
    for row in out.splitlines():
        try:
            event = json.loads(row)
        except ValueError:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("type") == "turn.completed" and isinstance(event.get("usage"), dict):
            totals = usage or {"input_tokens": 0, "output_tokens": 0, "cache_read_tokens": 0,
                               "cache_write_tokens": None, "cost_usd": None}
            cached = event["usage"].get("cached_input_tokens") or 0
            # codex's input_tokens include the cached ones; claude's (and this result's) don't.
            totals["input_tokens"] += max(0, (event["usage"].get("input_tokens") or 0) - cached)
            totals["output_tokens"] += event["usage"].get("output_tokens") or 0
            totals["cache_read_tokens"] += cached
            usage = totals
        elif event.get("type") == "turn.failed":
            message = (event.get("error") or {}).get("message") if isinstance(event.get("error"), dict) else None
            raise ReviewerError("codex failed: %s" % str(message or "turn failed")[:300])
        if isinstance(event.get("model"), str) and not model:
            model = event["model"]
    try:
        with open(last) as handle:
            text = handle.read()
    except OSError:
        raise ReviewerError("codex finished without an answer.")
    return parse_findings(text), model, usage


def run_tool(command, workdir, prompt, env):
    try:
        result = subprocess.run(command, cwd=workdir, input=prompt.encode("utf-8"), stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, env=env, timeout=RUN_TIMEOUT_SECONDS)
    except FileNotFoundError:
        raise ReviewerError("%s not found" % os.path.basename(command[0]))
    except subprocess.TimeoutExpired:
        raise ReviewerError("The reviewer took longer than %d minutes." % (RUN_TIMEOUT_SECONDS // 60))
    if result.returncode != 0:
        detail = (result.stderr.decode("utf-8", "replace").strip().splitlines() or [""])[-1]
        raise ReviewerError("%s exited %d%s" % (os.path.basename(command[0]), result.returncode,
                                                ": " + detail[:300] if detail else ""))
    return result.stdout.decode("utf-8", "replace")


def worker(folder):
    state_path = os.path.join(folder, "state.json")
    tree = os.path.join(folder, "tree")
    started = (read_json(state_path) or {}).get("started_at") or time.time()

    def finish(state):
        shutil.rmtree(tree, ignore_errors=True)
        current = read_json(state_path) or {}
        if current.get("state") == "cancelled":
            return
        state.setdefault("error", None)
        state.setdefault("result", None)
        state["started_at"] = started
        state["finished_at"] = time.time()
        write_json(state_path, state)

    def on_term(signum, frame):
        finish({"state": "cancelled"})
        os._exit(0)

    signal.signal(signal.SIGTERM, on_term)
    request = read_json(os.path.join(folder, "request.json"))
    try:
        if not request:
            raise ReviewerError("The run's request is missing.")
        root = request["root"]
        patch, _ = git(root, *DIFF_CONFIG, "diff", "--no-color", "--no-ext-diff", "--no-textconv",
                       "--src-prefix=a/", "--dst-prefix=b/", "-M", request["from"], request["to"], "--", text=False)
        if not patch.strip():
            finish({"state": "done", "result": {
                "tool": request["tool"], "model": None, "from": request["from"], "to": request["to"],
                "summary": "No changes to review.", "usage": None, "findings": []}})
            return
        patch_path = os.path.join(folder, "changes.patch")
        with open(patch_path, "wb") as handle:
            handle.write(patch)
        names, _ = git(root, "diff", "--name-only", "--no-renames", request["from"], request["to"], "--")
        changed = [name for name in names.splitlines() if name]
        # The reviewer reads the files as of --to, in an export: the working tree may change
        # under it while it reads (the conversation's agent goes on working).
        workdir = tree
        os.makedirs(tree)
        archive = subprocess.Popen(["git", "-C", root, "archive", "--format=tar", request["to"]], stdout=subprocess.PIPE)
        unpacked = subprocess.run(["tar", "-x", "-C", tree], stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or unpacked.returncode != 0:
            raise ReviewerError("Couldn't export %s to review it." % request["to"][:12])
        context = context_paths(root, workdir, request, changed)
        request["context_paths"] = context
        if request.get("brief", "").strip():
            brief_path = os.path.join(folder, "brief.md")
            with open(brief_path, "w") as handle:
                handle.write(request["brief"])
            context.insert(0, brief_path)
        prompt = PROMPT.format(patch=patch_path, from_sha=request["from"], to_sha=request["to"],
                               context="\n".join("- " + path for path in context) or "- (none)")
        binary = tool_binary(request["tool"])
        if not binary:
            raise ReviewerError("%s not found" % request["tool"])
        runner = run_claude if request["tool"] == "claude" else run_codex
        reply, model, usage = runner(binary, workdir, folder, request, prompt)
        if not isinstance(reply, dict) or not isinstance(reply.get("findings"), list):
            raise ReviewerError("The reviewer's answer had no findings list.")
        cache = {}
        findings, seen = [], set()
        for raw in reply["findings"][:MAX_FINDINGS]:
            finding = clean_finding(raw, root, request, cache, workdir)
            if finding and finding["fingerprint"] not in seen:
                seen.add(finding["fingerprint"])
                findings.append(finding)
        finish({"state": "done", "result": {
            "tool": request["tool"], "model": model, "from": request["from"], "to": request["to"],
            "summary": str(reply.get("summary") or "").strip()[:1000], "usage": usage, "findings": findings}})
    except (ReviewerError, GitError, OSError, KeyError) as error:
        finish({"state": "failed", "error": str(error)[:500] or "The reviewer failed."})
    except Exception as error:  # anything unforeseen still ends the run, with its cause
        finish({"state": "failed", "error": ("%s: %s" % (type(error).__name__, error))[:500]})


def main(argv):
    if len(argv) == 2 and argv[0] == "_worker":
        worker(argv[1])
        return
    commands = {"status": cmd_status, "diff": cmd_diff, "keep": cmd_keep, "log": cmd_log, "send": cmd_send,
                "run": cmd_run, "result": cmd_result, "cancel": cmd_cancel, "pr": cmd_pr, "threads": cmd_threads,
                "publish": cmd_publish, "merge": cmd_merge, "worktrees": cmd_worktrees,
                "prs": cmd_prs, "fetch-pr": cmd_fetch_pr}
    if not argv or argv[0] not in commands:
        die("usage: ai-todo-review status|diff|keep|log|send|run|result|cancel|pr|threads|publish|merge|worktrees|prs|fetch-pr ... (see the header of this script)", 64)
    try:
        commands[argv[0]](argv[1:])
    except GitError as error:
        die(str(error)[:300] or "git failed", 70)


if __name__ == "__main__":
    main(sys.argv[1:])
