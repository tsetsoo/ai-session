FORGE_TIMEOUT = float(os.environ.get("AI_TODO_REVIEW_FORGE_TIMEOUT", "30"))
CHECK_FAILED = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "ERROR", "STALE"}

GITHUB_THREADS = """
query($owner: String!, $name: String!, $number: Int!) {
