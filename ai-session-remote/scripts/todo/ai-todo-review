}"""


class NoAccess(Exception):
    """The forge's CLI is missing, logged out, or can't reach it."""


def workspace_module():
    """ai_todo_workspace, installed next to this script: the runner's forge and PR lookup."""
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import ai_todo_workspace
    return ai_todo_workspace


def forge_kind(root):
    """github | gitlab | None, as the runner decides it."""
    return workspace_module().forge(root)


def find_number(kind, root, branch):
    """The number of the branch's PR/MR the runner would pick (an open one, else the latest),
    or None. NoAccess, with why, when the CLI can't be asked."""
    workspace = workspace_module()
    try:
        found = workspace.find_pr(root, branch)
    except workspace.PRUnknown:
        # find_pr says only that it failed: ask once more to say why (missing, logged out).
        forge_json(kind, root, "api", "user")
        raise NoAccess("%s couldn't list the pull requests" % os.path.basename(forge_cli(kind)))
    return found.get("number") if found else None


def forge_cli(kind):
    name = "gh" if kind == "github" else "glab"
    return os.environ.get("AI_TODO_GH_BIN" if kind == "github" else "AI_TODO_GLAB_BIN") or shutil.which(name) or name


def forge_json(kind, root, *args):
    """The CLI's JSON answer, or NoAccess with why."""
    binary = forge_cli(kind)
    try:
        p = subprocess.run([binary] + list(args), cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           stdin=subprocess.DEVNULL, timeout=FORGE_TIMEOUT)
    except FileNotFoundError:
        raise NoAccess("%s isn't installed" % os.path.basename(binary))
    except subprocess.TimeoutExpired:
        raise NoAccess("%s didn't answer in %d s" % (os.path.basename(binary), FORGE_TIMEOUT))
    err = p.stderr.decode("utf-8", "replace").strip()
    if p.returncode != 0:
        lowered = err.lower()
        if "auth" in lowered or "login" in lowered or "401" in lowered or "token" in lowered:
            raise NoAccess("%s isn't logged in" % os.path.basename(binary))
        raise NoAccess("%s failed: %s" % (os.path.basename(binary), (err.splitlines() or [""])[-1][:200]))
    try:
        return json.loads(p.stdout.decode("utf-8", "replace") or "null")
    except ValueError:
        raise NoAccess("%s's answer wasn't JSON" % os.path.basename(binary))


def checks_summary(rollup):
    """{state: passing|failing|pending|none, passed, failed, pending, total} of GitHub's rollup."""
    passed = failed = pending = 0
    for check in rollup or []:
        if not isinstance(check, dict):
            continue
        if check.get("__typename") == "StatusContext" or "state" in check and "status" not in check:
            state = str(check.get("state") or "").upper()
            if state == "SUCCESS":
                passed += 1
            elif state in ("PENDING", "EXPECTED"):
                pending += 1
            else:
                failed += 1
            continue
        if str(check.get("status") or "").upper() != "COMPLETED":
            pending += 1
        elif str(check.get("conclusion") or "").upper() in CHECK_FAILED:
            failed += 1
        else:
            passed += 1
    total = passed + failed + pending
    state = "none" if total == 0 else "failing" if failed else "pending" if pending else "passing"
    return {"state": state, "passed": passed, "failed": failed, "pending": pending, "total": total}


def pipeline_summary(status):
    """GitLab's head pipeline status as the same summary."""
    status = str(status or "").lower()
    if not status:
        return {"state": "none", "passed": 0, "failed": 0, "pending": 0, "total": 0}
    state = {"success": "passing", "failed": "failing", "canceled": "failing"}.get(status, "pending")
    return {"state": state, "passed": int(state == "passing"), "failed": int(state == "failing"),
            "pending": int(state == "pending"), "total": 1}


def branch_for(root, ref):
    return ref or line(root, "symbolic-ref", "-q", "--short", "HEAD")


def github_pr(root, branch, number):
    if number is None:
        number = find_number("github", root, branch)
        if number is None:
            return None
    view = forge_json("github", root, "pr", "view", str(number), "--json",
                      "number,url,title,body,state,isDraft,author,reviewDecision,mergeStateStatus,mergeable,"
                      "statusCheckRollup,headRefOid,headRefName,baseRefName,latestReviews")
    if not isinstance(view, dict):
        return None
    approvals = sorted({(r.get("author") or {}).get("login") for r in view.get("latestReviews") or []
                        if isinstance(r, dict) and r.get("state") == "APPROVED"} - {None})
    return {
        "number": view.get("number"), "url": view.get("url"), "title": view.get("title") or "",
        "body": view.get("body") or "", "state": str(view.get("state") or "").lower(),
        "draft": bool(view.get("isDraft")), "author": (view.get("author") or {}).get("login"),
        "review_decision": (view.get("reviewDecision") or "").lower() or None, "approvals": approvals,
        "mergeable": (view.get("mergeStateStatus") or view.get("mergeable") or "").lower() or None,
        "checks": checks_summary(view.get("statusCheckRollup")), "head_sha": view.get("headRefOid"),
        "head_ref": view.get("headRefName"), "base_ref": view.get("baseRefName"),
    }


def gitlab_pr(root, branch, number):
    if number is None:
        number = find_number("gitlab", root, branch)
        if number is None:
            return None
    view = forge_json("gitlab", root, "mr", "view", str(number), "-F", "json")
    if not isinstance(view, dict):
        return None
    approvals = []
    decision = None
    project = view.get("project_id")
    if project:
        try:
            data = forge_json("gitlab", root, "api", "projects/%s/merge_requests/%s/approvals" % (project, number)) or {}
            approvals = sorted({((a or {}).get("user") or {}).get("username") for a in data.get("approved_by") or []} - {None})
            # Approved only when the MR's approval rules are met, not at the first approval.
            if data.get("approved") is True or (data.get("approvals_left") == 0 and approvals):
                decision = "approved"
            elif (data.get("approvals_left") or 0) > 0:
                decision = "review_required"
        except NoAccess:
            pass
    state = {"opened": "open", "locked": "open"}.get(view.get("state"), view.get("state") or "")
    return {
        "number": view.get("iid"), "url": view.get("web_url"), "title": view.get("title") or "",
        "body": view.get("description") or "", "state": state,
        "draft": bool(view.get("draft") or view.get("work_in_progress")),
        "author": (view.get("author") or {}).get("username"),
        "review_decision": decision, "approvals": approvals,
        "mergeable": (view.get("detailed_merge_status") or view.get("merge_status") or "").lower() or None,
        "checks": pipeline_summary((view.get("head_pipeline") or view.get("pipeline") or {}).get("status")),
        "head_sha": view.get("sha"), "head_ref": view.get("source_branch"), "base_ref": view.get("target_branch"),
        "project_id": project,
    }


def viewer(kind, root):
    try:
        user = forge_json(kind, root, "api", "user")
    except NoAccess:
        return None
    if not isinstance(user, dict):
        return None
    return user.get("login") if kind == "github" else user.get("username")


def take_number(args):
    rest = list(args)
    if "--number" not in rest:
        return rest, None
    at = rest.index("--number")
    try:
        number = int(rest[at + 1])
    except (IndexError, ValueError):
        die("--number needs a number", 64)
    del rest[at:at + 2]
    return rest, number


def take_option(args, name):
    rest = list(args)
    if name not in rest:
        return rest, None
    at = rest.index(name)
    if at + 1 >= len(rest) or not rest[at + 1]:
        die("%s needs a value" % name, 64)
    value = rest[at + 1]
    del rest[at:at + 2]
    return rest, value


def forge_context(args, usage):
    args, ref = take_ref(args)
    args, number = take_number(args)
    args, url = take_option(args, "--url")
    args, project = take_option(args, "--project")
    if len(args) != 1:
        die(usage, 64)
    root = repo_root(args[0])
    branch = branch_for(root, ref)
    return root, branch, number, forge_kind(root), url, project


def cmd_pr(args):
    root, branch, number, kind, _, _ = forge_context(args, "usage: ai-todo-review pr <cwd> [--ref <branch>] [--number N]")
    out = {"provider": kind, "access": False, "error": None, "viewer": None, "branch": branch, "pr": None}
    if kind is None:
        out["error"] = "origin is neither GitHub nor GitLab"
    elif not branch and number is None:
        # A detached HEAD has no PR of its own; that's not an access problem.
        out["access"] = True
    else:
        try:
            out["pr"] = (github_pr if kind == "github" else gitlab_pr)(root, branch, number)
            out["access"] = True
            out["viewer"] = viewer(kind, root)
        except NoAccess as error:
            out["error"] = str(error)
    print(json.dumps(out))


def github_threads(root, pr):
    m = re.match(r"https://[^/]+/([^/]+)/([^/]+)/pull/(\d+)", pr.get("url") or "")
    if not m:
        return []
    data = forge_json("github", root, "api", "graphql", "-f", "query=" + GITHUB_THREADS,
                      "-F", "owner=" + m.group(1), "-F", "name=" + m.group(2), "-F", "number=" + m.group(3))
    request = (((data or {}).get("data") or {}).get("repository") or {}).get("pullRequest") or {}
    nodes = request.get("reviewThreads") or {}
    threads = []
    for node in nodes.get("nodes") or []:
        comments = ((node or {}).get("comments") or {}).get("nodes") or []
        if not comments or not node.get("path"):
            continue
        first = comments[0]
        old_side = node.get("diffSide") == "LEFT"
        if node.get("line"):
            # Current: lines of the PR's head (or its base, for removed lines).
            line_no, start = node["line"], node.get("startLine") or node["line"]
            commit = request.get("baseRefOid") if old_side else request.get("headRefOid")
        else:
            # Outdated: where it was written, on the commit it was written on.
            line_no = node.get("originalLine")
            start = node.get("originalStartLine") or line_no
            commit = request.get("baseRefOid") if old_side else (first.get("originalCommit") or {}).get("oid")
        threads.append({
            "id": node.get("id"), "path": node["path"],
            "side": "old" if old_side else "new",
            "line_start": start, "line_end": line_no,
            "commit": commit,
            "resolved": bool(node.get("isResolved")), "outdated": bool(node.get("isOutdated")),
            "url": first.get("url"),
            "comments": [{"author": (c.get("author") or {}).get("login") or "ghost", "body": c.get("body") or "",
                          "created_at": c.get("createdAt")} for c in comments],
        })
    return threads


def gitlab_threads(root, pr):
    project = pr.get("project_id")
    if not project:
        return []
    data = forge_json("gitlab", root, "api", "projects/%s/merge_requests/%s/discussions?per_page=100" % (project, pr["number"]))
    threads = []
    for discussion in data or []:
        notes = [n for n in (discussion or {}).get("notes") or [] if isinstance(n, dict) and not n.get("system")]
        positioned = [n for n in notes if isinstance(n.get("position"), dict)]
        if not positioned:
            continue
        position = positioned[0]["position"]
        new_line, old_line = position.get("new_line"), position.get("old_line")
        side = "new" if new_line else "old"
        line_no = new_line or old_line
        start = line_no
        range_start = ((position.get("line_range") or {}).get("start") or {})
        if range_start.get("new_line" if side == "new" else "old_line"):
            start = range_start.get("new_line" if side == "new" else "old_line")
        threads.append({
            "id": discussion.get("id"),
            "path": position.get("new_path") if side == "new" else position.get("old_path") or position.get("new_path"),
            "side": side, "line_start": start, "line_end": line_no,
            "commit": position.get("head_sha") if side == "new" else position.get("base_sha"),
            "resolved": all(n.get("resolved") for n in notes if n.get("resolvable")) and any(n.get("resolvable") for n in notes),
            "outdated": False, "url": (pr.get("url") or "") + "#note_%s" % notes[0].get("id"),
            "comments": [{"author": (n.get("author") or {}).get("username") or "ghost", "body": n.get("body") or "",
                          "created_at": n.get("created_at")} for n in notes],
        })
    return threads


def cmd_threads(args):
    root, branch, number, kind, url, project = forge_context(
        args, "usage: ai-todo-review threads <cwd> [--ref <branch>] [--number N [--url U | --project P]]")
    out = {"provider": kind, "access": False, "error": None, "pr": None, "threads": []}
    if kind is None:
        out["error"] = "origin is neither GitHub nor GitLab"
    else:
        try:
            if number is not None and (url if kind == "github" else project):
                # What `pr` already said: one call for the threads, no second look at the PR.
                pr = {"number": number, "url": url, "project_id": project}
            else:
                pr = (github_pr if kind == "github" else gitlab_pr)(root, branch, number) if (branch or number) else None
            out["access"] = True
            if pr:
                out["pr"] = pr["number"]
                out["threads"] = (github_threads if kind == "github" else gitlab_threads)(root, pr)
        except NoAccess as error:
            out["access"] = False
            out["error"] = str(error)
    print(json.dumps(out))


# --- pull / merge requests: writes (each one confirmed in the app) --------------------

class HeadMoved(Exception):
    pass


def forge_call(kind, root, *args, stdin=None):
    """Runs a write; its JSON answer (or None). Exit 77 with the CLI's words when it fails."""
    binary = forge_cli(kind)
    try:
        p = subprocess.run([binary] + list(args), cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           input=stdin, timeout=FORGE_TIMEOUT * 2)
    except FileNotFoundError:
        die("%s isn't installed" % os.path.basename(binary), 77)
    except subprocess.TimeoutExpired:
        die("%s didn't answer" % os.path.basename(binary), 77)
    if p.returncode != 0:
        err = p.stderr.decode("utf-8", "replace").strip() or p.stdout.decode("utf-8", "replace").strip()
        die("%s failed: %s" % (os.path.basename(binary), " ".join(err.split())[:300]), 77)
    try:
        return json.loads(p.stdout.decode("utf-8", "replace") or "null")
    except ValueError:
        return None


def write_context(args, usage):
    """(root, kind, number, head) for a write: --number and --head are required."""
    args, number = take_number(args)
    args, head = take_option(args, "--head")
    if number is None or not head or len(args) != 1 or args[0].startswith("-"):
        die(usage, 64)
    root = repo_root(args[0])
    kind = forge_kind(root)
    if kind is None:
        die("origin is neither GitHub nor GitLab", 64)
    return root, kind, number, head


def github_repo(kind, root, number):
    view = forge_call(kind, root, "pr", "view", str(number), "--json", "url,headRefOid,state")
    m = re.match(r"https://[^/]+/([^/]+)/([^/]+)/pull/\d+", (view or {}).get("url") or "")
    if not m:
        die("couldn't tell the repository of PR %s" % number, 77)
    return m.group(1), m.group(2), view


def gitlab_mr(root, number):
    view = forge_call("gitlab", root, "mr", "view", str(number), "-F", "json") or {}
    if not view.get("project_id"):
        die("couldn't tell the project of MR %s" % number, 77)
    detail = forge_call("gitlab", root, "api", "projects/%s/merge_requests/%s" % (view["project_id"], number)) or {}
    view["diff_refs"] = detail.get("diff_refs") or {}
    return view


def cmd_publish(args):
    """publish <cwd> --number N --head SHA: the review JSON, base64, on stdin:
    {event: COMMENT|APPROVE|REQUEST_CHANGES, body, comments: [{path, old_path, side, line_start,
    line_end, old_line, body}]}. Refused (67) when the PR's head isn't SHA any more: the
    comments' lines are lines of SHA."""
    root, kind, number, head = write_context(args, "usage: ai-todo-review publish <cwd> --number N --head <sha> < review")
    try:
        review = json.loads(base64.b64decode(sys.stdin.buffer.read().strip(), validate=True))
    except (binascii.Error, ValueError):
        die("the review isn't base64 JSON", 64)
    event = review.get("event") or "COMMENT"
    if event not in ("COMMENT", "APPROVE", "REQUEST_CHANGES"):
        die("bad event %s" % event, 64)
    comments = [c for c in review.get("comments") or [] if isinstance(c, dict) and c.get("path") and c.get("body")]
    body = (review.get("body") or "").strip()
    if event == "REQUEST_CHANGES" and not body:
        die("Request Changes needs a summary", 64)
    if event == "COMMENT" and not body and not comments:
        die("nothing to publish", 65)
    if kind == "github":
        owner, name, view = github_repo(kind, root, number)
        if view.get("headRefOid") != head:
            die("PR %s moved on to %s" % (number, (view.get("headRefOid") or "")[:8]), 67)
        # One review, posted at once: all of it or none of it.
        payload = {"commit_id": head, "event": event, "body": body, "comments": []}
        for c in comments:
            item = {"path": c["path"], "body": c["body"], "line": c.get("line_end") or c.get("line_start"),
                    "side": "LEFT" if c.get("side") == "old" else "RIGHT"}
            if c.get("line_start") and c.get("line_end") and c["line_end"] != c["line_start"]:
                item["start_line"] = c["line_start"]
                item["start_side"] = item["side"]
            payload["comments"].append(item)
        answer = forge_call(kind, root, "api", "-X", "POST", "repos/%s/%s/pulls/%s/reviews" % (owner, name, number),
                            "--input", "-", stdin=json.dumps(payload).encode("utf-8"))
        print(json.dumps({"published": len(payload["comments"]), "event": event, "url": (answer or {}).get("html_url")}))
        return
    view = gitlab_mr(root, number)
    refs = view["diff_refs"]
    if view.get("sha") != head or refs.get("head_sha") not in (None, head):
        die("MR %s moved on to %s" % (number, (view.get("sha") or "")[:8]), 67)
    if event == "REQUEST_CHANGES":
        die("GitLab has no request-changes review; publish comments instead", 64)
    base = "projects/%s/merge_requests/%s" % (view["project_id"], number)
    # Each comment is its own discussion, posted at once: the user's own pending drafts on
    # GitLab stay drafts. A failure part way says how many went.
    posted = 0
    for c in comments:
        text = c["body"]
        if c.get("line_start") and c.get("line_end") and c["line_end"] != c["line_start"]:
            text = "(lines %d-%d) %s" % (c["line_start"], c["line_end"], text)
        line_no = c.get("line_end") or c.get("line_start")
        fields = ["-f", "body=" + text, "-f", "position[position_type]=text",
                  "-f", "position[base_sha]=" + (refs.get("base_sha") or ""),
                  "-f", "position[start_sha]=" + (refs.get("start_sha") or ""),
                  "-f", "position[head_sha]=" + head,
                  "-f", "position[new_path]=" + c["path"], "-f", "position[old_path]=" + (c.get("old_path") or c["path"])]
        if c.get("side") == "old":
            fields += ["-F", "position[old_line]=%d" % line_no]
        else:
            fields += ["-F", "position[new_line]=%d" % line_no]
            # An unchanged line is on both sides: GitLab wants both numbers.
            if c.get("old_line"):
                fields += ["-F", "position[old_line]=%d" % c["old_line"]]
        partial_call(root, posted, len(comments), "api", "-X", "POST", base + "/discussions", *fields)
        posted += 1
    if body:
        partial_call(root, posted, len(comments), "api", "-X", "POST", base + "/notes", "-f", "body=" + body)
    if event == "APPROVE":
        partial_call(root, posted, len(comments), "api", "-X", "POST", base + "/approve", "-f", "sha=" + head,
                     what="the approval")
    print(json.dumps({"published": posted, "event": event, "url": view.get("web_url")}))


def partial_call(root, posted, total, *args, what="it"):
    """A GitLab write after `posted` of `total` comments went: a failure says so (exit 78)."""
    binary = forge_cli("gitlab")
    try:
        p = subprocess.run([binary] + list(args), cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           stdin=subprocess.DEVNULL, timeout=FORGE_TIMEOUT * 2)
    except (OSError, subprocess.TimeoutExpired) as error:
        p, err = None, type(error).__name__
    else:
        err = " ".join((p.stderr.decode("utf-8", "replace") or p.stdout.decode("utf-8", "replace")).split())[:300]
    if p is not None and p.returncode == 0:
        return
    if posted == 0:
        die("glab failed: %s" % err, 77)
    die("%d of %d comments are posted on GitLab; %s failed: %s" % (posted, total, what, err), 78)


def cmd_merge(args):
    """merge <cwd> --number N --head SHA --method merge|squash|rebase [--delete-branch]: through
    the forge's API, only while the PR's head is SHA; nothing changes in the worktree."""
    args, method = take_option(args, "--method")
    delete_branch = "--delete-branch" in args
    args = [a for a in args if a != "--delete-branch"]
    root, kind, number, head = write_context(
        args, "usage: ai-todo-review merge <cwd> --number N --head <sha> --method merge|squash|rebase [--delete-branch]")
    if method not in ("merge", "squash", "rebase"):
        die("--method must be merge, squash or rebase", 64)
    if kind == "github":
        owner, name, view = github_repo(kind, root, number)
        answer = forge_call(kind, root, "api", "-X", "PUT", "repos/%s/%s/pulls/%s/merge" % (owner, name, number),
                            "-f", "sha=" + head, "-f", "merge_method=" + method) or {}
        if answer.get("merged") is not True:
            die("GitHub didn't merge it (%s)" % (answer.get("message") or "no answer"), 77)
        deleted = False
        if delete_branch:
            branch = forge_call(kind, root, "pr", "view", str(number), "--json", "headRefName") or {}
            if branch.get("headRefName"):
                forge_call(kind, root, "api", "-X", "DELETE",
                           "repos/%s/%s/git/refs/heads/%s" % (owner, name, branch["headRefName"]))
                deleted = True
        print(json.dumps({"merged": number, "method": method, "deleted_branch": deleted}))
        return
    if method == "rebase":
        die("GitLab merges with a merge commit or a squash here", 64)
    view = gitlab_mr(root, number)
    answer = forge_call("gitlab", root, "api", "-X", "PUT",
                        "projects/%s/merge_requests/%s/merge" % (view["project_id"], number),
                        "-f", "sha=" + head, "-F", "squash=%s" % ("true" if method == "squash" else "false"),
                        "-F", "should_remove_source_branch=%s" % ("true" if delete_branch else "false"),
                        "-F", "merge_when_pipeline_succeeds=false") or {}
    if answer.get("state") != "merged":
        # Queued, or refused without an error: not merged, and said so.
        die("GitLab didn't merge it (%s)" % (answer.get("detailed_merge_status") or answer.get("state") or "no answer"), 77)
    print(json.dumps({"merged": number, "method": method, "deleted_branch": delete_branch}))


