#!/bin/sh
# Open a todo's AI conversation in tmux: attach if its session is running,
# otherwise start it (resuming the conversation if it already exists).
# Clients (iPhone / Mac app) run this as the PTY command over SSH, with the
# values todo-server returns from POST /api/todos/{id}/conversation.
#
# Usage:
#   ai-todo-open [--mcp <names>] <tmux_name> <cwd> <session_id> [claude|codex|cursor]
#   ai-todo-open [--mcp <names>] <tmux_name> <cwd> - <codex|cursor>
#   ai-todo-open ai/claude/todo-0f3a9c21 '~/programming' 9b2f6c3e-1d4a-4e7b-8c55-2f0e8a1b7d90
#   ai-todo-open ai/codex/todo-0f3a9c21 '~/programming' 019f8b4e-ff53-7201-8585-162b40a93fb3 codex
#   ai-todo-open ai/cursor/todo-0f3a9c21 '~/programming' - cursor
#
# claude (default): `claude --resume <id>` if the transcript exists, else
#                   `claude --session-id <id>` to start it with that id.
# codex:            `codex resume <id> --approve-for-me` when the conversation exists.
#                   `-` starts a new one and waits for the id Codex assigns.
#                   Both use automatic approval review with the workspace-write sandbox.
# cursor:           `agent --resume <id>` for a chat already stored under
#                   ~/.cursor/chats. `-` starts a new one with `--new-session-id`
#                   and waits for that chat directory. A logged-out CLI fails
#                   immediately: it would otherwise sit on the login screen and
#                   never write a chat.
#
# --mcp <names>     Comma-separated MCP servers from ~/.ai-remote/mcp (see ai-todo-mcp);
#                   '' = managed, none. Only as the first argument: older versions of this
#                   script exit 64 for it, and the app then retries without it. It applies
#                   only when this script starts claude or codex (not on attach, and never
#                   for cursor): their arguments get `ai-todo-mcp launch-args` in front,
#                   the tool runs through /bin/sh to read ~/.ai-remote/mcp/env (the tmux
#                   server's environment lacks the tokens) when that file exists, and the
#                   servers that were applied are reported to the hub in the background
#                   (POST /api/conversations/mcp; a fresh Codex once its id appears).
#                   Servers ai-todo-mcp skips are shown on stderr, for 8 s in the session's
#                   tmux client once one attaches, and left out of the report. If
#                   ai-todo-mcp fails (other than 64, bad arguments), the tool starts
#                   without the selection and nothing is reported.
#
# Exit codes: 64 bad arguments, 90 tmux / claude / codex / agent missing, 93 cwd not usable,
#             94 no Codex or Cursor conversation with that id, or a new one
#             did not appear within 30 seconds.
#
# Test hooks (not for normal use):
#   AI_TODO_TMUX_SOCKET  use a private tmux server (tmux -L <name>)
#   AI_TODO_OPEN_DETACH  =1: don't attach; print created|resumed|attach and exit
#   AI_TODO_CLAUDE_BIN   claude binary to start instead of `command -v claude`
#   AI_TODO_CODEX_BIN    codex binary to start instead of looking it up
#   AI_TODO_AGENT_BIN    cursor agent binary to start instead of `command -v agent`
#   AI_TODO_CLAUDE_JOBS  background job directory instead of ~/.claude/jobs
#   AI_TODO_HOOK_BIN     ai-todo-hook path instead of the one next to this script
#   AI_TODO_LSOF         lsof binary for the pane's writer lock (systems without /proc)
#   AI_TODO_HUB_CONF     hub config instead of ~/.ai-remote/todo-hub.conf (for --mcp reports)
#   AI_TODO_MCP_REPORT_DELAY  seconds between --mcp report attempts after a 404 (default 2)
set -eu

# Tool directories a non-interactive SSH session often lacks, ahead of the rest, each
# directory once. Copies piled up when launches nested (a tmux session started from
# another inherits its PATH), and on macOS /home is an automount, so every command
# lookup that reached a /home entry cost a directory-service round trip.
ai_path=
ai_ifs=$IFS
IFS=:
set -f
for ai_dir in /opt/homebrew/bin /home/linuxbrew/.linuxbrew/bin /usr/local/bin "$HOME/.local/bin" /usr/sbin /sbin $PATH; do
  [ -n "$ai_dir" ] || continue
  case "$ai_dir" in /home/*) if [ -d /System ]; then continue; fi ;; esac
  case ":$ai_path:" in *":$ai_dir:"*) continue ;; esac
  ai_path=${ai_path:+$ai_path:}$ai_dir
done
set +f
IFS=$ai_ifs
export PATH="$ai_path"
unset ai_path ai_ifs ai_dir

usage() {
  echo "usage: $0 [--mcp <names>] <ai/<tool>/todo-<slug>> <cwd> <session-uuid> [claude|codex|cursor]" >&2
  exit 64
}

mcp_given=0
mcp_names=
if [ "${1:-}" = --mcp ]; then
  [ "$#" -ge 2 ] || usage
  mcp_given=1
  mcp_names=$2
  shift 2
fi

# `-u` forces the tmux client into UTF-8. Without it, a non-login SSH session
# (no LANG) makes tmux replace Cyrillic and other non-ASCII with underscores.
if [ -n "${AI_TODO_TMUX_SOCKET:-}" ]; then
  tmux_cmd() { tmux -L "$AI_TODO_TMUX_SOCKET" "$@"; }
  tmux_exec() { exec tmux -L "$AI_TODO_TMUX_SOCKET" -u "$@"; }
else
  tmux_cmd() { tmux "$@"; }
  tmux_exec() { exec tmux -u "$@"; }
fi

# A Claude conversation that is a background job (~/.claude/jobs) runs its hooks outside
# this tmux session, and the ones it fired before it became a todo never reached the hub.
# Report the job's state now, in the background.
seed_job_status() {
  [ "${open_tool}" = claude ] || return 0
  jobs=${AI_TODO_CLAUDE_JOBS:-$HOME/.claude/jobs}
  [ -e "$jobs/$(printf '%s' "$open_sid" | cut -c1-8)/state.json" ] || [ -e "$jobs/$open_sid/state.json" ] || return 0
  hook=${AI_TODO_HOOK_BIN:-$(dirname "$0")/ai-todo-hook}
  [ -x "$hook" ] || return 0
  AI_TODO_CLAUDE_JOBS=$jobs "$hook" seed "$open_sid" </dev/null >/dev/null 2>&1 &
}

attach() {
  seed_job_status
  if [ "${AI_TODO_OPEN_DETACH:-}" = 1 ]; then
    echo "$1"
    exit 0
  fi
  # Inside tmux already (e.g. a Mac terminal), switch instead of nesting.
  if [ -n "${TMUX:-}" ]; then
    tmux_exec switch-client -t "=$name"
  fi
  tmux_exec attach-session -t "=$name"
}

[ "$#" -eq 3 ] || [ "$#" -eq 4 ] || usage
open_sid=$3
open_tool=${4:-claude}

# A running session attaches at once, before the checks only a new one needs
# (they cost about 150 ms). The name is only a quoted tmux target here, but it
# must still be this tool's. A fresh start (`-`) never does: it replaces a
# session left by a failed start.
case "$1" in
  "ai/${4:-claude}/todo-"*)
    if [ "$3" != - ] && tmux_cmd has-session -t "=$1" 2>/dev/null; then
      name=$1
      attach attach
    fi
    ;;
esac

name=$1
cwd=$2
sid=$3
tool=${4:-claude}

case "$tool" in
  claude | codex | cursor) ;;
  *) echo "unknown tool: $tool" >&2; usage ;;
esac
# LC_ALL=C so [a-z] never matches uppercase in other locales.
if ! printf '%s\n' "$name" | LC_ALL=C grep -Eqx "ai/${tool}/todo-[a-z0-9-]+"; then
  echo "invalid tmux name for $tool: $name" >&2
  usage
fi
fresh=0
if [ "$sid" = - ]; then
  case "$tool" in
    codex | cursor) fresh=1 ;;
    *) echo "claude needs a session id" >&2; usage ;;
  esac
elif ! printf '%s\n' "$sid" | LC_ALL=C grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'; then
  echo "invalid session id: $sid" >&2
  usage
fi

# todo-server stores cwd as entered, often with a leading ~.
case "$cwd" in
  "~") cwd=$HOME ;;
  "~/"*) cwd="$HOME/${cwd#\~/}" ;;
esac

command -v tmux >/dev/null 2>&1 || { echo "tmux not found" >&2; exit 90; }

uuid_re='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'

codex_tui_marks="$HOME/.codex/tui-thread-reference-capabilities"

# Ids of conversations that already exist, one per line, each once.
# Codex 0.163+ writes the rollout only after the first message, but the TUI marks its
# thread under tui-thread-reference-capabilities/<id> at startup. Older versions write
# the rollout at once. A thread with both is one id. (Writer locks in general are no use:
# sub-agent and guardian threads of any running Codex take them too. Only the one held by
# this session's own pane counts; see pane_lock_id.)
fresh_ids() {
  if [ "$1" = codex ]; then
    {
      find "$HOME/.codex/sessions" -name 'rollout-*.jsonl' -print 2>/dev/null \
        | sed -n 's|^.*/rollout-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-\([^/]*\)\.jsonl$|\1|p' || true
      find "$codex_tui_marks" -mindepth 1 -maxdepth 1 -print 2>/dev/null \
        | sed 's|^.*/||' | LC_ALL=C grep -Ex "$uuid_re" || true
    } | LC_ALL=C sort -u
  else
    find "$HOME/.cursor/chats" -mindepth 2 -maxdepth 2 -type d -print 2>/dev/null \
      | sed 's|^.*/||' | LC_ALL=C sort -u || true
  fi
}

# Whether a new id can be the conversation this script started. Codex: a TUI thread, or
# a rollout that is not a sub-agent's (a rollout with no first line yet is not decided).
# Cursor: the id passed to --new-session-id.
fresh_is_ours() {
  if [ "$1" = codex ]; then
    [ -e "$codex_tui_marks/$2" ] && return 0
    first=$(find "$HOME/.codex/sessions" -name "rollout-*-$2.jsonl" -print 2>/dev/null | head -n 1)
    first=${first:+$(head -n 1 "$first" 2>/dev/null)}
    [ -n "$first" ] || return 1
    case "$first" in
      *'"subagent"'*) return 1 ;;
    esac
    return 0
  fi
  [ "$2" = "$cursor_id" ]
}

# Codex started with -c overrides (`--mcp`) runs its own app-server and writes no TUI
# mark, only the thread's writer lock. The lock this session's pane process holds open is
# its thread; a lock any other Codex takes is not. Prints it when there is exactly one.
pane_lock_id() {
  pid=$(tmux_cmd list-panes -t "=$name:" -F '#{pane_pid}' 2>/dev/null | head -n 1)
  [ -n "$pid" ] || return 0
  locks=$(
    {
      if [ -d "/proc/$pid/fd" ]; then
        for fd in "/proc/$pid/fd"/*; do readlink "$fd" 2>/dev/null; done
      else
        "${AI_TODO_LSOF:-lsof}" -n -P -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p'
      fi
    } | sed -n 's|^.*/\.codex/thread-writer-locks/\([^/]*\)\.lock$|\1|p' \
      | LC_ALL=C grep -Ex "$uuid_re" | LC_ALL=C sort -u || true
  )
  [ -n "$locks" ] && [ "$(printf '%s\n' "$locks" | wc -l | tr -d ' ')" -eq 1 ] && printf '%s\n' "$locks"
  return 0
}

# The id that was not in $fresh_before. Empty until one appears.
wait_for_fresh_id() {
  deadline=$(( $(date +%s) + 30 ))
  while [ "$(date +%s)" -le "$deadline" ]; do
    now=$(fresh_ids "$1")
    ids=
    count=0
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      case "
$fresh_before
" in
        *"
$id
"*) ;;
        *)
          fresh_is_ours "$1" "$id" || continue
          count=$((count + 1))
          ids=$id
          if [ "$count" -gt 1 ]; then
            echo "more than one new $1 conversation appeared" >&2
            return 1
          fi
          ;;
      esac
    done <<EOF
$now
EOF
    if [ "$count" -eq 1 ]; then
      printf '%s\n' "$ids"
      return 0
    fi
    if [ "$1" = codex ] && ids=$(pane_lock_id) && [ -n "$ids" ]; then
      case "
$fresh_before
" in
        *"
$ids
"*) ;;
        *)
          printf '%s\n' "$ids"
          return 0
          ;;
      esac
    fi
    sleep 0.2
  done
  return 1
}

if tmux_cmd has-session -t "=$name" 2>/dev/null; then
  # A fresh start has no id yet. A session left by a failed start would only
  # attach, and every later open would do the same. Replace it.
  if [ "$fresh" = 1 ]; then
    tmux_cmd kill-session -t "=$name" 2>/dev/null || true
  else
    attach attach
  fi
fi

[ -d "$cwd" ] || { echo "cwd not found: $cwd" >&2; exit 93; }

if [ "$tool" = codex ]; then
  status_bin=${AI_TODO_STATUS_BIN:-$(dirname "$0")/ai-todo-status}
  runtime_endpoint=
  # Explicit binary overrides are also used by adapters/tests that do not implement the
  # native app-server protocol. Normal launches use a healthy CLI and an observable server.
  if [ -z "${AI_TODO_CODEX_BIN:-}" ] && [ -x "$status_bin" ]; then
    AI_TODO_CODEX_BIN=$("$status_bin" codex-path) || exit 90
    PATH="$(dirname "$AI_TODO_CODEX_BIN"):$PATH"
    runtime_endpoint=$("$status_bin" ensure-runtime) || { echo 'Codex runtime could not start; run ai-todo-status doctor' >&2; exit 90; }
  fi
  codex_bin=${AI_TODO_CODEX_BIN:-$(command -v codex || true)}
  if [ -z "$codex_bin" ]; then
    # Installed with npm under nvm: not on PATH in a plain SSH session.
    codex_bin=$(ls -d "$HOME"/.nvm/versions/node/*/bin/codex 2>/dev/null | tail -n 1 || true)
    [ -n "$codex_bin" ] && PATH="$(dirname "$codex_bin"):$PATH"
  fi
  [ -n "$codex_bin" ] || { echo "codex not found" >&2; exit 90; }
  if [ "$fresh" = 1 ]; then
    mode=created
    set -- "$codex_bin" --approve-for-me
  elif [ -z "$(find "$HOME/.codex/sessions" -name "rollout-*-$sid.jsonl" -print 2>/dev/null | head -n 1)" ]; then
    # Started but never sent a message: Codex 0.163+ keeps no rollout for it and
    # `codex resume` refuses it. Nothing was said in it, so a new one loses nothing.
    # An archived one keeps its rollout under archived_sessions.
    if [ -n "$(find "$HOME/.codex/archived_sessions" -name "rollout-*-$sid.jsonl" -print 2>/dev/null | head -n 1)" ]; then
      echo "Codex conversation $sid is archived. Unarchive it with \`codex unarchive $sid\`, then open it again." >&2
    elif [ -e "$codex_tui_marks/$sid" ] || [ -e "$HOME/.codex/thread-writer-locks/$sid.lock" ]; then
      echo "Codex conversation $sid has no messages, so Codex can't resume it. Unlink it and start a new one." >&2
    else
      echo "no Codex conversation $sid on this computer" >&2
    fi
    exit 94
  else
    mode=resumed
    set -- "$codex_bin" resume "$sid" --approve-for-me
  fi
  if [ -n "$runtime_endpoint" ]; then
    tool_bin=$1
    shift
    # A hidden terminal must not stop on an updater menu before Chat can send a message.
    set -- "$tool_bin" --cd "$cwd" -c check_for_update_on_startup=false --remote "$runtime_endpoint" "$@"
  fi
elif [ "$tool" = cursor ]; then
  agent_bin=${AI_TODO_AGENT_BIN:-$(command -v agent || true)}
  [ -n "$agent_bin" ] || { echo "agent not found" >&2; exit 90; }
  # The keychain store says "Not logged in" from this tmux server, and a
  # keychain `agent login` does not help: every launch below uses the file
  # store. A logged-out CLI sits on the login screen or exits, so the attach
  # closes. Say so before starting tmux, for a new chat and a resume.
  agent_status=$(AGENT_CLI_CREDENTIAL_STORE=file "$agent_bin" status 2>&1 || true)
  case "$agent_status" in
    *"Not logged in"*)
      echo "Cursor agent is not logged in on this computer. Run \`AGENT_CLI_CREDENTIAL_STORE=file agent login\`, then start again." >&2
      exit 94
      ;;
  esac
  if [ "$fresh" = 1 ]; then
    # The CLI reserves this id at startup (`--new-session-id`), which is what
    # makes a chat directory appear before the user types. A bare `agent`
    # waits on its welcome screen and never writes one.
    if command -v uuidgen >/dev/null 2>&1; then
      cursor_id=$(uuidgen | tr '[:upper:]' '[:lower:]')
    else
      cursor_id=$(python3 -c 'import uuid; print(uuid.uuid4())')
    fi
    mode=created
    set -- "$agent_bin" --new-session-id "$cursor_id" --trust
  elif [ -z "$(find "$HOME/.cursor/chats" -mindepth 2 -maxdepth 2 -type d -name "$sid" -print 2>/dev/null | head -n 1)" ]; then
    echo "no Cursor conversation $sid on this computer" >&2
    exit 94
  else
    mode=resumed
    set -- "$agent_bin" --resume "$sid"
  fi
else
  claude_bin=${AI_TODO_CLAUDE_BIN:-$(command -v claude || true)}
  [ -n "$claude_bin" ] || { echo "claude not found" >&2; exit 90; }

  # Claude stores each conversation as ~/.claude/projects/<project>/<session-id>.jsonl.
  if [ -n "$(find "$HOME/.claude/projects" -maxdepth 2 -name "$sid.jsonl" -print 2>/dev/null | head -n 1)" ]; then
    mode=resumed
    set -- "$claude_bin" --resume "$sid"
  else
    mode=created
    set -- "$claude_bin" --session-id "$sid"
  fi
fi

# --mcp: put the selected servers' launch arguments after the tool binary, before the id
# arguments (the id stays its own word, which ai-todo-hook and ai-todo-sessions match on).
mcp_report=0
mcp_json=
mcp_warnings=
if [ "$mcp_given" = 1 ] && [ "$tool" != cursor ]; then
  mcp_bin=$(dirname "$0")/ai-todo-mcp
  if [ ! -x "$mcp_bin" ]; then
    echo "ai-todo-mcp not found next to $0; starting without the MCP server selection" >&2
  else
    mcp_err=$(mktemp "${TMPDIR:-/tmp}/ai-todo-open.XXXXXX")
    mcp_status=0
    mcp_args=$("$mcp_bin" launch-args "$tool" "$mcp_names" 2>"$mcp_err") || mcp_status=$?
    mcp_skipped=$(sed -n 's/^ai-todo-mcp: skipped \([^:]*\): .*$/\1/p' "$mcp_err")
    mcp_skip_lines=$(awk '/^ai-todo-mcp: skipped /{printf "%s%s", sep, $0; sep="; "}' "$mcp_err")
    cat "$mcp_err" >&2
    rm -f "$mcp_err"
    # 64: bad arguments, which the app answers by retrying without --mcp.
    [ "$mcp_status" -ne 64 ] || exit 64
    if [ "$mcp_status" -ne 0 ]; then
      # Anything else (a crash, an unreadable file): start the tool unmanaged, as without the helper.
      echo "ai-todo-open: MCP servers not applied (ai-todo-mcp failed)" >&2
    else
      mcp_warnings=$mcp_skip_lines
      # The names ai-todo-mcp used: as given (trimmed, each once), minus the skipped ones.
      # They passed its name check, so they need no JSON escaping.
      mcp_json=$(printf '%s\n' "$mcp_names" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        | awk 'NF && !seen[$0]++' \
        | if [ -n "$mcp_skipped" ]; then grep -vxF "$mcp_skipped" || true; else cat; fi \
        | sed 's/.*/"&"/' | paste -sd, -)
      mcp_report=1
      tool_bin=$1
      shift
      eval "set -- $mcp_args"' "$@"'
      set -- "$tool_bin" "$@"
      # The tool gets the tmux server's environment, not a login shell's: read the
      # variables the server files reference from the env file, exported.
      if [ -e "$HOME/.ai-remote/mcp/env" ]; then
        # shellcheck disable=SC2016
        set -- /bin/sh -c 'set -a; [ -r "$HOME/.ai-remote/mcp/env" ] && . "$HOME/.ai-remote/mcp/env"; set +a; exec "$@"' sh "$@"
      fi
    fi
  fi
fi

# Tell the hub which servers this conversation started with, in the background: 3 s at
# most, and a failure never fails the open. The token goes through curl's config on
# stdin so it never shows up in `ps` (as in ai-todo-hook).
report_mcp() { # <session id>
  [ "$mcp_report" = 1 ] || return 0
  conf=${AI_TODO_HUB_CONF:-$HOME/.ai-remote/todo-hub.conf}
  [ -r "$conf" ] || return 0
  (
    set +eu
    TODO_HUB_URL=
    TODO_API_TOKEN=
    # shellcheck source=/dev/null
    . "$conf" 2>/dev/null || exit 0
    [ -n "$TODO_HUB_URL" ] || exit 0
    body=$(printf '{"tool":"%s","session_id":"%s","mcp_servers":[%s]}' "$tool" "$1" "$mcp_json")
    # A fresh conversation's id reaches the hub only after the app reads `created <id>`,
    # so the hub may not know it yet (404): try again a few times.
    attempt=1
    while :; do
      code=$({
        if [ -n "$TODO_API_TOKEN" ]; then
          printf 'header = "Authorization: Bearer %s"\n' "$TODO_API_TOKEN"
        fi
      } | curl -s -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 3 -K - \
        -H 'Content-Type: application/json' --data-binary "$body" \
        "${TODO_HUB_URL%/}/api/conversations/mcp")
      [ "$code" = 404 ] && [ "$attempt" -lt 5 ] || break
      attempt=$((attempt + 1))
      sleep "${AI_TODO_MCP_REPORT_DELAY:-2}"
    done
  ) </dev/null >/dev/null 2>&1 &
}

# The skip lines on stderr vanish when the attach clears the screen. Show them in the
# session's tmux client for 8 s too: in the background, once a client is attached (10 s at
# most), and a failure is ignored. `#` is doubled so tmux doesn't read it as a format.
show_mcp_warnings() {
  [ -n "$mcp_warnings" ] || return 0
  message=$(printf '%s' "$mcp_warnings" | sed 's/#/##/g')
  (
    set +eu
    tries=0
    while [ "$tries" -lt 50 ]; do
      client=$(tmux_cmd list-clients -t "=$name" -F '#{client_name}' 2>/dev/null | head -n 1)
      if [ -n "$client" ]; then
        # -d (tmux 3.2+) keeps it up 8 s; an older tmux shows it for its display-time.
        tmux_cmd display-message -c "$client" -d 8000 "$message" || tmux_cmd display-message -c "$client" "$message"
        exit 0
      fi
      tries=$((tries + 1))
      sleep 0.2
    done
  ) </dev/null >/dev/null 2>&1 &
}

# Create detached, then attach, so the same path works inside and outside tmux.
# A tmux server that is already running gives new sessions its own environment, not
# ours, so pass the PATH resolved above explicitly: npm-installed codex (under nvm)
# needs `node` on it. `env` instead of `new-session -e` works on every tmux version.
# The same server environment often has no UTF-8 locale. Pass one through so a
# program inside the pane does not replace Cyrillic and symbols. Keep a UTF-8
# locale the caller already has (for example bg_BG.UTF-8).
session_lang=${LANG:-en_US.UTF-8}
session_ctype=${LC_CTYPE:-$session_lang}
case "${LC_ALL:-}$session_ctype$session_lang" in
  *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;;
  *) session_lang=en_US.UTF-8; session_ctype=en_US.UTF-8 ;;
esac
fresh_before=
if [ "$fresh" = 1 ]; then
  fresh_before=$(fresh_ids "$tool")
fi
# Cursor's CLI probes the macOS login keychain when it thinks it is on SSH.
# This tmux server cannot pass that probe, so `agent` exits immediately and
# the attach looks like a closed connection. The file store resumes the chat.
if [ "$tool" = cursor ]; then
  set -- env "AGENT_CLI_CREDENTIAL_STORE=file" "$@"
fi
tmux_cmd new-session -d -s "$name" -c "$cwd" -- env "PATH=$PATH" "LANG=$session_lang" "LC_CTYPE=$session_ctype" "LC_ALL=$session_lang" "$@"
if [ "$fresh" = 1 ]; then
  new_id=$(wait_for_fresh_id "$tool") || {
    tmux_cmd kill-session -t "=$name" 2>/dev/null || true
    echo "no new $tool conversation appeared" >&2
    exit 94
  }
  mode="created $new_id"
  report_mcp "$new_id"
else
  report_mcp "$sid"
fi
show_mcp_warnings
attach "$mode"
