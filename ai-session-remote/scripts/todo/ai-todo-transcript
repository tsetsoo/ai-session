#!/usr/bin/env python3
"""Print one conversation's user and assistant text. Does not call a model.

Usage: ai-todo-transcript <claude|codex|cursor> <session_id> [--json [--activity [--after <line>]]]
--activity adds tool steps (role "activity", with kind and target), timestamps, and ids that
stay the same as the transcript grows. Without it, --json prints only messages, as before.
--after <line> prints only entries from later jsonl lines (an id's first number), so a client
polling a long conversation fetches what is new. Cursor ignores it and prints everything.
Exit 94 when that conversation has no transcript on this machine, or one with no text.
"""
import glob
import json
import os
import re
import sys

HOME = os.path.expanduser("~")
CLAUDE_PROJECTS = os.path.join(HOME, ".claude", "projects")
CODEX_SESSIONS = os.path.join(os.environ.get("CODEX_HOME", os.path.join(HOME, ".codex")), "sessions")
CURSOR_PROJECTS = os.path.join(HOME, ".cursor", "projects")


def read_jsonl(path):
    """Yields (line number, entry). Numbers count every line, so ids stay put as a file grows."""
    try:
        with open(path, errors="replace") as handle:
            for number, line in enumerate(handle):
                try:
                    yield number, json.loads(line)
                except ValueError:
                    continue
    except OSError:
        return


def text_of(content):
    if isinstance(content, str):
        return content if content.strip() else ""
    if isinstance(content, list):
        parts = []
        for part in content:
            if not isinstance(part, dict):
                continue
            if part.get("type") in ("text", "input_text", "output_text"):
                value = part.get("text", "")
                if isinstance(value, str) and value.strip():
                    parts.append(value)
        return "\n".join(parts)
    return ""


TARGET_LIMIT = 120
CLAUDE_KINDS = {
    "Read": "read", "NotebookRead": "read", "WebFetch": "read",
    "Edit": "edit", "Write": "edit", "MultiEdit": "edit", "NotebookEdit": "edit",
    "Bash": "run",
    "Grep": "search", "Glob": "search", "WebSearch": "search",
}


def short(value):
    lines = str(value).strip().splitlines()
    return (lines[0] if lines else "")[:TARGET_LIMIT]


def step(kind, target, name):
    return {"role": "activity", "text": "", "kind": kind, "target": short(target) or name, "name": name}


def claude_step(part):
    name = part.get("name") if isinstance(part.get("name"), str) else "tool"
    tool_input = part.get("input") if isinstance(part.get("input"), dict) else {}
    target = next((tool_input[key] for key in ("file_path", "notebook_path", "command", "pattern", "url", "query")
                   if isinstance(tool_input.get(key), str) and tool_input[key].strip()), name)
    return step(CLAUDE_KINDS.get(name, "other"), target, name)


PATCH_FILE = re.compile(r"\*\*\* (?:Update|Add|Delete) File: (.+?)(?:\\n|\n|$)")


def js_string(script, key):
    """The first `key:"..."` string in a code-mode script, unescaped; None if there is none."""
    match = re.search(key + r'\s*:\s*"((?:[^"\\]|\\.)*)"', script)
    if not match:
        return None
    try:
        return json.loads('"' + match.group(1) + '"')
    except ValueError:
        return match.group(1)


def codex_exec_step(script):
    # codex-cli 0.166+ "code mode": one `exec` tool runs JavaScript that calls tools.<name>(...).
    patch = PATCH_FILE.search(script)
    if patch:
        return step("edit", patch.group(1), "apply_patch")
    command = js_string(script, "cmd")
    if command is not None:
        return step("run", command, "exec_command")
    query = js_string(script, "q")
    if query is not None:
        return step("search", query, "web")
    tool = re.search(r"tools\.(\w+)\(", script)
    name = tool.group(1) if tool else "exec"
    return step("other", name, name)


def codex_step(payload):
    name = payload.get("name") if isinstance(payload.get("name"), str) else "tool"
    if name == "exec" and isinstance(payload.get("input"), str):
        return codex_exec_step(payload["input"])
    if name == "apply_patch":
        patch = payload.get("input") or payload.get("arguments") or ""
        match = PATCH_FILE.search(str(patch))
        return step("edit", match.group(1) if match else name, name)
    try:
        arguments = json.loads(payload.get("arguments") or "{}")
    except (TypeError, ValueError):
        arguments = {}
    if not isinstance(arguments, dict):
        arguments = {}
    if name in ("shell", "exec_command", "local_shell"):
        command = arguments.get("cmd") or arguments.get("command") or name
        if isinstance(command, list):
            command = command[-1] if command else name
        return step("run", command, name)
    return step("other", name, name)


def with_meta(item, ident, entry):
    item["id"] = ident
    time = entry.get("timestamp")
    if isinstance(time, str) and time:
        item["time"] = time
    return item


def claude_lines(path, activity=False):
    for number, entry in read_jsonl(path):
        if not isinstance(entry, dict) or entry.get("type") not in ("user", "assistant"):
            continue
        message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
        content = message.get("content")
        if not activity:
            text = text_of(content)
            if text:
                yield {"role": entry["type"], "text": text}
            continue
        parts = content if isinstance(content, list) else [{"type": "text", "text": content}]
        for index, part in enumerate(parts):
            if not isinstance(part, dict):
                continue
            if part.get("type") == "tool_use" and entry["type"] == "assistant":
                yield with_meta(claude_step(part), "%d.%d" % (number, index), entry)
            else:
                text = text_of([part])
                if text:
                    yield with_meta({"role": entry["type"], "text": text}, "%d.%d" % (number, index), entry)


def codex_lines(path, activity=False):
    for number, entry in read_jsonl(path):
        if not isinstance(entry, dict):
            continue
        payload = entry.get("payload") if isinstance(entry.get("payload"), dict) else {}
        if entry.get("type") != "response_item":
            continue
        if activity and payload.get("type") in ("function_call", "custom_tool_call", "local_shell_call"):
            yield with_meta(codex_step(payload), "%d.0" % number, entry)
            continue
        if payload.get("type") != "message" or payload.get("role") not in ("user", "assistant"):
            continue
        text = text_of(payload.get("content"))
        if text:
            item = {"role": payload["role"], "text": text}
            yield with_meta(item, "%d.0" % number, entry) if activity else item


def cursor_lines(path, activity=False):
    # Cursor stores a directory of jsonl files, or one jsonl. Read every jsonl under the path.
    files = []
    if os.path.isdir(path):
        files = sorted(glob.glob(os.path.join(path, "**", "*.jsonl"), recursive=True))
    elif path.endswith(".jsonl"):
        files = [path]
    for file_number, file in enumerate(files):
        for number, entry in read_jsonl(file):
            if not isinstance(entry, dict):
                continue
            message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
            role = entry.get("role") or message.get("role") or entry.get("type")
            if role not in ("user", "assistant"):
                continue
            content = entry.get("content") or entry.get("text") or message.get("content") or ""
            if activity and isinstance(content, list):
                for index, part in enumerate(content):
                    if not isinstance(part, dict):
                        continue
                    ident = "%d.%d.%d" % (file_number, number, index)
                    if part.get("type") == "tool_use" and role == "assistant":
                        yield with_meta(claude_step(part), ident, entry)
                    else:
                        text = text_of([part])
                        if text:
                            yield with_meta({"role": role, "text": text}, ident, entry)
                continue
            text = text_of(content)
            if text:
                item = {"role": role, "text": text}
                yield with_meta(item, "%d.%d.0" % (file_number, number), entry) if activity else item


def find_paths(tool, session_id):
    escaped = glob.escape(session_id)
    if tool == "claude":
        return glob.glob(os.path.join(CLAUDE_PROJECTS, "*", escaped + ".jsonl"))
    if tool == "codex":
        return glob.glob(
            os.path.join(CODEX_SESSIONS, "**", "rollout-*-" + escaped + ".jsonl"),
            recursive=True,
        )
    if tool == "cursor":
        base = os.path.join(CURSOR_PROJECTS, "*", "agent-transcripts", escaped)
        return glob.glob(base) + glob.glob(base + ".jsonl")
    return []


def main(argv):
    after = None
    if argv[2:4] == ["--json", "--activity"] and len(argv) == 6 and argv[4] == "--after" and argv[5].isdigit():
        after = int(argv[5])
        argv = argv[:4]
    activity = argv[2:] == ["--json", "--activity"]
    structured = activity or argv[2:] == ["--json"]
    if structured:
        argv = argv[:2]
    if len(argv) != 2 or argv[0] not in ("claude", "codex", "cursor"):
        print("usage: ai-todo-transcript <claude|codex|cursor> <session_id> [--json [--activity [--after <line>]]]", file=sys.stderr)
        return 64
    tool, session_id = argv
    paths = find_paths(tool, session_id)
    if not paths:
        print("no transcript for %s %s" % (tool, session_id), file=sys.stderr)
        return 94
    path = max(paths, key=os.path.getmtime)
    reader = {"claude": claude_lines, "codex": codex_lines, "cursor": cursor_lines}[tool]
    if activity:
        entries = list(reader(path, activity=True))
        if after is not None and tool != "cursor":
            entries = [entry for entry in entries if int(entry["id"].split(".")[0]) > after]
        print(json.dumps(entries, ensure_ascii=False))
        return 0
    messages = list(reader(path))
    if structured:
        # Empty is valid for a new chat. IDs are stable while polling and preserve scroll position.
        print(json.dumps([dict(message, id=str(i)) for i, message in enumerate(messages)], ensure_ascii=False))
        return 0
    for message in messages:
        print(message["text"].strip())
    if not messages:
        # A chat that only ended on an error has a file but nothing to hand over.
        print("no text in %s %s" % (tool, session_id), file=sys.stderr)
        return 94
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
